### 2.3 lhp负责：线性变换+RMSNorm+矩阵乘法

```mermaid
graph TB
    %% ========== 输入层 ==========
    subgraph Input [输入层]
        O1[alpha<br/>原始输入<br/>3]
        O2[hc_before_norm<br/>原始输入<br/>B,S,N²+2N]
        O3[inv_rms<br/>原始输入<br/>B,S,1]
        O4[x<br/>原始输入<br/>B,S,N,D]
        O5[phi<br/>原始输入<br/>N²+2N,N·D]
        D1[grad_z_pre<br/>依赖输入<br/>来自llh<br/>B,S,N]
        D2[grad_z_post<br/>依赖输入<br/>来自llh<br/>B,S,N]
        D3[grad_z_res<br/>依赖输入<br/>来自hbj<br/>B,S,N²]
        D4[grad_x_from_hin<br/>依赖输入<br/>来自llh<br/>B,S,N,D]
        D5[grad_bias_part1<br/>依赖输入<br/>来自llh<br/>N]
        D6[grad_bias_part2<br/>依赖输入<br/>来自llh<br/>N]
        D7[grad_bias_part3<br/>依赖输入<br/>来自hbj<br/>N²]
    end

    %% ========== 计算流程 ==========
    subgraph Computation [计算流程]
        C1[线性变换梯度<br/>grad_norm_out_pre = grad_z·alpha<br/>输出: B,S,N<br/>grad_norm_out_post = grad_z·alpha<br/>输出: B,S,N<br/>grad_norm_out_res = grad_z·alpha<br/>输出: B,S,N²]
        
        C2[三路梯度组装<br/>grad_norm_out = cat<br/>输出: B,S,N²+2N]
        
        C3[RMSNorm乘法梯度<br/>grad_hc = grad_norm·inv_rms<br/>输出: B,S,N²+2N<br/>grad_inv_rms = hc·grad_norm.sum<br/>输出: B,S,1]
        
        C4[bias梯度组装<br/>grad_bias = cat<br/>输出: N²+2N]
        
        C5[RMSNorm倒数梯度<br/>x_flat = x.flatten<br/>输出: B,S,N·D<br/>grad_x_from_rms = RMSNormGrad<br/>输出: B,S,N·D]
        
        C6[矩阵乘法梯度+汇总<br/>grad_phi = grad_hc.T·x<br/>输出: N²+2N,N·D<br/>grad_x = sum<br/>输出: B,S,N,D]
