+### 4.4 文件 4: `mega_moe_combine_send.h`
+
+#### 4.4.1 修改 `CombineTokens()` 函数
+
+**改动位置**：约第 42-65 行
+
+**改动内容**：在发送数据后，发送 flag。
+
+```cpp
+template <typename ElementMMadOut2, typename BlockShape>
+__aicore__ inline void CombineTokens(uint32_t mLoc, uint32_t nLoc, uint32_t n,
+                                     LocalTensor<int32_t> &metaInfoTensor,
+                                     LocalTensor<ElementMMadOut2> &l0cOutUbGMM2,
+                                     BlockShape &actualBlockShape,
+                                     const Params &params)
+{
+    int32_t lenTile = Get<M_VALUE>(actualBlockShape);
+    AscendC::GlobalTensor<ElementMMadOut2> gmRemoteD;
+    uint64_t gmRemoteBaseOffset = params.peermemInfo.combineSendPtr - params.peermemInfo.rankSyncInWorldPtr;
+    AscendC::GlobalTensor<int32_t> gmRemoteFlag;
+    uint64_t gmFlagBaseOffset = params.peermemInfo.combineSendFlagPtr - params.peermemInfo.rankSyncInWorldPtr;
+
+    uint32_t nTilesPerSlot = Ops::Base::CeilDiv(n, L1_TILE_N);
+
+    AscendC::DataCopyExtParams ub2GmParams{1, 0, 0, 0, 0};
+    ub2GmParams.blockCount = 1;
+    ub2GmParams.blockLen = Get<N_VALUE>(actualBlockShape) * sizeof(ElementMMadOut2);
+
+    AscendC::DataCopyExtParams flagParams{1, static_cast<uint32_t>(sizeof(int32_t)), 0, 0, 0};
+
+    AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(0);
+    AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(0);
+
+    for (int32_t tileIdx = 0; tileIdx < lenTile; ++tileIdx) {
+        uint32_t toRankId = metaInfoTensor.GetValue(tileIdx * 8);
+        uint32_t tokenIdx = metaInfoTensor.GetValue(tileIdx * 8 + 1);
+        uint32_t topkIdx = metaInfoTensor.GetValue(tileIdx * 8 + 2);
+
+        // 当前 n-tile 的 tile 索引（在 slot 内）
+        uint32_t currentTileIdx = nLoc / L1_TILE_N;
+
+        // 计算 flag 偏移：slot 内第 currentTileIdx 个 tile 的 flag
+        uint64_t flagOffset = (static_cast<uint64_t>(tokenIdx) * params.tilingData->topK + topkIdx) *
+                                nTilesPerSlot + currentTileIdx;
+
+        // 设置数据目标地址
+        gmRemoteD.SetGlobalBuffer(
+            reinterpret_cast<__gm__ ElementMMadOut2 *>(GetRankWinAddrWithOffset(toRankId, gmRemoteBaseOffset)));
+        uint64_t gmDstOffset = (static_cast<uint64_t>(tokenIdx) * params.tilingData->topK + topkIdx) * n + nLoc;
+
+        // 设置 flag 目标地址
+        gmRemoteFlag.SetGlobalBuffer(
+            reinterpret_cast<__gm__ int32_t *>(GetRankWinAddrWithOffset(toRankId, gmFlagBaseOffset)));
+
+        // 发送数据
+        AscendC::DataCopyPad(gmRemoteD[gmDstOffset], l0cOutUbGMM2[tileIdx * Get<N_VALUE>(actualBlockShape)],
+                             ub2GmParams);
+
+        // 等待数据发送完成
+        AscendC::PipeBarrier<AscendC::PIPE_MTE3>();
+
+        // 发送 flag（值为 1）
+        LocalTensor<int32_t> flagTensor;  // 需要从 UB 分配
+        AscendC::Duplicate(flagTensor, 1, 1);  // flag 值 = 1
+        AscendC::DataCopyPad(gmRemoteFlag[flagOffset], flagTensor, flagParams);
+    }
+}
+```
+
+**注意事项**：
+- `flagTensor` 需要从 UB 分配，实际实现中可以在循环外分配一个 int32_t 的 UB tensor
+- `PipeBarrier<PIPE_MTE3>()` 确保数据发送完成后才发送 flag
+
+#### 4.4.2 修改 `CombineQuantizedTokens()` 函数
+
+**改动位置**：约第 419-438 行
+
+**改动内容**：QUANT 路径也需要发送 flag（值为 1）。
+
+```cpp
+template <typename QuantOutType>
+__aicore__ inline void CombineQuantizedTokens(uint32_t batchStart, uint32_t curRows, uint32_t n, uint32_t nScale,
+                                              uint32_t groupIdx, uint32_t rankId, LocalTensor<int32_t> &metaInfoTensor,
+                                              LocalTensor<QuantOutType> &ubQuant, const Params &params)
+{
+    int64_t quantTokenSize = n + nScale;
+    uint32_t toRankId = metaInfoTensor.GetValue(batchStart * META_INFO_SIZE + RANK_ID);
+    uint32_t tokenIdx = metaInfoTensor.GetValue(batchStart * META_INFO_SIZE + TOKEN_ID);
+    uint32_t topkIdx = metaInfoTensor.GetValue(batchStart * META_INFO_SIZE + TOPK_INDEX);
+
+    AscendC::GlobalTensor<QuantOutType> gmRemoteD;
+    uint64_t gmRemoteOffset = params.peermemInfo.combineSendPtr - params.peermemInfo.rankSyncInWorldPtr;
+    __gm__ void *dstPeermemPtr = GetRankWinAddrWithOffset(toRankId, gmRemoteOffset);
+    gmRemoteD.SetGlobalBuffer(reinterpret_cast<__gm__ QuantOutType *>(dstPeermemPtr));
+
+    uint64_t dstBaseOffset = (static_cast<uint64_t>(tokenIdx) * params.tilingData->topK + topkIdx) * quantTokenSize;
+
+    AscendC::DataCopyExtParams singleCopyParams{1, static_cast<uint32_t>(quantTokenSize), 0, 0, 0};
+    AscendC::DataCopyPad(gmRemoteD[dstBaseOffset], ubQuant, singleCopyParams);
+
+    // ========== 新增：发送 flag ==========
+    AscendC::PipeBarrier<AscendC::PIPE_MTE3>();
+
+    AscendC::GlobalTensor<int32_t> gmRemoteFlag;
+    uint64_t gmFlagOffset = params.peermemInfo.combineSendFlagPtr - params.peermemInfo.rankSyncInWorldPtr;
+    gmRemoteFlag.SetGlobalBuffer(
+        reinterpret_cast<__gm__ int32_t *>(GetRankWinAddrWithOffset(toRankId, gmFlagOffset)));
+
+    // QUANT 路径每个 slot 只有一个 flag（nTilesPerSlot = 1）
+    uint64_t flagDstOffset = (static_cast<uint64_t>(tokenIdx) * params.tilingData->topK + topkIdx);
+    LocalTensor<int32_t> flagTensor;  // 从 UB 分配
+    AscendC::Duplicate(flagTensor, 1, 1);
+    AscendC::DataCopyExtParams flagParams{1, static_cast<uint32_t>(sizeof(int32_t)), 0, 0, 0};
+    AscendC::DataCopyPad(gmRemoteFlag[flagDstOffset], flagTensor, flagParams);
+}
+```
