+**改动位置**：`PeermemInfo` 构造函数（约第 45-100 行）
+
+**改动内容**：
+
+```cpp
+struct PeermemInfo {
+    GM_ADDR rankSyncInWorldPtr;
+    GM_ADDR maskRecvPtr;
+    GM_ADDR quantTokenScalePtr;
+    GM_ADDR dispatchRecivePtr;
+    GM_ADDR combineSendPtr;
+    GM_ADDR combineSendFlagPtr;  // 新增：flag 区指针
+
+    __aicore__ inline PeermemInfo() = default;
+
+    // 新增构造函数变体或修改现有构造函数
+    __aicore__ inline PeermemInfo(GM_ADDR base, const MegaMoeTilingData *tilingData,
+                                  uint32_t elemsPerByte = 1, uint32_t serverNum = 1,
+                                  uint32_t flagCountTotal = 0)  // 新增参数
+    {
+        // ... 现有代码保持不变，直到 combineSendPtr 计算 ...
+        combineSendPtr = base + offset;
+
+        // ========== 新增：计算 flag 区 ==========
+        // Flag 区紧跟数据区，ALIGN_512 对齐
+        offset = Ops::Base::CeilAlign(
+            static_cast<int64_t>(tilingData->bs) *
+            static_cast<int64_t>(tilingData->topK) *
+            static_cast<int64_t>(tilingData->h) *
+            static_cast<int64_t>(sizeof(bf16_t)),
+            static_cast<int64_t>(ALIGN_512));
+
+        combineSendFlagPtr = base + offset;
+        // Flag 区大小按 32B 对齐（int32_t）
+        offset += Ops::Base::CeilAlign(
+            static_cast<int64_t>(flagCountTotal) * static_cast<int64_t>(sizeof(int32_t)),
+            static_cast<int64_t>(ALIGN_32));
+    }
+};
+```
+
+**注意事项**：
+- `combineSendFlagPtr` 在现有 `combineSendPtr` 之后
+- 需要传入 `flagCountTotal` 参数（由 host 侧 tiling 计算）
