#include <cstdint>
#define HCOMM_DFX_INCLUDE_IMPLEMENTATION
#include "adv_api/hcomm/dfx/hcomm_channel_dump.h"

extern "C" int32_t Mc2HcommChannelInfoDumpShim(uint64_t channel)
{
    return AscendC::HcommChannelInfoDump(static_cast<AscendC::ChannelHandle>(channel));
}

extern "C" int32_t Mc2HcommChannelExceptionRegisterShim(const void *kernelSymbol)
{
    return AscendC::HcommChannelExceptionCallbackRegister(kernelSymbol);
}