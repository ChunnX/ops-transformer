diff --git a/mc2/moe_distribute_combine_v2/op_kernel/arch22/moe_distribute_combine_v2.h b/mc2/moe_distribute_combine_v2/op_kernel/arch22/moe_distribute_combine_v2.h
index 4cc0aab5f..7e229e72f 100644
--- a/mc2/moe_distribute_combine_v2/op_kernel/arch22/moe_distribute_combine_v2.h
+++ b/mc2/moe_distribute_combine_v2/op_kernel/arch22/moe_distribute_combine_v2.h
@@ -1736,14 +1736,26 @@ template <CombineMC2TypeClass>
 __aicore__ inline void MoeDistributeCombineV2<CombineMC2TypeFunc>::Process()
 {
     if ASCEND_IS_AIV {
+        PrintTimeStamp(100U);
+        uint64_t stageStart = GetSystemCycle();
         if (coreIdx_ < sendAivNum_) {
             BuffInit();
+            PrintTimeStamp(101U);
             ExpertAlltoAllDispatchCopyAdd();
-            // Drain per-slot events and DMA before reusing UB for reception.
             PipeBarrier<PIPE_ALL>();
         }
+        uint64_t stageSend = GetSystemCycle();
+        PrintTimeStamp(102U);
         AlltoAllBuffInitAndMaskCal();
+        uint64_t stageInit = GetSystemCycle();
+        PrintTimeStamp(103U);
         LocalWindowCopy();
+        PipeBarrier<PIPE_ALL>();
+        uint64_t stageDone = GetSystemCycle();
+        PrintTimeStamp(104U);
+        printf("A3_STAGE rank=%u core=%u send_cores=%u recv_cores=%u send=%llu init=%llu recv=%llu total=%llu\n",
+               epRankId_, coreIdx_, sendAivNum_, recvAivNum_, stageSend - stageStart,
+               stageInit - stageSend, stageDone - stageInit, stageDone - stageStart);
     }
 }

