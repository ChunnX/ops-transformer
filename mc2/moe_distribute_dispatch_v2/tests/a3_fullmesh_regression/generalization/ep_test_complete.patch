 class MoeDistributeCombineV2(MoeDistributeCombineBase):
     def forward(self, input: Input, param: Dict):
         model = MOE_DISTRIBUTE_COMBINEV2_MODEL()
+        if param.get("case_name", "").startswith("stress_alternating_"):
+            # Flip both ping-pong halves on reuse; +/- on every call would
+            # leave each half with the same sign and hide stale payload reads.
+            positive = input.expand_x
+            # Prepare once on CPU; the isolated operator package need not provide Neg.
+            negative = (-positive.cpu()).to(positive.device)
+            torch.npu.synchronize()
+            outputs = []
+            kwargs = input.asdict()
+            for iteration in range(32):
+                sign = 1 if (iteration // 2) % 2 == 0 else -1
+                kwargs["expand_x"] = positive if sign == 1 else negative
+                outputs.append((sign, model(**kwargs)))
+            reference = outputs[0][1][0].cpu()
+            for iteration, (sign, value) in enumerate(outputs):
+                actual = value[0].cpu()
+                if not torch.equal(actual, reference * sign):
+                    import os
+                    from pathlib import Path
+                    directory = Path(os.environ["EP_TEST_COMBINE_DUMP"])
+                    directory.mkdir(parents=True, exist_ok=True)
+                    torch.save({"actual": actual, "reference": reference, "sign": sign,
+                                "iteration": iteration, "rank": input.ep_rank_id},
+                               directory / f"stream_failure_rank{input.ep_rank_id}.pt")
+                    raise AssertionError(f"Alternating payload mismatch: rank={input.ep_rank_id}, call={iteration}")
+            print("EP16_STREAM_CHECK", input.ep_rank_id, 32, True, flush=True)
+            return outputs[0][1]
         output = self.forward_op(model, input, param)
         return output
