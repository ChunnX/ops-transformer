#include <cstdlib>
#include <cstring>
#include <cstdio>
#include <cmath>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

__global__ __vector__ void add_pinned(__gm__ uint8_t* x, __gm__ uint8_t* y,
                                       __gm__ uint8_t* z, uint32_t totalLength)
{
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, 2> outQueueZ;
    AscendC::GlobalTensor<half> xGm;
    AscendC::GlobalTensor<half> yGm;
    AscendC::GlobalTensor<half> zGm;

    uint32_t blockLength = totalLength / AscendC::GetBlockNum();
    uint32_t tileNum = 8;
    uint32_t tileLength = blockLength / tileNum / 2;

    xGm.SetGlobalBuffer((__gm__ half*)x + blockLength * AscendC::GetBlockIdx(), blockLength);
    yGm.SetGlobalBuffer((__gm__ half*)y + blockLength * AscendC::GetBlockIdx(), blockLength);
    zGm.SetGlobalBuffer((__gm__ half*)z + blockLength * AscendC::GetBlockIdx(), blockLength);
    pipe.InitBuffer(inQueueX, 2, tileLength * sizeof(half));
    pipe.InitBuffer(inQueueY, 2, tileLength * sizeof(half));
    pipe.InitBuffer(outQueueZ, 2, tileLength * sizeof(half));

    int32_t loopCount = tileNum * 2;
    for (int32_t i = 0; i < loopCount; i++) {
        AscendC::LocalTensor<half> xLocal = inQueueX.AllocTensor<half>();
        AscendC::LocalTensor<half> yLocal = inQueueY.AllocTensor<half>();
        AscendC::DataCopy(xLocal, xGm[i * tileLength], tileLength);
        AscendC::DataCopy(yLocal, yGm[i * tileLength], tileLength);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);

        xLocal = inQueueX.DeQue<half>();
        yLocal = inQueueY.DeQue<half>();
        AscendC::LocalTensor<half> zLocal = outQueueZ.AllocTensor<half>();
        AscendC::Add(zLocal, xLocal, yLocal, tileLength);
        outQueueZ.EnQue<half>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);

        zLocal = outQueueZ.DeQue<half>();
        AscendC::DataCopy(zGm[i * tileLength], zLocal, tileLength);
        outQueueZ.FreeTensor(zLocal);
    }
}

static uint32_t verify_add(half* xData, half* yData, half* zData, uint32_t totalLength)
{
    uint32_t errors = 0;
    for (uint32_t i = 0; i < totalLength; i++) {
        float expected = (float)xData[i] + (float)yData[i];
        float actual = (float)zData[i];
        if (fabs(expected - actual) > 0.01f) {
            if (errors < 10) {
                printf("  idx=%u: x=%.3f y=%.3f expected=%.3f actual=%.3f\n",
                       i, (float)xData[i], (float)yData[i], expected, actual);
            }
            errors++;
        }
    }
    return errors;
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t numBlocks = 8;
    constexpr uint32_t totalLength = 8 * 2048;
    size_t byteSize = totalLength * sizeof(half);

    aclError ret;
    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    half* xData = (half*)malloc(byteSize);
    half* yData = (half*)malloc(byteSize);
    for (uint32_t i = 0; i < totalLength; i++) {
        xData[i] = (half)((float)(i % 100) + 1.0f);
        yData[i] = (half)((float)((i + 3) % 100) + 1.0f);
    }

    uint8_t* zDev = nullptr;
    uint8_t* zHost = (uint8_t*)malloc(byteSize);
    aclrtMalloc((void**)&zDev, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    // ================================================================
    // Test 1: Normal — aclrtMalloc + aclrtMemcpy H2D
    // ================================================================
    printf("=== Test 1: Normal (aclrtMalloc + H2D memcpy) ===\n");

    uint8_t* xDevNormal = nullptr;
    uint8_t* yDevNormal = nullptr;
    uint8_t* xHostBuf = nullptr;
    uint8_t* yHostBuf = nullptr;

    aclrtMallocHost((void**)(&xHostBuf), byteSize);
    aclrtMallocHost((void**)(&yHostBuf), byteSize);
    memcpy(xHostBuf, xData, byteSize);
    memcpy(yHostBuf, yData, byteSize);

    aclrtMalloc((void**)&xDevNormal, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevNormal, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(xDevNormal, byteSize, xHostBuf, byteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yDevNormal, byteSize, yHostBuf, byteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    memset(zHost, 0, byteSize);
    add_pinned<<<numBlocks, nullptr, stream>>>(xDevNormal, yDevNormal, zDev, totalLength);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(zHost, byteSize, zDev, byteSize, ACL_MEMCPY_DEVICE_TO_HOST);

    uint32_t normalErrors = verify_add(xData, yData, (half*)zHost, totalLength);
    if (normalErrors > 0) {
        printf("[FAIL] Normal: %u errors out of %u elements\n", normalErrors, totalLength);
    } else {
        printf("[PASS] Normal: all %u elements correct\n", totalLength);
    }
    WriteFile("../output/output_normal.bin", zHost, byteSize);

    aclrtFree(xDevNormal);
    aclrtFree(yDevNormal);
    aclrtFreeHost(xHostBuf);
    aclrtFreeHost(yHostBuf);

    // ================================================================
    // Test 2: Pinned — aclrtMallocHost + RegisterV2(MAPPED)
    // ================================================================
    printf("\n=== Test 2: Pinned (aclrtMallocHost + RegisterV2(MAPPED)) ===\n");

    half* xHostPinned = nullptr;
    half* yHostPinned = nullptr;
    aclrtMallocHost((void**)(&xHostPinned), byteSize);
    aclrtMallocHost((void**)(&yHostPinned), byteSize);
    memcpy(xHostPinned, xData, byteSize);
    memcpy(yHostPinned, yData, byteSize);

    uint8_t* xDevMapped = nullptr;
    uint8_t* yDevMapped = nullptr;
    bool xMapped = false;
    bool yMapped = false;

    ret = aclrtHostRegisterV2((void*)xHostPinned, byteSize, ACL_HOST_REG_MAPPED);
    printf("[INFO] RegisterV2(xHost, MAPPED) ret=%d\n", ret);
    if (ret == ACL_SUCCESS) {
        ret = aclrtHostGetDevicePointer((void*)xHostPinned, (void**)&xDevMapped, 0);
        printf("[INFO] GetDevicePointer(xHost) ret=%d xDevMapped=%p\n", ret, (void*)xDevMapped);
        xMapped = (ret == ACL_SUCCESS && xDevMapped != nullptr);
    }

    ret = aclrtHostRegisterV2((void*)yHostPinned, byteSize, ACL_HOST_REG_MAPPED);
    printf("[INFO] RegisterV2(yHost, MAPPED) ret=%d\n", ret);
    if (ret == ACL_SUCCESS) {
        ret = aclrtHostGetDevicePointer((void*)yHostPinned, (void**)&yDevMapped, 0);
        printf("[INFO] GetDevicePointer(yHost) ret=%d yDevMapped=%p\n", ret, (void*)yDevMapped);
        yMapped = (ret == ACL_SUCCESS && yDevMapped != nullptr);
    }

    printf("[INFO] xMapped=%d yMapped=%d\n", xMapped, yMapped);

    memset(zHost, 0, byteSize);
    add_pinned<<<numBlocks, nullptr, stream>>>(xDevMapped, yDevMapped, zDev, totalLength);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(zHost, byteSize, zDev, byteSize, ACL_MEMCPY_DEVICE_TO_HOST);

    uint32_t pinnedErrors = verify_add(xData, yData, (half*)zHost, totalLength);
    if (pinnedErrors > 0) {
        printf("[FAIL] Pinned: %u errors out of %u elements\n", pinnedErrors, totalLength);
    } else {
        printf("[PASS] Pinned: all %u elements correct\n", totalLength);
    }
    WriteFile("../output/output_pinned.bin", zHost, byteSize);

    // ================================================================
    // Comparison
    // ================================================================
    printf("\n=== Comparison ===\n");
    printf("| %-12s | %-8s | %-12s |\n", "Test", "Result", "Error Count");
    printf("|--------------|----------|--------------|\n");
    printf("| %-12s | %-8s | %u            |\n",
           "Normal", normalErrors == 0 ? "PASS" : "FAIL", normalErrors);
    printf("| %-12s | %-8s | %u            |\n",
           "Pinned", pinnedErrors == 0 ? "PASS" : "FAIL", pinnedErrors);

    if (xMapped) aclrtHostUnregister((void*)xHostPinned);
    if (yMapped) aclrtHostUnregister((void*)yHostPinned);
    aclrtFreeHost((void*)xHostPinned);
    aclrtFreeHost((void*)yHostPinned);
    aclrtFree(zDev);
    free(zHost);
    free(xData);
    free(yData);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return (normalErrors + pinnedErrors > 0) ? 1 : 0;
}