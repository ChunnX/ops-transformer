* ============================================================================
* MoeEpDispatch 方案穿刺 — Host↔Device 零拷贝 Ping-Buffer 验证
* ============================================================================
*
* 目的: 验证 dispatch 方案中最关键的一段——Host 通过 host-pinned + RegisterV2(MAPPED)
*       获得零拷贝同步通道, kernel 写完 counter 后 Host 即时感知, 无需 D2H memcpy。
*
* 流程:
*   [Host] aclrtMallocHost → RegisterV2(MAPPED) → syncHost (host-pinned, device-mapped)
*   [OP1] add_custom_with_sync: x + y → bufA, 将 output size 写入 syncHost (kernel 直写)
*   [Host] while(*syncHost == 0) {}  ← 零拷贝自旋 (不依赖 SynchronizeStream)
*   [Host] 读 syncHost 取得 OP2 所需 size → malloc(bufB) → aclrtMalloc(bufDevB)
*   [OP2] add_custom: x + y → bufDevB
*   [Host] 验证 OP1/OP2 输出 == golden
*
* 关键发现:
*   910_93 + CANN 9.1.0 上, 必须用 aclrtMallocHost 申请内存才能 RegisterV2(MAPPED) 成功;
*   普通 malloc 返回 ACL_ERROR_RT_FEATURE_NOT_SUPPORT (507899), GetDevicePointer 返 nil。
*
* 对应 dispatch 设计: REQUIREMENTS §1.1, DESIGN §2.3 / §3.3.5 host-pinned counter
*/

#include <cstdlib>
#include <cstring>
#include <cstdio>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

// ============================================================================
// OP1: 带 sync 写回的 Add 核函数
// 功能: x + y → z, 同时将 output size 写入 sync (host-pinned, device-mapped)
// 对应 dispatch K1: 跨 rank 通信 + 写 host-pinned actualA
// ============================================================================
__global__ __vector__ void add_custom_with_sync(__gm__ uint8_t* x, __gm__ uint8_t* y,
                                                 __gm__ uint8_t* z, __gm__ uint8_t* sync,
                                                 uint32_t totalLength)
{
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, 2> outQueueZ;
    AscendC::GlobalTensor<half> xGm;
    AscendC::GlobalTensor<half> yGm;
    AscendC::GlobalTensor<half> zGm;

    // 多核切分: totalLength 均分到 GetBlockNum() 个核
    uint32_t blockLength = totalLength / AscendC::GetBlockNum();
    uint32_t tileNum = 8;
    uint32_t tileLength = blockLength / tileNum / 2;  // BUFFER_NUM=2

    xGm.SetGlobalBuffer((__gm__ half*)x + blockLength * AscendC::GetBlockIdx(), blockLength);
    yGm.SetGlobalBuffer((__gm__ half*)y + blockLength * AscendC::GetBlockIdx(), blockLength);
    zGm.SetGlobalBuffer((__gm__ half*)z + blockLength * AscendC::GetBlockIdx(), blockLength);
    pipe.InitBuffer(inQueueX, 2, tileLength * sizeof(half));
    pipe.InitBuffer(inQueueY, 2, tileLength * sizeof(half));
    pipe.InitBuffer(outQueueZ, 2, tileLength * sizeof(half));

    // 双缓冲流水: CopyIn → Compute → CopyOut (tileNum × BUFFER_NUM 轮)
    int32_t loopCount = tileNum * 2;
    for (int32_t i = 0; i < loopCount; i++) {
        AscendC::LocalTensor<half> xLocal = inQueueX.AllocTensor<half>();
        AscendC::LocalTensor<half> yLocal = inQueueY.AllocTensor<half>();
        AscendC::DataCopy(xLocal, xGm[i * tileLength], tileLength);
        AscendC::DataCopy(yLocal, yGm[i * tileLength], tileLength);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);

        xLocal = inQueueX.DeQue<half>();
        yLocal = inQueueY.DeQue<half>();
        AscendC::LocalTensor<half> zLocal = outQueueZ.AllocTensor<half>();
        AscendC::Add(zLocal, xLocal, yLocal, tileLength);
        outQueueZ.EnQue<half>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);

        zLocal = outQueueZ.DeQue<half>();
        AscendC::DataCopy(zGm[i * tileLength], zLocal, tileLength);
        outQueueZ.FreeTensor(zLocal);
    }

    // ================================================================
    // 关键穿刺点: kernel 直接写 host-pinned mapped 内存
    // sync 指向 Host 侧 aclrtMallocHost + RegisterV2(MAPPED) 的内存
    // 仅 block0 写, 避免多核竞争; volatile 保证编译器不会优化掉写入
    // ================================================================
    if (AscendC::GetBlockIdx() == 0) {
        *(volatile __gm__ uint32_t*)sync = totalLength * sizeof(half);
    }
}

// ============================================================================
// OP2: 普通 Add 核函数
// 功能: x + y → z, 无 sync 写回
// 对应 dispatch K2(Epilogue): 从 HCCL Window 紧凑拷贝到预分配 recv_x
// ============================================================================
__global__ __vector__ void add_custom(__gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* z, uint32_t totalLength)
{
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, 2> outQueueZ;
    AscendC::GlobalTensor<half> xGm;
    AscendC::GlobalTensor<half> yGm;
    AscendC::GlobalTensor<half> zGm;

    uint32_t blockLength = totalLength / AscendC::GetBlockNum();
    uint32_t tileNum = 8;
    uint32_t tileLength = blockLength / tileNum / 2;

    xGm.SetGlobalBuffer((__gm__ half*)x + blockLength * AscendC::GetBlockIdx(), blockLength);
    yGm.SetGlobalBuffer((__gm__ half*)y + blockLength * AscendC::GetBlockIdx(), blockLength);
    zGm.SetGlobalBuffer((__gm__ half*)z + blockLength * AscendC::GetBlockIdx(), blockLength);
    pipe.InitBuffer(inQueueX, 2, tileLength * sizeof(half));
    pipe.InitBuffer(inQueueY, 2, tileLength * sizeof(half));
    pipe.InitBuffer(outQueueZ, 2, tileLength * sizeof(half));

    int32_t loopCount = tileNum * 2;
    for (int32_t i = 0; i < loopCount; i++) {
        AscendC::LocalTensor<half> xLocal = inQueueX.AllocTensor<half>();
        AscendC::LocalTensor<half> yLocal = inQueueY.AllocTensor<half>();
        AscendC::DataCopy(xLocal, xGm[i * tileLength], tileLength);
        AscendC::DataCopy(yLocal, yGm[i * tileLength], tileLength);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);

        xLocal = inQueueX.DeQue<half>();
        yLocal = inQueueY.DeQue<half>();
        AscendC::LocalTensor<half> zLocal = outQueueZ.AllocTensor<half>();
        AscendC::Add(zLocal, xLocal, yLocal, tileLength);
        outQueueZ.EnQue<half>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);

        zLocal = outQueueZ.DeQue<half>();
        AscendC::DataCopy(zGm[i * tileLength], zLocal, tileLength);
        outQueueZ.FreeTensor(zLocal);
    }
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t numBlocks = 8;
    constexpr uint32_t totalLength = 8 * 2048;
    size_t inputByteSize = totalLength * sizeof(half);
    size_t outputByteSize = totalLength * sizeof(half);

    // ========================================================================
    // Step 0: 环境初始化 — 创建 device context + stream
    // ========================================================================
    aclError ret;
    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    // ========================================================================
    // Step 1: Host 分配 x, y 输入 — 常规 device memory (无零拷贝要求)
    //   步骤: aclrtMallocHost(Host 侧) → ReadFile(读 bin) → aclrtMemcpy(H2D)
    // ========================================================================
    uint8_t* xHost = nullptr;
    uint8_t* yHost = nullptr;
    uint8_t* xDevice = nullptr;
    uint8_t* yDevice = nullptr;
    aclrtMallocHost((void**)(&xHost), inputByteSize);
    aclrtMallocHost((void**)(&yHost), inputByteSize);
    aclrtMalloc((void**)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("../input/input_x.bin", inputByteSize, xHost, inputByteSize);
    ReadFile("../input/input_y.bin", inputByteSize, yHost, inputByteSize);
    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yDevice, inputByteSize, yHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // ========================================================================
    // Step 2: 申请 host-pinned + device-mapped sync buffer (零拷贝通道)
    //
    //   关键发现 (910_93 + CANN 9.1.0):
    //     普通 malloc → RegisterV2(MAPPED) → ret=507899 (FEATURE_NOT_SUPPORT)
    //     aclrtMallocHost → RegisterV2(MAPPED) → ret=0 ✓
    //
    //   此步成功后 kernel 可通过 __gm__ 指针直接写 syncHost 对应的物理页,
    //   Host 端 volatile 读取即时可见, 无需 aclrtMemcpy(D2H)。
    //
    //   若不可用则 fallback 到 device mem + 显式 D2H 轮询 (逻辑等价)。
    // ========================================================================
    volatile uint32_t* syncHost = nullptr;
    uint8_t* syncDev = nullptr;
    bool useZeroCopySync = false;

    ret = aclrtMallocHost((void**)(&syncHost), sizeof(uint32_t));
    printf("[INFO] aclrtMallocHost(sync) ret=%d ptr=%p\n", ret, (void*)syncHost);
    if (ret == ACL_SUCCESS) {
        *syncHost = 0;
        ret = aclrtHostRegisterV2((void*)syncHost, sizeof(uint32_t), ACL_HOST_REG_MAPPED);
        printf("[INFO] RegisterV2(MAPPED) ret=%d (0=success)\n", ret);
        if (ret == ACL_SUCCESS) {
            ret = aclrtHostGetDevicePointer((void*)syncHost, (void**)&syncDev, 0);
            printf("[INFO] GetDevicePointer ret=%d syncDev=%p\n", ret, (void*)syncDev);
            useZeroCopySync = (ret == ACL_SUCCESS && syncDev != nullptr);
        }
    }
    printf("[INFO] Final: useZeroCopySync=%d\n", useZeroCopySync);

    // fallback: device mem sync counter (功能等价, 非零拷贝)
    uint32_t* syncDevFallback = nullptr;
    if (!useZeroCopySync) {
        aclrtMalloc((void**)&syncDevFallback, sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST);
        uint32_t zero = 0;
        aclrtMemcpy(syncDevFallback, sizeof(uint32_t), &zero, sizeof(uint32_t), ACL_MEMCPY_HOST_TO_DEVICE);
        syncDev = (uint8_t*)syncDevFallback;
        printf("[INFO] Fallback to device-mem sync counter at %p\n", (void*)syncDev);
    }

    // ========================================================================
    // Step 2b: OP1 输出 bufA — 常规 device mem
    //   OP1 kernel 写 bufDevA, Host 用 aclrtMemcpy D2H 读回 bufHostA 验证
    // ========================================================================
    uint8_t* bufHostA = (uint8_t*)malloc(outputByteSize);
    uint8_t* bufDevA  = nullptr;
    aclrtMalloc((void**)&bufDevA, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    memset(bufHostA, 0, outputByteSize);
    printf("[INFO] bufHostA=%p bufDevA=%p\n", (void*)bufHostA, (void*)bufDevA);

    // ========================================================================
    // Step 3: OP1 (add_custom_with_sync) — 异步发射, Host 轮询 sync
    //
    //   核心验证点: 在 SynchronizeStream 之前, Host 就能通过零拷贝读到
    //   kernel 写入的 size 值。先 ping 再 sync, 顺序不能反。
    //
    //   零拷贝路径: while(*syncHost==0){}   ← Host 直接读物理页
    //   fallback  : while(memcpy D2H..==0) ← 显式拷贝轮询
    // ========================================================================
    printf("[INFO] === Launching OP1 (add_custom_with_sync) ===\n");
    add_custom_with_sync<<<numBlocks, nullptr, stream>>>(
        xDevice, yDevice, bufDevA, syncDev, totalLength);

    uint32_t op2BufSize = 0;
    uint32_t pollCount = 0;
    printf("[INFO] Host polling sync (before SynchronizeStream) ...\n");
    if (useZeroCopySync) {
        while (*syncHost == 0) { pollCount++; }
        op2BufSize = *syncHost;
    } else {
        while (true) {
            aclrtMemcpy(&op2BufSize, sizeof(uint32_t), syncDev, sizeof(uint32_t), ACL_MEMCPY_DEVICE_TO_HOST);
            pollCount++;
            if (op2BufSize != 0) break;
        }
    }
    aclrtSynchronizeStream(stream);
    printf("[INFO] OP1 done, %u polls, reported size = %u bytes\n", pollCount, op2BufSize);

    // 读 OP1 完整输出, 写文件供后续精度验证
    aclrtMemcpy(bufHostA, outputByteSize, bufDevA, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("../output/output_op1.bin", bufHostA, outputByteSize);

    // ========================================================================
    // Step 4: 根据 OP1 传回的 size 动态分配 OP2 缓冲区
    //
    //   对应 dispatch: Host spin 拿到 actualA → torch.empty({actualA, hidden})
    //   这里简化: malloc(op2BufSize) 做 host buffer, aclrtMalloc 做 device buffer
    // ========================================================================
    uint8_t* bufHostB = (uint8_t*)malloc(op2BufSize);
    uint8_t* bufDevB  = nullptr;
    aclrtMalloc((void**)&bufDevB, op2BufSize, ACL_MEM_MALLOC_HUGE_FIRST);
    memset(bufHostB, 0, op2BufSize);
    printf("[INFO] bufHostB=%p bufDevB=%p (dynamic size=%u)\n", (void*)bufHostB, (void*)bufDevB, op2BufSize);

    // ========================================================================
    // Step 5: OP2 (add_custom) — 写入动态分配的 bufDevB
    //   对应 dispatch K2 (Epilogue): HCCL Window → 预分配 recv_x 紧凑拷贝
    // ========================================================================
    printf("[INFO] === Running OP2 ===\n");
    add_custom<<<numBlocks, nullptr, stream>>>(xDevice, yDevice, bufDevB, totalLength);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(bufHostB, op2BufSize, bufDevB, op2BufSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("../output/output_op2.bin", bufHostB, op2BufSize);

    // ========================================================================
    // Step 6: 清理 — 注意 HostRegistered 内存先 Unregister 再 Free
    // ========================================================================
    if (useZeroCopySync) {
        aclrtHostUnregister((void*)syncHost);
    }
    if (syncHost) aclrtFreeHost((void*)syncHost);
    if (syncDevFallback) aclrtFree((void*)syncDevFallback);
    aclrtFree(bufDevA);
    aclrtFree(bufDevB);
    free(bufHostA);
    free(bufHostB);
    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    printf("[INFO] Done. output_op1.bin / output_op2.bin written.\n");
    return 0;
}
