/**
 * Copyright (c) 2025 Huawei Technologies Co., Ltd.
 *
 * Ping-Buffer + aclrtHostRegister V2 穿刺
 *
 * Host: aclrtHostRegisterV2(MAPPED) + aclrtHostGetDevicePointer → syncHost/syncDev 零拷贝
 * OP1: x+y→bufA, 写 syncDev 通知 host
 * Host: while(*syncHost==0){} 自旋轮询 → 动态 malloc OP2 buffer
 * OP2: x+y→bufB
 *
 * sync 写入三种写法:
 *   1. volatile __gm__* 赋值       (A3✅ A5❌ Vector Core 异常)
 *   2. st_dev 标量存               (A3✅ A5❌ Vector Core 异常)
 *   3. DataCopy MTE 搬运           (A3✅ A5✅)
 */

#include <cstdlib>
#include <cstring>
#include <cstdio>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

// ============ OP1: Add + 写 sync ============
__global__ __vector__ void add_custom_with_sync(__gm__ uint8_t* x, __gm__ uint8_t* y,
                                                 __gm__ uint8_t* z, __gm__ uint8_t* sync,
                                                 uint32_t totalLength)
{
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, 2> outQueueZ;
    AscendC::GlobalTensor<half> xGm, yGm, zGm;

    uint32_t blockLength = totalLength / AscendC::GetBlockNum();
    uint32_t tileNum = 8;
    uint32_t tileLength = blockLength / tileNum / 2;

    xGm.SetGlobalBuffer((__gm__ half*)x + blockLength * AscendC::GetBlockIdx(), blockLength);
    yGm.SetGlobalBuffer((__gm__ half*)y + blockLength * AscendC::GetBlockIdx(), blockLength);
    zGm.SetGlobalBuffer((__gm__ half*)z + blockLength * AscendC::GetBlockIdx(), blockLength);
    pipe.InitBuffer(inQueueX, 2, tileLength * sizeof(half));
    pipe.InitBuffer(inQueueY, 2, tileLength * sizeof(half));
    pipe.InitBuffer(outQueueZ, 2, tileLength * sizeof(half));

    for (int32_t i = 0; i < tileNum * 2; i++) {
        auto xLocal = inQueueX.AllocTensor<half>();
        auto yLocal = inQueueY.AllocTensor<half>();
        AscendC::DataCopy(xLocal, xGm[i * tileLength], tileLength);
        AscendC::DataCopy(yLocal, yGm[i * tileLength], tileLength);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
        xLocal = inQueueX.DeQue<half>();
        yLocal = inQueueY.DeQue<half>();
        auto zLocal = outQueueZ.AllocTensor<half>();
        AscendC::Add(zLocal, xLocal, yLocal, tileLength);
        outQueueZ.EnQue<half>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
        zLocal = outQueueZ.DeQue<half>();
        AscendC::DataCopy(zGm[i * tileLength], zLocal, tileLength);
        outQueueZ.FreeTensor(zLocal);
    }

    if (AscendC::GetBlockIdx() == 0) {
        // 写法1: volatile __gm__*                   A3✅ A5❌
        // *(volatile __gm__ uint32_t*)sync = totalLength * sizeof(half);
        // 写法2: st_dev 标量存                       A3✅ A5❌
        // st_dev(totalLength * sizeof(half), (__gm__ uint32_t*)sync, 0);
        // 写法3: DataCopy 搬运(复用 outQueueZ)       A3✅ A5✅
        AscendC::LocalTensor<half> syncLocal = outQueueZ.AllocTensor<half>();      // 借 outQueueZ 的 UB
        AscendC::Duplicate(syncLocal, (half)0.0, 16);                             // 32B 清零(避免残留)
        AscendC::LocalTensor<uint32_t> syncLocalU32 = syncLocal.ReinterpretCast<uint32_t>(); // half→uint32 重解释
        syncLocalU32.SetValue(0, totalLength * sizeof(half));                      // 写 uint32 值到 UB
        AscendC::GlobalTensor<half> syncGm;                                         // 绑定 GM 目标地址
        syncGm.SetGlobalBuffer((__gm__ half*)sync, 16);
        AscendC::DataCopy(syncGm, syncLocal, 16);                                  // MTE 搬 32B → mapped host
        outQueueZ.FreeTensor(syncLocal);                                           // 归还 UB
    }
}

// ============ OP2: Add ============
__global__ __vector__ void add_custom(__gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* z, uint32_t totalLength)
{
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, 2> outQueueZ;
    AscendC::GlobalTensor<half> xGm, yGm, zGm;

    uint32_t blockLength = totalLength / AscendC::GetBlockNum();
    uint32_t tileNum = 8;
    uint32_t tileLength = blockLength / tileNum / 2;

    xGm.SetGlobalBuffer((__gm__ half*)x + blockLength * AscendC::GetBlockIdx(), blockLength);
    yGm.SetGlobalBuffer((__gm__ half*)y + blockLength * AscendC::GetBlockIdx(), blockLength);
    zGm.SetGlobalBuffer((__gm__ half*)z + blockLength * AscendC::GetBlockIdx(), blockLength);
    pipe.InitBuffer(inQueueX, 2, tileLength * sizeof(half));
    pipe.InitBuffer(inQueueY, 2, tileLength * sizeof(half));
    pipe.InitBuffer(outQueueZ, 2, tileLength * sizeof(half));

    for (int32_t i = 0; i < tileNum * 2; i++) {
        auto xLocal = inQueueX.AllocTensor<half>();
        auto yLocal = inQueueY.AllocTensor<half>();
        AscendC::DataCopy(xLocal, xGm[i * tileLength], tileLength);
        AscendC::DataCopy(yLocal, yGm[i * tileLength], tileLength);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
        xLocal = inQueueX.DeQue<half>();
        yLocal = inQueueY.DeQue<half>();
        auto zLocal = outQueueZ.AllocTensor<half>();
        AscendC::Add(zLocal, xLocal, yLocal, tileLength);
        outQueueZ.EnQue<half>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
        zLocal = outQueueZ.DeQue<half>();
        AscendC::DataCopy(zGm[i * tileLength], zLocal, tileLength);
        outQueueZ.FreeTensor(zLocal);
    }
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t numBlocks = 8;
    constexpr uint32_t totalLength = 8 * 2048;
    size_t inputByteSize  = totalLength * sizeof(half);
    size_t outputByteSize = totalLength * sizeof(half);

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    // ---- Step 1: 输入 x, y ----
    uint8_t *xHost = nullptr, *yHost = nullptr;
    uint8_t *xDev  = nullptr, *yDev  = nullptr;
    aclrtMallocHost((void**)&xHost, inputByteSize);
    aclrtMallocHost((void**)&yHost, inputByteSize);
    aclrtMalloc((void**)&xDev, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDev, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("../input/input_x.bin", inputByteSize, xHost, inputByteSize);
    ReadFile("../input/input_y.bin", inputByteSize, yHost, inputByteSize);
    aclrtMemcpy(xDev, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yDev, inputByteSize, yHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // ---- Step 2: aclrtHostRegisterV2 注册 + 取 dev 端地址 ----
    volatile uint32_t* syncHost = nullptr;
    uint8_t*            syncDev  = nullptr;

    aclrtMallocHost((void**)&syncHost, sizeof(uint32_t));
    *syncHost = 0;
    aclrtHostRegisterV2((void*)syncHost, sizeof(uint32_t), ACL_HOST_REG_MAPPED);
    aclrtHostGetDevicePointer((void*)syncHost, (void**)&syncDev, 0);
    printf("[INFO] syncHost=%p  syncDev=%p\n", (void*)syncHost, (void*)syncDev);

    // ---- Step 3: OP1 输出 bufA ----
    uint8_t *bufHostA = nullptr, *bufDevA = nullptr;
    aclrtMallocHost((void**)&bufHostA, outputByteSize);
    aclrtMalloc((void**)&bufDevA, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    // ---- Step 4: OP1 launch + Host 零拷贝轮询 ----
    printf("[INFO] Launch OP1 ...\n");
    add_custom_with_sync<<<numBlocks, nullptr, stream>>>(
        xDev, yDev, bufDevA, syncDev, totalLength);

    printf("[INFO] Polling syncHost (zero-copy) ...\n");
    while (*syncHost == 0) {}
    uint32_t op2Bytes = *syncHost;
    printf("[INFO] OP1 done, size=%u bytes\n", op2Bytes);

    aclrtSynchronizeStream(stream);
    aclrtMemcpy(bufHostA, outputByteSize, bufDevA, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("../output/output_op1.bin", bufHostA, outputByteSize);

    // ---- 动态分配 OP2 buffer ----
    uint8_t *bufHostB = (uint8_t*)malloc(op2Bytes);
    memset(bufHostB, 0, op2Bytes);

    uint8_t* bufDevB = nullptr;
    aclrtMalloc((void**)&bufDevB, op2Bytes, ACL_MEM_MALLOC_HUGE_FIRST);

    // ---- Step 6: OP2 ----
    printf("[INFO] Launch OP2 ...\n");
    add_custom<<<numBlocks, nullptr, stream>>>(xDev, yDev, bufDevB, totalLength);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(bufHostB, op2Bytes, bufDevB, op2Bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("../output/output_op2.bin", bufHostB, op2Bytes);

    // ---- 清理 ----
    aclrtHostUnregister((void*)syncHost);
    aclrtFreeHost((void*)syncHost);
    aclrtFreeHost((void*)bufHostA);
    free(bufHostB);
    aclrtFree(bufDevA);
    aclrtFree(bufDevB);
    aclrtFree(xDev);
    aclrtFree(yDev);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();

    printf("[INFO] Done.\n");
    return 0;
}
