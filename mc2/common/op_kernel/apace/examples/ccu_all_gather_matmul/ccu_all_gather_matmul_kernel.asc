// ---- 第三阶段：融合 kernel device 侧组件（MatmulTilingData + Blaze 类型链 + MatmulProcess + AicDirectPollProcess）----
// CcuMappedAddrs 必须在 include 头文件之前定义，因为 matmul_fusion_kernel.h 和 host_launcher.h 都引用此类型。
constexpr uint32_t HCOMM_HOST_TASK_ARG_NUM = 10;
constexpr uint32_t MAX_COMMTURN = 16;
struct CcuMappedAddrs {
    // (commTurn+1) 组 Variable（每组 HCOMM_HOST_TASK_ARG_NUM=10 个，AIC 一次性预写所有 round）
    // 组 0 = scale round，组 1..commTurn = data round
    // startVa[d][i] 对应第 d round 第 i 个 Variable 的 GM 后背地址
    uint64_t startVa[MAX_COMMTURN + 1][HCOMM_HOST_TASK_ARG_NUM];
    // commTurn+2 个 Event（1 wake + 1 scale done + commTurn data done）
    // eventVa[0] = wake（AIC→CCU，仅 scale round 前）
    // eventVa[1] = scale AllGather done（CCU→AIC）
    // eventVa[d+2] = data round d done（CCU→AIC），d = 0..commTurn-1
    uint64_t eventVa[MAX_COMMTURN + 2];
};
#include "matmul_fusion_kernel.h"

#ifdef ACLCHECK
#undef ACLCHECK
#endif

#define ACLCHECK(ret)                                                                          \
    do {                                                                                       \
        if (ret != ACL_SUCCESS) {                                                              \
            printf("acl interface return err %s:%d, retcode: %d \n", __FILE__, __LINE__, ret); \
            return ret;                                                                        \
        }                                                                                      \
    } while (0)

#define HCCLCHECK(call)                                                                          \
    do {                                                                                         \
        auto ret = (call);                                                                       \
        int retCode = static_cast<int>(ret);                                                     \
        HcclResult hcclRet = static_cast<HcclResult>(ret);                                       \
        if (retCode >= static_cast<int>(CCU_E_DRV_START) &&                                      \
            retCode <= static_cast<int>(CCU_E_RESERVED)) {                                       \
            hcclRet = HCCL_E_INTERNAL;                                                           \
        }                                                                                        \
        if (hcclRet != HCCL_SUCCESS) {                                                           \
            printf("hccl interface return err %s:%d, retcode: %d \n", __FILE__, __LINE__,        \
                retCode);                                                                        \
            return hcclRet;                                                                      \
        }                                                                                        \
    } while (0)

#define CHK_PTR_NULL(ptr)       \
    do {                        \
        if ((ptr) == nullptr) { \
            return HCCL_E_PTR;  \
        }                       \
    } while (0)

namespace ccu = ::AscendC::ccu;

namespace ops_comm_ag {
#define CCU_CHK_RET(call)                                \
    do {                                                 \
        CcuResult ccuRet = static_cast<CcuResult>(call); \
        if (ccuRet != CCU_SUCCESS) {                     \
            return ccuRet;                               \
        }                                                \
    } while (0)

#define CCU_CHK_VOID_RET(call)                           \
    do {                                                 \
        CcuResult ccuRet = static_cast<CcuResult>(call); \
        if (ccuRet != CCU_SUCCESS) {                     \
            return;                                      \
        }                                                \
    } while (0)

constexpr uint64_t CCU_MS_INTERLEAVE = 8;
constexpr uint64_t CCU_MS_SIZE = 4096;
constexpr uint32_t CCU_LOCAL_COPY_MS_PER_LOOP = 8;
constexpr uint32_t CCU_MS_LOCAL_COPY_LOOP_COUNT = 8;
constexpr uint64_t CCU_MAX_RANK_SIZE = 16;
constexpr uint32_t CHANNEL_NOTIFY_NUM = 3;
constexpr uint8_t DIE_ID = 1;
// 第三阶段：通算并行流水（commTurn round）+ AIC 直轮询
// commTurn 通用设计：CCU 资源按 commTurn 分配，AIC 循环 commTurn 次轮询+matmul。
// 假设 commTurn < 16（MAX_COMMTURN 上限，受 CCU Variable/Event 资源配额约束）。
constexpr uint32_t commTurn = 2;
constexpr uint32_t CCU_DIE_NUM = 2;
constexpr uint32_t CCU_DEFAULT_RES_FRACTION_ADDRESS = 400;
constexpr uint32_t CCU_DEFAULT_RES_FRACTION_LOOP = 16;
constexpr uint32_t CCU_DEFAULT_RES_FRACTION_CCU_BUF = 128;
constexpr uint32_t CCU_DEFAULT_RES_FRACTION_VARIABLE = 400;
constexpr uint32_t CCU_DEFAULT_RES_FRACTION_EVENT = 48;
constexpr uint32_t CCU_DEFAULT_RES_FRACTION_CCU_THREAD = 2;

constexpr uint32_t SIZE_TABLE[HCCL_DATA_TYPE_RESERVED] = {sizeof(int8_t), sizeof(int16_t), sizeof(int32_t),
    2, sizeof(float), sizeof(int64_t), sizeof(uint64_t), sizeof(uint8_t), sizeof(uint16_t), sizeof(uint32_t),
    8, 2, 16, 2, 1, 1, 1, 1};

struct LoopGroupConfig {
    uint32_t msInterleave;
    uint32_t loopCount;
    uint64_t memSlice;
};

struct LoopGroupResource {
    ccu::Array<ccu::Event> completedEvent{0};
    ccu::Array<ccu::CcuBuffer> ccuBuf{0};
    uint32_t eventCount;
    uint32_t bufCount;
};

struct GroupOpSizeVars {
    ccu::Variable addrOffset;
    ccu::Variable loopParam;
    ccu::Variable parallelParam;
    ccu::Variable residual;
};

struct CcuLoopEntity {
    std::unique_ptr<ccu::Func> body[2];
    std::unique_ptr<ccu::Loop> loops[2];
    ccu::Variable loopParam[2];
};

struct CcuKernelArgAllGatherMesh1DMem2Mem {
    ChannelHandle channels[CCU_MAX_RANK_SIZE];
    uint32_t channelCount;
    uint64_t rankSize;
    uint32_t rankId;
    CcuVariableHandle varHandle;
    uint32_t varNum;
    CcuEventHandle eventHandle;
    uint32_t eventNum;
    uint32_t commTurn;  // 第三阶段：CCU kernel 内部循环次数
};

struct AllGatherMesh1DMem2MemContext {
    const CcuKernelArgAllGatherMesh1DMem2Mem *arg;

    ccu::Variable input;
    std::vector<ccu::Variable> output;
    std::vector<ccu::Variable> token;
    ccu::Variable currentRankSliceInputOffset;
    ccu::Variable currentRankSliceOutputOffset;
    ccu::Variable sliceSize;
    ccu::Event event;

    GroupOpSizeVars goSize;
    LoopGroupConfig moConfig;
    LoopGroupResource moRes;
    bool resourceAllocated = false;

    std::map<std::string, CcuLoopEntity> loopMap;

    void CreateLoopEntity(std::string loopStr)
    {
        loopMap.emplace(loopStr, CcuLoopEntity());
    }

    bool IsLoopEntityRegistered(std::string loopStr)
    {
        return loopMap.count(loopStr) != 0;
    }
};

struct CcuDefaultRes {
    HcommCcuResType type;
    uint32_t num;
};

static constexpr CcuDefaultRes CCU_DEFAULT_RES[] = {
    {HCOMM_CCU_RES_TYPE_ADDRESS,    CCU_DEFAULT_RES_FRACTION_ADDRESS},
    {HCOMM_CCU_RES_TYPE_LOOP,       CCU_DEFAULT_RES_FRACTION_LOOP},
    {HCOMM_CCU_RES_TYPE_CCU_BUF,    CCU_DEFAULT_RES_FRACTION_CCU_BUF},
    {HCOMM_CCU_RES_TYPE_VARIABLE,   CCU_DEFAULT_RES_FRACTION_VARIABLE},
    {HCOMM_CCU_RES_TYPE_EVENT,      CCU_DEFAULT_RES_FRACTION_EVENT},
    {HCOMM_CCU_RES_TYPE_CCU_THREAD, CCU_DEFAULT_RES_FRACTION_CCU_THREAD},
};

static HcclResult ConvertCcuToHccl(CcuResult ccuResult)
{
    switch (ccuResult) {
        case CCU_SUCCESS: return HCCL_SUCCESS;
        case CCU_E_PARA: return HCCL_E_PARA;
        case CCU_E_PTR: return HCCL_E_PTR;
        case CCU_E_INTERNAL: return HCCL_E_INTERNAL;
        case CCU_E_NOT_SUPPORT: return HCCL_E_NOT_SUPPORT;
        case CCU_E_NOT_FOUND: return HCCL_E_NOT_FOUND;
        case CCU_E_UNAVAIL: return HCCL_E_UNAVAIL;
        default: return HCCL_E_INTERNAL;
    }
}

static void DestroyAllDescs(std::vector<HcommCcuResDescHandle> &descs)
{
    for (auto &desc : descs) {
        (void)HcommCcuInsResDescDestroy(desc);
    }
}

// ============================================================================
// CreateCcuInsWithEnabledDies — 创建 CCU 实例（跨 DIE 资源池）
//
// 遍历 2 个 DIE（CCU_DIE_NUM=2），为每个可用 DIE 创建资源描述符并设置
// 各类资源配额（地址、loop、buffer、variable、event、thread）。
// 最终调用 HcommCcuInsCreate 创建 CCU 实例，返回 insHandle。
//
// CCU 资源配额（CCU_DEFAULT_RES）：
//   ADDRESS=400, LOOP=16, CCU_BUF=128, VARIABLE=400, EVENT=48, CCU_THREAD=2
// 这些配额需满足 (commTurn+1)*10 个 Variable + (commTurn+2) 个 Event 的需求
// ============================================================================
static HcclResult CreateCcuInsWithEnabledDies(CcuInsHandle &insHandle)
{
    std::vector<HcommCcuResDescHandle> resDescs;
    for (uint32_t dieId = 0; dieId < CCU_DIE_NUM; dieId++) {
        HcommCcuResDescHandle desc = 0;
        CcuResult descCreateRet = HcommCcuInsResDescCreate(dieId, &desc);
        if (descCreateRet != CCU_SUCCESS) {
            (void)HcommCcuInsResDescDestroy(desc);
            DestroyAllDescs(resDescs);
            return ConvertCcuToHccl(descCreateRet);
        }

        CcuResult probeRet = HcommCcuQueryRemainResDesc(desc);
        if (probeRet == CCU_E_UNAVAIL) {
            (void)HcommCcuInsResDescDestroy(desc);
            continue;
        }
        if (probeRet != CCU_SUCCESS) {
            (void)HcommCcuInsResDescDestroy(desc);
            DestroyAllDescs(resDescs);
            return ConvertCcuToHccl(probeRet);
        }

        for (const auto &res : CCU_DEFAULT_RES) {
            CcuResult setRet = HcommCcuInsResDescSetNum(desc, res.type, res.num);
            if (setRet != CCU_SUCCESS) {
                (void)HcommCcuInsResDescDestroy(desc);
                DestroyAllDescs(resDescs);
                return ConvertCcuToHccl(setRet);
            }
        }
        resDescs.push_back(desc);
    }

    if (resDescs.empty()) {
        return HCCL_E_INTERNAL;
    }

    CcuResult createRet = HcommCcuInsCreate(resDescs.data(), static_cast<uint32_t>(resDescs.size()), &insHandle);
    DestroyAllDescs(resDescs);
    return ConvertCcuToHccl(createRet);
}

// ============================================================================
// AcquireCcuChannels — 为每个远端 rank 获取一条 CCU 通信 channel
//
// 遍历所有 rank（跳过本 rank），通过 HcclRankGraphGetLinks 查询本 rank 到
// 每个远端 rank 的物理链路，选择 UBC_CTP 协议的链路，调用 HcclChannelAcquire
// 获取 CCU 通信 channel 句柄。
//
// channel 是点到点的通信通道，每对 (rankId, remoteRank) 一条。
// channelCount = rankSize - 1（排除本 rank 自身）
// ============================================================================
static HcclResult AcquireCcuChannels(HcclComm comm, uint32_t rankId, uint32_t rankSize,
                                     std::vector<ChannelHandle> &kernelChannels)
{
    kernelChannels.resize(rankSize - 1);

    uint32_t channelIndex = 0;
    for (uint32_t remoteRank = 0; remoteRank < rankSize; remoteRank++) {
        if (remoteRank == rankId) {
            continue;
        }

        uint32_t netLayer = 0;
        uint32_t listSize = 0;
        CommLink *linkList = nullptr;
        HCCLCHECK(HcclRankGraphGetLinks(comm, netLayer, rankId, remoteRank, &linkList, &listSize));

        HcclChannelDesc desc;
        HCCLCHECK(HcclChannelDescInit(&desc, 1));
        CommProtocol protocol = CommProtocol::COMM_PROTOCOL_UBC_CTP;
        bool protocolExists = false;
        for (uint32_t idx = 0; idx < listSize; idx++) {
            CommLink link = linkList[idx];
            if (link.linkAttr.linkProtocol == protocol) {
                desc.remoteRank = remoteRank;
                desc.notifyNum = CHANNEL_NOTIFY_NUM;
                desc.channelProtocol = link.linkAttr.linkProtocol;
                desc.localEndpoint.protocol = link.srcEndpointDesc.protocol;
                desc.localEndpoint.commAddr = link.srcEndpointDesc.commAddr;
                desc.localEndpoint.loc = link.srcEndpointDesc.loc;
                desc.remoteEndpoint.protocol = link.dstEndpointDesc.protocol;
                desc.remoteEndpoint.commAddr = link.dstEndpointDesc.commAddr;
                desc.remoteEndpoint.loc = link.dstEndpointDesc.loc;
                protocolExists = true;
                break;
            }
        }
        if (!protocolExists) {
            return HCCL_E_NOT_FOUND;
        }
        HCCLCHECK(HcclChannelAcquire(comm, CommEngine::COMM_ENGINE_CCU, &desc, 1,
            &kernelChannels[channelIndex]));
        channelIndex++;
    }

    return HCCL_SUCCESS;
}

// ============================================================================
// 以下 4 个函数是 CCU loop/offset 参数的位域编码工具
// CCU 硬件通过 64-bit 寄存器传递 loop 参数，不同 bit 段代表不同含义：
//   GetLoopParam      — 编码 loopCtxId(8b) + gsaOffset(32b) + loopIterNum(13b)
//   GetParallelParam  — 编码 repeatNum(7b) + repeatLoopIndex(7b) + totalLoopNum(7b)
//   GetOffsetParam    — 编码 gsaOffset(32b) + msOffset(11b) + ckeOffset(10b)
//   GetParallelParamForHost — 与 GetParallelParam 相同，Host 侧使用
//   SetBits           — 生成低 (end+1) 位全 1 的掩码
//   GetMaxLoopIterNum — 最大 loop 迭代数（12 bit，=4095）
// ============================================================================

static constexpr uint64_t SetBits(uint16_t end)
{
    return ((uint64_t(1) << (end + 1)) - uint64_t(1));
}

static uint64_t GetMaxLoopIterNum()
{
    constexpr uint16_t loopNumBitNum = 12;
    return SetBits(loopNumBitNum);
}

static uint64_t GetParallelParamForHost(uint64_t repeatNum, uint64_t repeatLoopIndex, uint64_t totalLoopNum)
{
    constexpr uint16_t repeatBitNum = 7;
    constexpr uint16_t repeatNumShiftBit = 55;
    constexpr uint16_t repeatLoopBitNum = 7;
    constexpr uint16_t repeatLoopShiftBit = 48;
    constexpr uint16_t totalLoopBitNum = 7;
    constexpr uint16_t totalLoopShiftBit = 41;
    return ((repeatNum & SetBits(repeatBitNum)) << repeatNumShiftBit)
           | ((repeatLoopIndex & SetBits(repeatLoopBitNum)) << repeatLoopShiftBit)
           | ((totalLoopNum & SetBits(totalLoopBitNum)) << totalLoopShiftBit);
}

// ============================================================================
// CalGoSize — 计算本地拷贝的 loop 参数（4 个 goSize 值）
//
// 当 sliceSize 超过单次 LoopGroup 容量时，需要分段拷贝。
// 本函数将 sliceSize 分解为：
//   offset       — 完整 loop 块的起始偏移（loopSize 的整数倍部分）
//   loopIterNum  — 完整 loop 块的迭代次数
//   loopExtendNum — 尾部扩展 loop 参数（剩余不足一个完整 loop 的部分）
//   tailSize     — 尾部剩余字节数
//
// loopSize = loopCount * memSlice（单次 LoopGroup 的容量）
// 例如 config: loopCount=8, memSlice=8*4096=32768 → loopSize=262144
//
// GroupCopy 根据 goSize 中的 addrOffset 判断是否有完整 loop 块，
// 根据 parallelParam 判断是否有尾部扩展 loop
// ============================================================================
static std::vector<uint64_t> CalGoSize(uint64_t size, const LoopGroupConfig &config)
{
    uint64_t loopSize = config.loopCount * config.memSlice;
    uint64_t maxSize = loopSize * (GetMaxLoopIterNum() + 1);

    uint64_t m = size / loopSize;
    uint64_t n = (size - m * loopSize) / config.memSlice;
    uint64_t p = size - m * loopSize - n * config.memSlice;

    if (size == maxSize) {
        m = GetMaxLoopIterNum();
        n = config.loopCount - 1;
        p = config.memSlice;
    }

    uint64_t offset = config.memSlice * config.loopCount * m;
    uint64_t loopIterNum = m;

    uint64_t loopExtendNum = 0;
    uint64_t tailSize = 0;
    constexpr uint64_t loopNumTwo = 2;

    if (n == 0 && p == 0) {
        loopExtendNum = 0;
        tailSize = 0;
    } else if (n != 0 && p == 0) {
        loopExtendNum = GetParallelParamForHost(n - 1, 0, 1);
        tailSize = config.memSlice;
    } else if (n == 0 && p != 0) {
        loopExtendNum = GetParallelParamForHost(0, 0, 1);
        tailSize = p;
    } else {
        loopExtendNum = GetParallelParamForHost(n - 1, 1, loopNumTwo);
        tailSize = p;
    }

    return {offset, loopIterNum, loopExtendNum, tailSize};
}

constexpr int OUTPUT_XN_ID = 1;
constexpr int TOKEN_XN_ID = 2;
constexpr int CKE_IDX_0 = 0;
constexpr int POST_SYNC_ID = 3;

static uint64_t GetLoopParam(uint64_t loopCtxId, uint64_t gsaOffset, uint64_t loopIterNum)
{
    constexpr uint16_t ctxIdBitNum = 8;
    constexpr uint16_t ctxIdShiftBit = 45;
    constexpr uint16_t gsaBitNum = 32;
    constexpr uint16_t gsaShiftBit = 13;
    constexpr uint16_t loopNumBitNum = 13;
    constexpr uint16_t loopNumShiftBit = 0;
    return ((loopCtxId & SetBits(ctxIdBitNum)) << ctxIdShiftBit)
           | ((gsaOffset & SetBits(gsaBitNum)) << gsaShiftBit)
           | ((loopIterNum & SetBits(loopNumBitNum)) << loopNumShiftBit);
}

static uint64_t GetParallelParam(uint64_t repeatNum, uint64_t repeatLoopIndex, uint64_t totalLoopNum)
{
    constexpr uint16_t repeatBitNum = 7;
    constexpr uint16_t repeatNumShiftBit = 55;
    constexpr uint16_t repeatLoopBitNum = 7;
    constexpr uint16_t repeatLoopShiftBit = 48;
    constexpr uint16_t totalLoopBitNum = 7;
    constexpr uint16_t totalLoopShiftBit = 41;
    return ((repeatNum & SetBits(repeatBitNum)) << repeatNumShiftBit)
           | ((repeatLoopIndex & SetBits(repeatLoopBitNum)) << repeatLoopShiftBit)
           | ((totalLoopNum & SetBits(totalLoopBitNum)) << totalLoopShiftBit);
}

static uint64_t GetOffsetParam(uint64_t gsaOffset, uint64_t msOffset, uint64_t ckeOffset)
{
    constexpr uint16_t gsaBitNum = 32;
    constexpr uint16_t gsaShiftBit = 21;
    constexpr uint16_t msBitNum = 11;
    constexpr uint16_t msShiftBit = 10;
    constexpr uint16_t ckeBitNum = 10;
    constexpr uint16_t ckeShiftBit = 0;
    return ((gsaOffset & SetBits(gsaBitNum)) << gsaShiftBit)
           | ((msOffset & SetBits(msBitNum)) << msShiftBit)
           | ((ckeOffset & SetBits(ckeBitNum)) << ckeShiftBit);
}

// ============================================================================
// InitGroupCopyResources — 初始化本地拷贝的 Loop 资源（CCU Buffer + Event + Loop Entity）
//
// 首次调用时分配：
//   - moConfig: loopCount=8, msInterleave=8, memSlice=8*4096=32768
//   - moRes.completedEvent: 8 个 Event（每 loop 一个完成事件）
//   - moRes.ccuBuf: 8*8=64 个 CcuBuffer（双缓冲 + 交错）
//
// 每次调用都重新创建 Loop Entity：
//   为什么？因为 loopSrc/loopDst/loopLen 捕获的是当前 round 的地址值，
//   如果只创建一次，round 1 会复用 round 0 的地址快照 → 本地拷贝写到错误位置 → tile1 数据全 0。
//   所以每次调用都 erase 旧 entity 并重新创建，确保 lambda 捕获最新地址。
// ============================================================================
static void InitGroupCopyResources(AllGatherMesh1DMem2MemContext &ctx, ccu::LocalAddr *loopSrc,
                                    ccu::LocalAddr *loopDst, ccu::Variable *loopLen)
{
    if (!ctx.resourceAllocated) {
        ctx.moConfig.msInterleave = CCU_MS_INTERLEAVE;
        ctx.moConfig.loopCount = CCU_MS_LOCAL_COPY_LOOP_COUNT;
        ctx.moConfig.memSlice = CCU_LOCAL_COPY_MS_PER_LOOP * CCU_MS_SIZE;

        ctx.moRes.eventCount = ctx.moConfig.loopCount;
        ctx.moRes.completedEvent = ccu::Array<ccu::Event>(ctx.moRes.eventCount);

        ctx.moRes.bufCount = ctx.moConfig.loopCount * ctx.moConfig.msInterleave;
        ctx.moRes.ccuBuf = ccu::Array<ccu::CcuBuffer>(ctx.moRes.bufCount);

        ctx.resourceAllocated = true;
    }

    // 每次调用都重新创建 Loop Entity（按值捕获 loopSrc/loopDst/loopLen 的当前值）。
    // 若只创建一次，round 1 会复用 round 0 的地址快照 → 本地拷贝写到错误位置 → tile1 数据全 0。
    {
        std::string loopType = "localcopy";
        if (ctx.IsLoopEntityRegistered(loopType)) {
            ctx.loopMap.erase(loopType);
        }
        ctx.CreateLoopEntity(loopType);
        auto &entity = ctx.loopMap[loopType];
        for (uint32_t index = 0; index < 2; index++) {
            uint32_t bufBase = index * ctx.moConfig.msInterleave;
            ccu::Event loopEvt = ctx.moRes.completedEvent[index];
            entity.body[index].reset(new ccu::Func(
                [&ctx, index, bufBase, loopEvt, loopSrc, loopDst, loopLen]() {
                    ccu::LocalCopy(ctx.moRes.ccuBuf[bufBase], loopSrc[index], loopLen[index], loopEvt, 1);
                    ccu::EventWait(loopEvt, 1);
                    ccu::LocalCopy(loopDst[index], ctx.moRes.ccuBuf[bufBase], loopLen[index], loopEvt, 1);
                    ccu::EventWait(loopEvt, 1);
                }));
            entity.loops[index].reset(
                new ccu::Loop(entity.loopParam[index], *entity.body[index]));
        }
    }
}

// ============================================================================
// GroupCopy — CCU 本地数据拷贝（GM → CCU Buffer → GM，通过 LoopGroup 并行执行）
//
// 将 src 地址的数据拷贝到 dst 地址，通过 CCU Buffer 中转（两跳 LocalCopy）：
//   第一跳: src(GM) → ccuBuf(CCU Buffer)
//   第二跳: ccuBuf(CCU Buffer) → dst(GM)
//
// 根据 goSize 参数分两种情况：
//   1) goSize.addrOffset != 0: 有完整 loop 块
//      → 创建 LoopGroup，loopCount 个 Loop 并行执行，每次拷贝 memSlice 字节
//   2) goSize.parallelParam != 0: 有尾部扩展（不足一个完整 loop）
//      → 额外创建 2 个 Loop 处理尾部数据（residual + memSlice）
//
// LoopGroup 是 CCU 的并行 loop 调度原语，通过 offsetCfg 控制 buffer 交错，
// 通过 paraCfg 控制 loop 迭代次数和并行度
// ============================================================================
static CcuResult GroupCopy(AllGatherMesh1DMem2MemContext &ctx, ccu::LocalAddr dst, ccu::LocalAddr src,
                            GroupOpSizeVars goSize)
{
    ccu::LocalAddr loopSrc[2];
    ccu::LocalAddr loopDst[2];
    ccu::Variable loopLen[2];

    InitGroupCopyResources(ctx, loopSrc, loopDst, loopLen);

    auto &loops = ctx.loopMap["localcopy"];

    CCU_IF(goSize.addrOffset != 0)
    {
        ccu::Variable loopParam;
        loopParam = GetLoopParam(0, ctx.moConfig.memSlice * ctx.moConfig.loopCount, 0);
        loopParam += goSize.loopParam;

        ccu::Variable sliceSize;
        sliceSize = ctx.moConfig.memSlice;

        loopSrc[0].addr = src.addr;
        loopSrc[0].token = src.token;
        loopDst[0].addr = dst.addr;
        loopDst[0].token = dst.token;
        loopLen[0] = sliceSize;

        loops.loopParam[0] = loopParam;
        ccu::Variable paraCfg;
        paraCfg = GetParallelParam(ctx.moConfig.loopCount - 1, 0, 1);

        ccu::Variable offsetCfg;
        offsetCfg = GetOffsetParam(ctx.moConfig.memSlice, ctx.moConfig.msInterleave, 1);
        std::vector<ccu::Loop> grpLoops{ *loops.loops[0] };
        ccu::LoopGroup group(paraCfg, offsetCfg, ctx.moConfig.loopCount, grpLoops);
    }

    CCU_IF(goSize.parallelParam != 0)
    {
        src.addr += goSize.addrOffset;
        dst.addr += goSize.addrOffset;

        loopSrc[0].addr = src.addr;
        loopSrc[0].token = src.token;
        loopDst[0].addr = dst.addr;
        loopDst[0].token = dst.token;
        loopLen[0] = goSize.residual;

        src.addr += goSize.residual;
        dst.addr += goSize.residual;

        ccu::Variable sliceSize;
        sliceSize = ctx.moConfig.memSlice;

        loopSrc[1].addr = src.addr;
        loopSrc[1].token = src.token;
        loopDst[1].addr = dst.addr;
        loopDst[1].token = dst.token;
        loopLen[1] = sliceSize;

        ccu::Variable loopCfg0;
        loopCfg0 = GetLoopParam(0, 0, 1);
        ccu::Variable loopCfg1;
        loopCfg1 = GetLoopParam(0, 0, 1);
        ccu::Variable offsetCfg;
        offsetCfg = GetOffsetParam(ctx.moConfig.memSlice, ctx.moConfig.msInterleave, 1);

        loops.loopParam[0] = loopCfg0;
        loops.loopParam[1] = loopCfg1;
        std::vector<ccu::Loop> grpLoops{ *loops.loops[0], *loops.loops[1] };
        ccu::LoopGroup group(goSize.parallelParam, offsetCfg, ctx.moConfig.loopCount, grpLoops);
    }

    return CCU_SUCCESS;
}

// ============================================================================
// ExecuteAllGatherTransfer — 执行单 round 的 AllGather 传输（CCU 核内）
//
// AllGather 语义：每个 rank 将自己的数据 slice 发送到其他所有 rank，
//                同时接收其他 rank 的数据 slice，汇聚到 recvBuf 中。
//
// 本函数执行步骤（每个 round 调用一次）：
//   1. 计算源地址 src = input + inputOffset（本 rank 当前 round 的数据 slice 起始）
//   2. 为每个 rank 计算目标地址（本 rank → localDst，其他 rank → dst[rankIdx]）
//   3. 对每个远端 rank 执行 ccu::Write（跨卡数据传输）
//   4. 对本 rank 执行 GroupCopy（本地数据拷贝：GM → CCU Buffer → GM，经 loop 展开）
//   5. EventRecord + EventWait 等待所有 rank 完成（含本地和远端）
//
// ccu::Write：CCU 跨卡写原语，通过 channel 将 src 数据写到远端 rank 的 dst 地址
// GroupCopy：CCU 本地拷贝，通过 LoopGroup 并行执行多个 LocalCopy（GM↔CCU Buffer 中转）
// EventRecord/EventWait：CCU event 同步，确保所有 rank 的数据传输完成后才返回
// ============================================================================
static CcuResult ExecuteAllGatherTransfer(AllGatherMesh1DMem2MemContext &ctx)
{
    // ---- 准备地址 ----
    // src: 本 rank 当前 round 的发送源地址 = input Variable + inputOffset
    //      input Variable 由 AIC block 0 预写到参数桥（sendBuf 或 sendScaleBuf 地址）
    //      inputOffset = 当前 round 的数据 slice 在 sendBuf 中的偏移
    ccu::LocalAddr src;
    ccu::LocalAddr localDst;
    std::vector<ccu::RemoteAddr> dst;

    dst.resize(ctx.arg->rankSize);

    src.addr = ctx.input;
    src.addr += ctx.currentRankSliceInputOffset;
    // token: CCU 内存访问令牌，用于权限校验（HcommCcuGetMemToken 获取）
    src.token = ctx.token[ctx.arg->rankId];

    // 为每个 rank 计算目标地址
    // 本 rank → localDst（LocalAddr，本地 GM 地址）
    // 其他 rank → dst[rankIdx]（RemoteAddr，远端 GM 地址）
    for (uint32_t rankIdx = 0; rankIdx < ctx.arg->rankSize; rankIdx++) {
        if (rankIdx == ctx.arg->rankId) {
            localDst.addr = ctx.output[rankIdx];
            localDst.addr += ctx.currentRankSliceOutputOffset;
            localDst.token = ctx.token[rankIdx];
        } else {
            dst[rankIdx].addr = ctx.output[rankIdx];
            dst[rankIdx].addr += ctx.currentRankSliceOutputOffset;
            dst[rankIdx].token = ctx.token[rankIdx];
        }
    }

    // ---- 远端传输：对每个远端 rank 执行 ccu::Write ----
    // ccu::Write 通过 channel 将 src 数据（sliceSize 字节）写到远端 rank 的 dst 地址
    // mask = 1 << rankIdx 指定目标 rank 的 bit 位
    // channel 是点到点通信通道（rankId → remoteRank），channelId 按非本 rank 的顺序编号
    CCU_IF(ctx.sliceSize != 0)
    {
        uint32_t channelId = 0;
        for (uint64_t rankIdx = 0; rankIdx < ctx.arg->rankSize; rankIdx++) {
            const uint16_t mask = 1 << rankIdx;
            if (rankIdx != ctx.arg->rankId) {
                CCU_CHK_RET(ccu::Write(ctx.arg->channels[channelId], dst[rankIdx], src,
                    ctx.sliceSize, ctx.event, mask));
                channelId++;
            }
        }
    }

    // ---- 本地拷贝：将本 rank 的数据 slice 从 sendBuf 搬到 recvBuf 的对应位置 ----
    // GroupCopy 内部通过 LoopGroup 并行执行多个 LocalCopy（GM → CCU Buffer → GM）
    // goSize 包含 loop 参数（offset, loopIterNum, parallelParam, residual）
    //   用于处理 sliceSize 超过单次 loop 容量时的分段拷贝
    CCU_CHK_RET(GroupCopy(ctx, localDst, src, ctx.goSize));

    // ---- 同步：等待所有 rank 的传输完成 ----
    // EventRecord: 记录本 rank 的完成事件（mask = 1 << rankId）
    // EventWait: 等待所有 rank 的完成事件（mask = (1 << rankSize) - 1）
    // 这确保当前 round 的所有跨卡 Write 和本地 GroupCopy 都完成后才返回
    CCU_CHK_RET(ccu::EventRecord(ctx.event, 1 << ctx.arg->rankId));

    const uint16_t totalMask = (1 << ctx.arg->rankSize) - 1;
    CCU_CHK_RET(ccu::EventWait(ctx.event, totalMask));

    return CcuResult::CCU_SUCCESS;
}

// ============================================================================
// CcuAllGatherMesh1DMem2MemKernel — CCU 通信 kernel 主入口（__ccu_host__）
//
// 这是通过 <<<>>> 直接调用的 CCU kernel，运行在 streamCcu 上。
// 负责：(commTurn+1) 轮 AllGather 通信（1 轮 scale + commTurn 轮 data）
//
// 执行流程：
//   1. 从 kernelArg 解析通信参数（rankSize, rankId, channels, vars, events）
//   2. 为每个远端 rank 获取 output/token Variable（通过 channel 资源）
//   3. 循环 totalRounds = commTurn + 1 次：
//      a. round 0（scale）前：EventWait(events[0]) 等 AIC 唤醒
//      b. 读该 round 对应的 Variable 组（偏移 d*10）获取通信参数
//      c. WriteVariableWithNotify + NotifyWait：跨 channel 同步 output/token Variable
//      d. ExecuteAllGatherTransfer：执行实际 AllGather 传输
//      e. NotifyRecord + NotifyWait：post-sync 同步
//      f. EventRecord(events[d+1])：通知 AIC round d 完成
//
// CCU 与 AIC 的同步协议：
//   - AIC block 0 预写所有 round 的参数桥后，写 eventVa[0]=1（wake）
//   - CCU round 0 阻塞等 wake（EventWait(events[0])）
//   - CCU 每 round 完成后 EventRecord(events[d+1]) 通知 AIC
//   - CCU round 0→1→2... 串行自动进入，无需再次 wake
// ============================================================================
__ccu_host__ void CcuAllGatherMesh1DMem2MemKernel(CcuKernelArg arg)
{
    auto *kernelArg = static_cast<CcuKernelArgAllGatherMesh1DMem2Mem *>(arg);

    AllGatherMesh1DMem2MemContext ctx;
    ctx.arg = kernelArg;

    if (ctx.arg->channelCount == 0) {
        return;
    }

    ctx.output.resize(ctx.arg->rankSize);
    ctx.token.resize(ctx.arg->rankSize);

    uint32_t channelIdx = 0;
    for (uint64_t peerId = 0; peerId < ctx.arg->rankSize; peerId++) {
        if (peerId != ctx.arg->rankId) {
            ctx.output[peerId] = ccu::GetResByChannel<ccu::Variable>(ctx.arg->channels[channelIdx], OUTPUT_XN_ID);
            ctx.token[peerId] = ccu::GetResByChannel<ccu::Variable>(ctx.arg->channels[channelIdx], TOKEN_XN_ID);
            channelIdx++;
        }
    }

    // 从 kernelArg 获取 Variable 和 Event 资源数组
    // vars: (commTurn+1)*10 个 Variable，按 round 分组
    // events: commTurn+2 个 Event（[0]=wake, [1]=scale done, [2..]=data round done）
    ccu::Array<ccu::Event> events(ctx.arg->eventHandle, ctx.arg->eventNum);
    ccu::Array<ccu::Variable> vars(ctx.arg->varHandle, ctx.arg->varNum);

    // ========================================================================
    // 第四阶段：CCU kernel 内部两阶段循环
    //
    // 阶段 4.1: Scale AllGather（1 轮，全量 M 行 scale）— round d=0
    // 阶段 4.2: Data AllGather（commTurn 轮，每轮 tileM 行 FP8 data）— round d=1..commTurn
    //
    // 同步协议：
    //   - 仅 round 0 前 EventWait(events[0])（等 AIC 唤醒）
    //   - 之后串行自动进入下一 round（无需再唤醒）
    //   - 每 round 读该 round 对应的 Variable 组（偏移 d*HCOMM_HOST_TASK_ARG_NUM）
    //   - 每 round 完成 EventRecord(events[d+1])（通知 AIC round done）
    //   - 总 round 数 = commTurn + 1（1 scale + commTurn data）
    // ========================================================================
    if (ctx.arg->commTurn == 0) {
        return;  // commTurn=0 无需通信，直接返回
    }
    uint32_t totalRounds = ctx.arg->commTurn + 1;  // 1 scale round + commTurn data rounds
    for (uint32_t d = 0; d < totalRounds; d++) {
        // round 0（scale round）前等待 AIC 唤醒
        // AIC block 0 写完所有 round 的参数桥后，写 eventVa[0]=1 触发此 EventWait 返回
        if (d == 0) {
            ccu::EventWait(events[0]);  // 仅 scale round 前 等 AIC 唤醒
        }

        // ---- 读该 round 对应的 Variable 组（10 个参数）----
        // 偏移 base = d * HCOMM_HOST_TASK_ARG_NUM（每组 10 个 Variable）
        // 槽位映射：
        //   [0]=input(sendBuf/sendScaleBuf), [1]=output(recvBuf/recvScaleBuf),
        //   [2]=token, [3]=inputOffset, [4]=outputOffset,
        //   [5]=sliceSize, [6]=goSize.addrOffset, [7]=goSize.loopParam,
        //   [8]=goSize.parallelParam, [9]=goSize.residual
        uint32_t base = d * HCOMM_HOST_TASK_ARG_NUM;
        ctx.input = vars[base + 0];
        ctx.output[ctx.arg->rankId] = vars[base + 1];
        ctx.token[ctx.arg->rankId] = vars[base + 2];
        ctx.currentRankSliceInputOffset = vars[base + 3];
        ctx.currentRankSliceOutputOffset = vars[base + 4];
        ctx.sliceSize = vars[base + 5];
        ctx.goSize.addrOffset = vars[base + 6];
        ctx.goSize.loopParam = vars[base + 7];
        ctx.goSize.parallelParam = vars[base + 8];
        ctx.goSize.residual = vars[base + 9];

        // ---- WriteVariableWithNotify + NotifyWait：跨 channel 同步 output/token Variable ----
        // 将本 rank 的 output/token Variable 值通过 channel 通知到远端 rank，
        // 然后等待远端 rank 的 output/token Variable 到达（NotifyWait 阻塞直到所有 mask 位到达）
        // 这确保所有 rank 都能看到彼此的 output/token 地址，才能执行后续 Write
        for (uint32_t i = 0; i < ctx.arg->channelCount; i++) {
            CCU_CHK_VOID_RET(ccu::WriteVariableWithNotify(ctx.arg->channels[i], ctx.output[ctx.arg->rankId],
                OUTPUT_XN_ID, CKE_IDX_0, 1 << OUTPUT_XN_ID));
            CCU_CHK_VOID_RET(ccu::WriteVariableWithNotify(ctx.arg->channels[i], ctx.token[ctx.arg->rankId],
                TOKEN_XN_ID, CKE_IDX_0, 1 << TOKEN_XN_ID));
        }

        uint32_t allBit = (1 << OUTPUT_XN_ID) | (1 << TOKEN_XN_ID);
        for (uint32_t i = 0; i < ctx.arg->channelCount; i++) {
            CCU_CHK_VOID_RET(ccu::NotifyWait(ctx.arg->channels[i], CKE_IDX_0, allBit));
        }

        // ---- 执行实际 AllGather 传输 ----
        // 跨卡 Write + 本地 GroupCopy + EventRecord/EventWait 同步
        CCU_CHK_VOID_RET(ExecuteAllGatherTransfer(ctx));

        // ---- Post-sync：NotifyRecord + NotifyWait ----
        // 确保所有 channel 上的传输操作完全完成后才进入下一 round
        for (uint32_t i = 0; i < ctx.arg->channelCount; i++) {
            CCU_CHK_VOID_RET(ccu::NotifyRecord(ctx.arg->channels[i], CKE_IDX_0, 1 << POST_SYNC_ID));
        }
        for (uint32_t i = 0; i < ctx.arg->channelCount; i++) {
            CCU_CHK_VOID_RET(ccu::NotifyWait(ctx.arg->channels[i], CKE_IDX_0, 1 << POST_SYNC_ID));
        }

        // ---- 通知 AIC round d 完成 ----
        // d=0 → EventRecord(events[1]) = scale done（AIC 轮询 eventVa[1]）
        // d=1 → EventRecord(events[2]) = data round 0 done（AIC 轮询 eventVa[2]）
        // d=d → EventRecord(events[d+1]) = round (d-1) data done (for d>=1) / scale done (for d=0)
        ccu::EventRecord(events[d + 1]);
    }
}

} // namespace ops_comm_ag

using namespace ops_comm_ag;

// ============================================================================
// 第四阶段：AllGather + MXFP8 Matmul 通算并行融合 kernel（纯 AIC）
// CCU 两阶段通信（streamCcu：1 轮 scale AG + commTurn 轮 data AG）
// + AIC 直轮询（streamAivAic：轮询 scale done + 循环 commTurn 轮 data done + MXFP8 matmul）
// GemmUniversal（kernel_qbmm_mx.h）的 Run 内置 if ASCEND_IS_AIV { return; }，天然纯 AIC
// ============================================================================
// ============================================================================
// all_gather_matmul_kernel — 融合 kernel 入口（纯 AIC，通过 <<<>>> 直接调用）
//
// 运行在 streamAivAic 上，与运行在 streamCcu 上的 CcuAllGatherMesh1DMem2MemKernel
// 双流并行执行，实现通算 overlap。
//
// 本 kernel 不做通信（通信由 CCU kernel 负责），只做：
//   1. AIC block 0 预写 (commTurn+1) 组参数桥到 Variable 区 + 写 wake event
//   2. 所有 AIC 核轮询 scale AllGather done → 循环 commTurn 次：轮询 data done + matmul
//
// 关键：GemmUniversal（kernel_qbmm_mx.h）的 Run 内置 if ASCEND_IS_AIV { return; }，
//       所以本 kernel 天然只跑在 AIC 核上，无需 KERNEL_TYPE_MIX_AIC_1_1 混合核声明。
//       所有 AIC 核都会执行 AicDirectPollProcess，但 block 0 额外做参数桥预写。
// ============================================================================
__global__ __aicore__ void all_gather_matmul_kernel(__gm__ void *sendBuf, __gm__ void *recvBuf,
                                                        __gm__ void *sendScaleBuf, __gm__ void *recvScaleBuf,
                                                        __gm__ void *weightBuf, __gm__ void *weightScaleBuf,
                                                        __gm__ void *outputBuf,
                                                        CcuMappedAddrs mappedAddrs,
                                                        uint64_t token, uint64_t scaleToken,
                                                        uint64_t dataSliceSize, uint64_t scaleSliceSize,
                                                        uint64_t goSize0, uint64_t goSize1, uint64_t goSize2,
                                                        uint64_t goSize3,
                                                        uint64_t scaleGoSize0, uint64_t scaleGoSize1,
                                                        uint64_t scaleGoSize2, uint64_t scaleGoSize3,
                                                        MatmulTilingData tilingData, uint32_t rankSize,
                                                        uint32_t tileM, uint32_t commTurn,
                                                        __gm__ const uint64_t *inputOffsets,
                                                        __gm__ const uint64_t *outputOffsets,
                                                        __gm__ const uint64_t *scaleInputOffsets,
                                                        __gm__ const uint64_t *scaleOutputOffsets)
{
    // 第四阶段：去掉 KERNEL_TYPE_MIX_AIC_1_1
    // GemmUniversal（kernel_qbmm_mx.h）的 Run 内置 if ASCEND_IS_AIV { return; }，天然纯 AIC
    AscendC::InitSocState();

    AicDirectPollProcess(sendBuf, recvBuf, sendScaleBuf, recvScaleBuf,
                         weightBuf, weightScaleBuf, outputBuf, mappedAddrs,
                         token, scaleToken, dataSliceSize, scaleSliceSize,
                         goSize0, goSize1, goSize2, goSize3,
                         scaleGoSize0, scaleGoSize1, scaleGoSize2, scaleGoSize3,
                         tilingData, rankSize, tileM, commTurn,
                         inputOffsets, outputOffsets,
                         scaleInputOffsets, scaleOutputOffsets);
}

// ============================================================================
// Host 侧编排 + <<<>>> kernel launch（AllGatherMatmulCustom）
// 编排逻辑在 host_launcher.h 的 PrepareAllGatherMatmul，<<<>>> launch 留在此文件
// ============================================================================
#include "host_launcher.h"

// ============================================================================
// AllGatherMatmulCustom — Host 侧编排 + 双流 kernel launch 入口
//
// 编排流程：
//   1. 调用 PrepareAllGatherMatmul：分配 CCU 资源（Variable/Event/Channel），
//      计算 goSize/offsets/token，拷贝 offsets 到 device GM，填充 ctx
//   2. CCU kernel launch（streamCcu）：CcuAllGatherMesh1DMem2MemKernel<<<>>>
//      — CCU kernel 内部循环 commTurn+1 次（1 scale AG + commTurn data AG）
//   3. 融合 kernel launch（streamAivAic）：all_gather_matmul_kernel<<<>>>
//      — AIC 直轮询 + MXFP8 matmul，与 CCU 通信并行 overlap
//
// 双流时序：
//   streamCcu:    [wake]→ ScaleAG → DataAG₀ → DataAG₁ → ...
//   streamAivAic: [writeWake]→ waitScale → Mmul₀ → Mmul₁ → ...
//   注：streamAivAic 流名沿用历史命名，第四阶段已去掉 MIX_AIC_1_1，
//       融合 kernel 纯 AIC 执行，此流上无 AIV 核工作。
//   两个 stream 独立调度，通过 Event 在 GM 上的共享地址同步
//
// 参数说明：
//   sendBuf/recvBuf       — FP8 data 的发送/接收 buffer
//   sendScaleBuf/recvScaleBuf — E8M0 scaleA 的发送/接收 buffer
//   weightBuf/weightScaleBuf  — FP8 B / E8M0 scaleB（本 rank 权重，不通信）
//   outputBuf             — BF16 C 输出 buffer
//   sendCount/scaleCount  — data/scale 的元素数（每 rank）
//   tilingData            — MXFP8 matmul tiling 参数
//   tileM/K               — 切分参数
//   ctx                   — 编排结果（资源句柄、地址、token 等）
// ============================================================================
HcclResult AllGatherMatmulCustom(void *sendBuf, void *recvBuf,
                                      void *sendScaleBuf, void *recvScaleBuf,
                                      void *weightBuf, void *weightScaleBuf, void *outputBuf,
                                      uint64_t sendCount, uint64_t scaleCount,
                                      HcclDataType dataType, HcclComm comm,
                                      aclrtStream streamAivAic, aclrtStream streamCcu, MatmulTilingData tilingData,
                                      uint32_t tileM, uint32_t K, AllGatherMatmulContext &ctx)
{
    CHK_PTR_NULL(streamAivAic);
    CHK_PTR_NULL(streamCcu);
    CHK_PTR_NULL(weightBuf);
    CHK_PTR_NULL(outputBuf);

    HcclResult ret = PrepareAllGatherMatmul(sendBuf, recvBuf, sendScaleBuf, recvScaleBuf,
                                             sendCount, scaleCount, dataType, comm, tileM, K, ctx);
    if (ret != HCCL_SUCCESS) {
        return ret;
    }

    // ============ CCU 通信 kernel launch（streamCcu，仅 1 次，kernel 内部循环 commTurn+1 次）============
    CcuAllGatherMesh1DMem2MemKernel<<<ctx.schd, ctx.insHandle, streamCcu>>>(
        ctx.kernelArg.get());

    // ============ 融合 kernel launch（纯 AIC，streamAivAic）============
    // AIC 直轮询：block 0 预写 (commTurn+1) 组参数桥 + 写 wake(eventVa[0]=1)
    // → 所有核轮询 eventVa[1]==1（scale done）→ 循环 commTurn 次：轮询 eventVa[d+2]==1 → MXFP8 matmul tile d
    // round d 的 matmul 与 CCU round d+1 通信并行 overlap
    all_gather_matmul_kernel<<<tilingData.usedCoreNum, 0, streamAivAic>>>(
        sendBuf, recvBuf, sendScaleBuf, recvScaleBuf, weightBuf, weightScaleBuf, outputBuf, ctx.mappedAddrs,
        ctx.token, ctx.scaleToken, ctx.dataSliceSize, ctx.scaleSliceSize,
        ctx.goSize[0], ctx.goSize[1], ctx.goSize[2], ctx.goSize[3],
        ctx.scaleGoSize[0], ctx.scaleGoSize[1], ctx.scaleGoSize[2], ctx.scaleGoSize[3],
        tilingData, ctx.rankSize, tileM, ctx.commTurn,
        reinterpret_cast<__gm__ const uint64_t *>(ctx.d_inputOffsetsAddr),
        reinterpret_cast<__gm__ const uint64_t *>(ctx.d_outputOffsetsAddr),
        reinterpret_cast<__gm__ const uint64_t *>(ctx.d_scaleInputOffsetsAddr),
        reinterpret_cast<__gm__ const uint64_t *>(ctx.d_scaleOutputOffsetsAddr));

    return HCCL_SUCCESS;
}

#include "sample_main.cpp"
