#ifdef ACLCHECK
#undef ACLCHECK
#endif

#define ACLCHECK(ret)                                                                          \
    do {                                                                                       \
        if (ret != ACL_SUCCESS) {                                                              \
            printf("acl interface return err %s:%d, retcode: %d \n", __FILE__, __LINE__, ret); \
            return ret;                                                                        \
        }                                                                                      \
    } while (0)

#define HCCLCHECK(call)                                                                          \
    do {                                                                                         \
        auto ret = (call);                                                                       \
        int retCode = static_cast<int>(ret);                                                     \
        HcclResult hcclRet = static_cast<HcclResult>(ret);                                       \
        if (retCode >= static_cast<int>(CCU_E_DRV_START) &&                                      \
            retCode <= static_cast<int>(CCU_E_RESERVED)) {                                       \
            hcclRet = HCCL_E_INTERNAL;                                                           \
        }                                                                                        \
        if (hcclRet != HCCL_SUCCESS) {                                                           \
            printf("hccl interface return err %s:%d, retcode: %d \n", __FILE__, __LINE__,        \
                retCode);                                                                        \
            return hcclRet;                                                                      \
        }                                                                                        \
    } while (0)

#define CHK_PTR_NULL(ptr)       \
    do {                        \
        if ((ptr) == nullptr) { \
            return HCCL_E_PTR;  \
        }                       \
    } while (0)

namespace ccu = ::AscendC::ccu;

namespace ops_comm_a2a {
#define CCU_CHK_RET(call)                                \
    do {                                                 \
        CcuResult ccuRet = static_cast<CcuResult>(call); \
        if (ccuRet != CCU_SUCCESS) {                     \
            return ccuRet;                               \
        }                                                \
    } while (0)

#define CCU_CHK_VOID_RET(call)                           \
    do {                                                 \
        CcuResult ccuRet = static_cast<CcuResult>(call); \
        if (ccuRet != CCU_SUCCESS) {                     \
            return;                                      \
        }                                                \
    } while (0)

// 本地拷贝 LoopGroup 机器参数（三者值恰都为 8 但语义不同，勿混淆）：
//   msInterleave=8（buffer 交错数），loopCount=8（LoopGroup 并行 loop 数），
//   memSlice = CCU_MEMSLICES_PER_LOOP * CCU_MS_SIZE = 8*4KB = 32KB（单 loop 搬运量）
constexpr uint64_t CCU_MS_INTERLEAVE = 8;          // 每 loop 的 CCU buffer 交错数
constexpr uint64_t CCU_MS_SIZE = 4096;             // 单个 memSlice 字节数（4KB）
constexpr uint32_t CCU_MEMSLICES_PER_LOOP = 8;    // 每 loop 搬运的 memSlice 数
constexpr uint32_t CCU_LOCAL_COPY_LOOP_COUNT = 8; // LoopGroup 并行 loop 数
constexpr uint64_t CCU_MAX_RANK_SIZE = 16;
constexpr uint32_t CHANNEL_NOTIFY_NUM = 3;
// DIE_ID 已动态化：由 AcquireCcuChannels 查询端点 ENDPOINT_ATTR_DIE_ID 获得（见下方实现），
// 不再硬编码
// 阶段1：AIC 桥 kernel 固定 8 核 launch（Blaze-free，无 platform 查询；
// 阶段3 叠加 matmul 时恢复 PlatformAscendCManager::GetCoreNumAic 查询）
constexpr uint32_t AIC_BLOCK_NUM = 8;
constexpr uint32_t CCU_DIE_NUM = 2;
constexpr uint32_t CCU_DEFAULT_RES_FRACTION_ADDRESS = 400;
constexpr uint32_t CCU_DEFAULT_RES_FRACTION_LOOP = 16;
constexpr uint32_t CCU_DEFAULT_RES_FRACTION_CCU_BUF = 128;
constexpr uint32_t CCU_DEFAULT_RES_FRACTION_VARIABLE = 400;
constexpr uint32_t CCU_DEFAULT_RES_FRACTION_EVENT = 48;
constexpr uint32_t CCU_DEFAULT_RES_FRACTION_CCU_THREAD = 2;

constexpr uint32_t SIZE_TABLE[HCCL_DATA_TYPE_RESERVED] = {sizeof(int8_t), sizeof(int16_t), sizeof(int32_t),
    2, sizeof(float), sizeof(int64_t), sizeof(uint64_t), sizeof(uint8_t), sizeof(uint16_t), sizeof(uint32_t),
    8, 2, 16, 2, 1, 1, 1, 1};

struct LoopGroupConfig {
    uint32_t msInterleave;
    uint32_t loopCount;
    uint64_t memSlice;
};

struct LoopGroupResource {
    ccu::Array<ccu::Event> completedEvent{0};
    ccu::Array<ccu::CcuBuffer> ccuBuf{0};
    uint32_t eventCount;
    uint32_t bufCount;
};

// CCU 本地拷贝 loop 参数四元组（Variable 版）——字段名与 host 侧 A2aGoSize 保持一致
struct GroupOpSizeVars {
    ccu::Variable addrOffset;
    ccu::Variable loopIterNum;
    ccu::Variable loopExtendNum;
    ccu::Variable tailSize;
};

struct CcuLoopEntity {
    std::unique_ptr<ccu::Func> body[2];
    std::unique_ptr<ccu::Loop> loops[2];
    ccu::Variable loopParam[2];
};

// ============================================================================
// CcuKernelArgAllToAllMesh1D — CCU kernel 参数块（对齐 CANN CcuKernelArgAlltoAllMesh1D）
//
// CANN 原版成员 dimSize_/rankId_ → 本结构 rankSize/rankId；
// CANN 原版 TaskArg 四元组 {sliceSize, srcOffset, dstOffset, srcStride} 经参数桥
// 逐 round 传入（本结构 varHandle/varNum 指向的 Variable 区），语义一致：
//   src.addr   = input + srcOffset + j * srcStride   （发给 rank j 的块）
//   dst[j].addr = output[j] + dstOffset              （dstOffset 已含 myRank*blockSize 项）
// ============================================================================
struct CcuKernelArgAllToAllMesh1D {
    ChannelHandle channels[CCU_MAX_RANK_SIZE];
    uint32_t channelCount;
    uint64_t rankSize;
    uint32_t rankId;
    CcuVariableHandle varHandle;
    uint32_t varNum;
    CcuEventHandle eventHandle;
    uint32_t eventNum;
    uint32_t commTurn;  // CCU kernel 内部循环次数（= round 数）
};

struct AllToAllMesh1DContext {
    const CcuKernelArgAllToAllMesh1D *arg;

    ccu::Variable input;
    std::vector<ccu::Variable> output;
    std::vector<ccu::Variable> token;
    // ---- AllToAll 参数（对齐 CANN CcuTaskArgAllToAllMesh1D 四元组）----
    ccu::Variable srcOffset;   // round 级公共源偏移 = r*sub
    ccu::Variable dstOffset;   // round 级公共目的偏移 = myRank*blockSize + r*sub（host 预乘烧入）
    ccu::Variable sliceSize;   // 本轮块字节数 = sub
    ccu::Variable srcStride;   // 块间距字节数 = blockSize
    ccu::Event event;

    GroupOpSizeVars goSize;
    LoopGroupConfig moConfig;
    LoopGroupResource moRes;
    bool resourceAllocated = false;

    std::map<std::string, CcuLoopEntity> loopMap;

    void CreateLoopEntity(std::string loopStr)
    {
        loopMap.emplace(loopStr, CcuLoopEntity());
    }

    bool IsLoopEntityRegistered(std::string loopStr)
    {
        return loopMap.count(loopStr) != 0;
    }
};

struct CcuDefaultRes {
    HcommCcuResType type;
    uint32_t num;
};

static constexpr CcuDefaultRes CCU_DEFAULT_RES[] = {
    {HCOMM_CCU_RES_TYPE_ADDRESS,    CCU_DEFAULT_RES_FRACTION_ADDRESS},
    {HCOMM_CCU_RES_TYPE_LOOP,       CCU_DEFAULT_RES_FRACTION_LOOP},
    {HCOMM_CCU_RES_TYPE_CCU_BUF,    CCU_DEFAULT_RES_FRACTION_CCU_BUF},
    {HCOMM_CCU_RES_TYPE_VARIABLE,   CCU_DEFAULT_RES_FRACTION_VARIABLE},
    {HCOMM_CCU_RES_TYPE_EVENT,      CCU_DEFAULT_RES_FRACTION_EVENT},
    {HCOMM_CCU_RES_TYPE_CCU_THREAD, CCU_DEFAULT_RES_FRACTION_CCU_THREAD},
};

static HcclResult ConvertCcuToHccl(CcuResult ccuResult)
{
    switch (ccuResult) {
        case CCU_SUCCESS: return HCCL_SUCCESS;
        case CCU_E_PARA: return HCCL_E_PARA;
        case CCU_E_PTR: return HCCL_E_PTR;
        case CCU_E_INTERNAL: return HCCL_E_INTERNAL;
        case CCU_E_NOT_SUPPORT: return HCCL_E_NOT_SUPPORT;
        case CCU_E_NOT_FOUND: return HCCL_E_NOT_FOUND;
        case CCU_E_UNAVAIL: return HCCL_E_UNAVAIL;
        default: return HCCL_E_INTERNAL;
    }
}

static void DestroyAllDescs(std::vector<HcommCcuResDescHandle> &descs)
{
    for (auto &desc : descs) {
        (void)HcommCcuInsResDescDestroy(desc);
    }
}

// ============================================================================
// CreateCcuInsWithEnabledDies — 创建 CCU 实例（跨 DIE 资源池）【原样复用 AG 已验证实现】
// ============================================================================
static HcclResult CreateCcuInsWithEnabledDies(CcuInsHandle &insHandle)
{
    std::vector<HcommCcuResDescHandle> resDescs;
    for (uint32_t dieId = 0; dieId < CCU_DIE_NUM; dieId++) {
        HcommCcuResDescHandle desc = 0;
        CcuResult descCreateRet = HcommCcuInsResDescCreate(dieId, &desc);
        if (descCreateRet != CCU_SUCCESS) {
            (void)HcommCcuInsResDescDestroy(desc);
            DestroyAllDescs(resDescs);
            return ConvertCcuToHccl(descCreateRet);
        }

        CcuResult probeRet = HcommCcuQueryRemainResDesc(desc);
        if (probeRet == CCU_E_UNAVAIL) {
            (void)HcommCcuInsResDescDestroy(desc);
            continue;
        }
        if (probeRet != CCU_SUCCESS) {
            (void)HcommCcuInsResDescDestroy(desc);
            DestroyAllDescs(resDescs);
            return ConvertCcuToHccl(probeRet);
        }

        for (const auto &res : CCU_DEFAULT_RES) {
            CcuResult setRet = HcommCcuInsResDescSetNum(desc, res.type, res.num);
            if (setRet != CCU_SUCCESS) {
                (void)HcommCcuInsResDescDestroy(desc);
                DestroyAllDescs(resDescs);
                return ConvertCcuToHccl(setRet);
            }
        }
        resDescs.push_back(desc);
    }

    if (resDescs.empty()) {
        return HCCL_E_INTERNAL;
    }

    CcuResult createRet = HcommCcuInsCreate(resDescs.data(), static_cast<uint32_t>(resDescs.size()), &insHandle);
    DestroyAllDescs(resDescs);
    return ConvertCcuToHccl(createRet);
}

// ============================================================================
// AcquireCcuChannels — 为每个远端 rank 获取一条 CCU 通信 channel【对齐 asc-comm
// ccu_direct/02_allgather_add 官方实现：新增 dieId 出参——首个 channel 的本地端点
// 经 HcclRankGraphGetEndpointInfo 查询 ENDPOINT_ATTR_DIE_ID，供后续 Variable/Event
// 分配与 schd.phyDieMask 使用（替代旧版硬编码 DIE_ID=1 / 0x01）】
// ============================================================================
static HcclResult AcquireCcuChannels(HcclComm comm, uint32_t rankId, uint32_t rankSize,
                                     std::vector<ChannelHandle> &kernelChannels, uint32_t &dieId)
{
    kernelChannels.resize(rankSize - 1);
    dieId = 0;

    uint32_t channelIdx = 0;
    for (uint32_t remoteRank = 0; remoteRank < rankSize; remoteRank++) {
        if (remoteRank == rankId) {
            continue;
        }

        uint32_t netLayer = 0;
        uint32_t listSize = 0;
        CommLink *linkList = nullptr;
        HCCLCHECK(HcclRankGraphGetLinks(comm, netLayer, rankId, remoteRank, &linkList, &listSize));

        HcclChannelDesc desc;
        HCCLCHECK(HcclChannelDescInit(&desc, 1));
        CommProtocol protocol = CommProtocol::COMM_PROTOCOL_UBC_CTP;
        bool protocolExists = false;
        for (uint32_t idx = 0; idx < listSize; idx++) {
            CommLink link = linkList[idx];
            if (link.linkAttr.linkProtocol == protocol) {
                desc.remoteRank = remoteRank;
                desc.notifyNum = CHANNEL_NOTIFY_NUM;
                desc.channelProtocol = link.linkAttr.linkProtocol;
                desc.localEndpoint.protocol = link.srcEndpointDesc.protocol;
                desc.localEndpoint.commAddr = link.srcEndpointDesc.commAddr;
                desc.localEndpoint.loc = link.srcEndpointDesc.loc;
                desc.remoteEndpoint.protocol = link.dstEndpointDesc.protocol;
                desc.remoteEndpoint.commAddr = link.dstEndpointDesc.commAddr;
                desc.remoteEndpoint.loc = link.dstEndpointDesc.loc;
                protocolExists = true;
                break;
            }
        }
        if (!protocolExists) {
            return HCCL_E_NOT_FOUND;
        }
        HCCLCHECK(HcclChannelAcquire(comm, CommEngine::COMM_ENGINE_CCU, &desc, 1,
            &kernelChannels[channelIdx]));
        // 首个 channel 落地后查询本地端点的 DIE ID（所有 channel 同 rank 同 DIE，查一次即可）
        if (channelIdx == 0) {
            EndpointAttrDieId dieIdValue = 0;
            HCCLCHECK(HcclRankGraphGetEndpointInfo(
                comm, rankId, &desc.localEndpoint, ENDPOINT_ATTR_DIE_ID, sizeof(EndpointAttrDieId), &dieIdValue));
            dieId = dieIdValue;
        }
        channelIdx++;
    }

    return HCCL_SUCCESS;
}

// ============================================================================
// 以下 6 个函数是 CCU loop/offset 参数的位域编码工具【原样复用 AG 已验证实现】
// CCU 硬件通过 64-bit 寄存器传递 loop 参数，不同 bit 段代表不同含义。
// ============================================================================
// SetBits — 生成低 (end+1) 位全 1 的掩码（注意 end 是"最高位序号"而非位数：SetBits(7)=0xFF）
static constexpr uint64_t SetBits(uint16_t end)
{
    return ((uint64_t(1) << (end + 1)) - uint64_t(1));
}

// GetMaxLoopIterNum — 最大 loop 迭代数（12 bit，=4095）
static uint64_t GetMaxLoopIterNum()
{
    constexpr uint16_t loopNumBitNum = 12;
    return SetBits(loopNumBitNum);
}

// GetLoopParam — 编码 loopCtxId(8b) + gsaOffset(32b) + loopIterNum(13b)
static uint64_t GetLoopParam(uint64_t loopCtxId, uint64_t gsaOffset, uint64_t loopIterNum)
{
    constexpr uint16_t ctxIdBitNum = 8;
    constexpr uint16_t ctxIdShiftBit = 45;
    constexpr uint16_t gsaBitNum = 32;
    constexpr uint16_t gsaShiftBit = 13;
    constexpr uint16_t loopNumBitNum = 13;
    constexpr uint16_t loopNumShiftBit = 0;
    return ((loopCtxId & SetBits(ctxIdBitNum)) << ctxIdShiftBit)
           | ((gsaOffset & SetBits(gsaBitNum)) << gsaShiftBit)
           | ((loopIterNum & SetBits(loopNumBitNum)) << loopNumShiftBit);
}

// GetParallelParam — 编码 repeatNum(7b) + repeatLoopIndex(7b) + totalLoopNum(7b)
static uint64_t GetParallelParam(uint64_t repeatNum, uint64_t repeatLoopIndex, uint64_t totalLoopNum)
{
    constexpr uint16_t repeatBitNum = 7;
    constexpr uint16_t repeatNumShiftBit = 55;
    constexpr uint16_t repeatLoopBitNum = 7;
    constexpr uint16_t repeatLoopShiftBit = 48;
    constexpr uint16_t totalLoopBitNum = 7;
    constexpr uint16_t totalLoopShiftBit = 41;
    return ((repeatNum & SetBits(repeatBitNum)) << repeatNumShiftBit)
           | ((repeatLoopIndex & SetBits(repeatLoopBitNum)) << repeatLoopShiftBit)
           | ((totalLoopNum & SetBits(totalLoopBitNum)) << totalLoopShiftBit);
}

// GetOffsetParam — 编码 gsaOffset(32b) + msOffset(11b) + ckeOffset(10b)
static uint64_t GetOffsetParam(uint64_t gsaOffset, uint64_t msOffset, uint64_t ckeOffset)
{
    constexpr uint16_t gsaBitNum = 32;
    constexpr uint16_t gsaShiftBit = 21;
    constexpr uint16_t msBitNum = 11;
    constexpr uint16_t msShiftBit = 10;
    constexpr uint16_t ckeBitNum = 10;
    constexpr uint16_t ckeShiftBit = 0;
    return ((gsaOffset & SetBits(gsaBitNum)) << gsaShiftBit)
           | ((msOffset & SetBits(msBitNum)) << msShiftBit)
           | ((ckeOffset & SetBits(ckeBitNum)) << ckeShiftBit);
}

// ============================================================================
// MakeLocalCopyConfig — 本地拷贝 LoopGroup 机器配置的单一装配出处
// （host 侧 PrepareAllToAll 与 device 侧 InitGroupCopyResources 共用，消除两处手工人肉对齐）
// ============================================================================
static LoopGroupConfig MakeLocalCopyConfig()
{
    LoopGroupConfig config{};
    config.msInterleave = CCU_MS_INTERLEAVE;
    config.loopCount = CCU_LOCAL_COPY_LOOP_COUNT;
    config.memSlice = CCU_MS_SIZE * CCU_MEMSLICES_PER_LOOP;
    return config;
}

// ============================================================================
// CalGoSize — 计算本地拷贝的 loop 参数四元组【逻辑原样复用 AG，返回值 struct 化】
//
// 当 sliceSize 超过单次 LoopGroup 容量（loopSize = loopCount*memSlice = 256KB）时分段：
//   addrOffset   — 完整 loop 块的起始偏移（loopSize 整数倍部分）
//   loopIterNum  — 完整 loop 块的迭代次数
//   loopExtendNum — 尾部扩展 loop 参数（位编码，不足一个完整 loop 的部分）
//   tailSize     — 尾部剩余字节数
// ============================================================================
static A2aGoSize CalGoSize(uint64_t size, const LoopGroupConfig &config)
{
    uint64_t loopSize = config.loopCount * config.memSlice;
    uint64_t maxSize = loopSize * (GetMaxLoopIterNum() + 1);

    uint64_t m = size / loopSize;
    uint64_t n = (size - m * loopSize) / config.memSlice;
    uint64_t p = size - m * loopSize - n * config.memSlice;

    if (size == maxSize) {
        m = GetMaxLoopIterNum();
        n = config.loopCount - 1;
        p = config.memSlice;
    }

    A2aGoSize goSize{};
    goSize.addrOffset = config.memSlice * config.loopCount * m;
    goSize.loopIterNum = m;

    constexpr uint64_t loopNumTwo = 2;
    if (n == 0 && p == 0) {
        goSize.loopExtendNum = 0;
        goSize.tailSize = 0;
    } else if (n != 0 && p == 0) {
        goSize.loopExtendNum = GetParallelParam(n - 1, 0, 1);
        goSize.tailSize = config.memSlice;
    } else if (n == 0 && p != 0) {
        goSize.loopExtendNum = GetParallelParam(0, 0, 1);
        goSize.tailSize = p;
    } else {
        goSize.loopExtendNum = GetParallelParam(n - 1, 1, loopNumTwo);
        goSize.tailSize = p;
    }

    return goSize;
}


// ============================================================================
// InitGroupCopyResources — 初始化本地拷贝的 Loop 资源【原样复用 AG 已验证实现】
//
// 首次调用时分配 moConfig/moRes（Buffer + Event）；
// 每次调用都重新创建 Loop Entity（lambda 按值捕获当前地址——AG 已验证坑位：
// 若只创建一次，round 1 会复用 round 0 的地址快照导致数据错位）。
// ============================================================================
static void InitGroupCopyResources(AllToAllMesh1DContext &ctx, ccu::LocalAddr *loopSrc,
                                   ccu::LocalAddr *loopDst, ccu::Variable *loopLen)
{
    if (!ctx.resourceAllocated) {
        ctx.moConfig = MakeLocalCopyConfig();

        ctx.moRes.eventCount = ctx.moConfig.loopCount;
        ctx.moRes.completedEvent = ccu::Array<ccu::Event>(ctx.moRes.eventCount);

        ctx.moRes.bufCount = ctx.moConfig.loopCount * ctx.moConfig.msInterleave;
        ctx.moRes.ccuBuf = ccu::Array<ccu::CcuBuffer>(ctx.moRes.bufCount);

        ctx.resourceAllocated = true;
    }

    // 每次调用都重新创建 Loop Entity（按值捕获 loopSrc/loopDst/loopLen 的当前值）
    {
        std::string loopType = "localcopy";
        if (ctx.IsLoopEntityRegistered(loopType)) {
            ctx.loopMap.erase(loopType);
        }
        ctx.CreateLoopEntity(loopType);
        auto &entity = ctx.loopMap[loopType];
        for (uint32_t index = 0; index < 2; index++) {
            uint32_t bufBase = index * ctx.moConfig.msInterleave;
            ccu::Event loopEvt = ctx.moRes.completedEvent[index];
            entity.body[index].reset(new ccu::Func(
                [&ctx, index, bufBase, loopEvt, loopSrc, loopDst, loopLen]() {
                    ccu::LocalCopy(ctx.moRes.ccuBuf[bufBase], loopSrc[index], loopLen[index], loopEvt, 1);
                    ccu::EventWait(loopEvt, 1);
                    ccu::LocalCopy(loopDst[index], ctx.moRes.ccuBuf[bufBase], loopLen[index], loopEvt, 1);
                    ccu::EventWait(loopEvt, 1);
                }));
            entity.loops[index].reset(
                new ccu::Loop(entity.loopParam[index], *entity.body[index]));
        }
    }
}

// ============================================================================
// GroupCopy — CCU 本地数据拷贝（GM → CCU Buffer → GM，通过 LoopGroup 并行执行）
// 【原样复用 AG 已验证实现，仅 Context 类型改为 AllToAllMesh1DContext】
// ============================================================================
static CcuResult GroupCopy(AllToAllMesh1DContext &ctx, ccu::LocalAddr dst, ccu::LocalAddr src,
                           GroupOpSizeVars goSize)
{
    ccu::LocalAddr loopSrc[2];
    ccu::LocalAddr loopDst[2];
    ccu::Variable loopLen[2];

    InitGroupCopyResources(ctx, loopSrc, loopDst, loopLen);

    auto &loops = ctx.loopMap["localcopy"];

    CCU_IF(goSize.addrOffset != 0)
    {
        ccu::Variable loopParam;
        loopParam = GetLoopParam(0, ctx.moConfig.memSlice * ctx.moConfig.loopCount, 0);
        loopParam += goSize.loopIterNum;

        ccu::Variable sliceSize;
        sliceSize = ctx.moConfig.memSlice;

        loopSrc[0].addr = src.addr;
        loopSrc[0].token = src.token;
        loopDst[0].addr = dst.addr;
        loopDst[0].token = dst.token;
        loopLen[0] = sliceSize;

        loops.loopParam[0] = loopParam;
        ccu::Variable paraCfg;
        paraCfg = GetParallelParam(ctx.moConfig.loopCount - 1, 0, 1);

        ccu::Variable offsetCfg;
        offsetCfg = GetOffsetParam(ctx.moConfig.memSlice, ctx.moConfig.msInterleave, 1);
        std::vector<ccu::Loop> grpLoops{ *loops.loops[0] };
        ccu::LoopGroup group(paraCfg, offsetCfg, ctx.moConfig.loopCount, grpLoops);
    }

    CCU_IF(goSize.loopExtendNum != 0)
    {
        src.addr += goSize.addrOffset;
        dst.addr += goSize.addrOffset;

        loopSrc[0].addr = src.addr;
        loopSrc[0].token = src.token;
        loopDst[0].addr = dst.addr;
        loopDst[0].token = dst.token;
        loopLen[0] = goSize.tailSize;

        src.addr += goSize.tailSize;
        dst.addr += goSize.tailSize;

        ccu::Variable sliceSize;
        sliceSize = ctx.moConfig.memSlice;

        loopSrc[1].addr = src.addr;
        loopSrc[1].token = src.token;
        loopDst[1].addr = dst.addr;
        loopDst[1].token = dst.token;
        loopLen[1] = sliceSize;

        ccu::Variable loopCfg0;
        loopCfg0 = GetLoopParam(0, 0, 1);
        ccu::Variable loopCfg1;
        loopCfg1 = GetLoopParam(0, 0, 1);
        ccu::Variable offsetCfg;
        offsetCfg = GetOffsetParam(ctx.moConfig.memSlice, ctx.moConfig.msInterleave, 1);

        loops.loopParam[0] = loopCfg0;
        loops.loopParam[1] = loopCfg1;
        std::vector<ccu::Loop> grpLoops{ *loops.loops[0], *loops.loops[1] };
        ccu::LoopGroup group(goSize.loopExtendNum, offsetCfg, ctx.moConfig.loopCount, grpLoops);
    }

    return CCU_SUCCESS;
}

// ============================================================================
// ExecuteAllToAllTransfer — 执行单 round 的 AllToAll 传输（CCU 核内）
// 【对应 CANN CcuKernelAlltoAllMesh1D::DoAlltoAll；结构与 AG ExecuteAllGatherTransfer 同构】
//
// AllToAll 语义（与 AllGather 的核心差异，三处差异点）：
//   - 差异①：src 随目标 rank j 逐块递推（j * srcStride）——AllGather 的 src 固定不变
//   - 差异②：远端落点 = 远端 recvBuf 的"第 myRank 块"（发送方 rankId 决定接收方落点），
//            由 host 预乘烧入 dstOffset（= myRank*blockSize + r*sub），CCU 侧与 AllGather
//            的 dst 计算写法完全一致
//   - 差异③：本地拷贝的 src 是"本 rank sendBuf 的第 myRank 块"（input + srcOffset +
//            myRank*srcStride），用独立累加循环构造 localSrc——与远端 j 循环的递推互不
//            复用（CCU 侧无标量×Variable 乘法，只能逐次 += srcStride 递推 myRank 次）
//
// 本函数执行步骤（每个 round 调用一次）：
//   1. 构造两个源地址：src（远端循环用起点）与 localSrc（本地块，累加递推 myRank 次）
//   2. 为每个 rank 计算目标地址（output[j] + dstOffset；本 rank → localDst）
//   3. 远端换块：j != myRank 逐 rank ccu::Write（跨卡），每次迭代后 src 递推下一块
//   4. 本地拷贝：GroupCopy(localDst, localSrc)（GM → CCU Buffer → GM）
//   5. EventRecord + EventWait 等待所有 rank 完成（含本地和远端）
// ============================================================================
static CcuResult ExecuteAllToAllTransfer(AllToAllMesh1DContext &ctx)
{
    // ---- 准备地址 ----
    ccu::LocalAddr src;
    ccu::LocalAddr localSrc;
    ccu::LocalAddr localDst;
    std::vector<ccu::RemoteAddr> dst;

    dst.resize(ctx.arg->rankSize);

    // src 起点：本 rank sendBuf 第 0 块 + round 级偏移（远端循环内逐 rank 递推 srcStride）
    // input Variable 由 AIC block 0 预写到参数桥（sendBuf 地址）
    src.addr = ctx.input;
    src.addr += ctx.srcOffset;
    // token: CCU 内存访问令牌（对齐 AG 已验证行为：本 rank sendBuf 的令牌）
    src.token = ctx.token[ctx.arg->rankId];

    // localSrc：本 rank sendBuf 的第 myRank 块（差异③：src 侧也含 rankId 项）
    // 用纯 Variable 累加递推 myRank 次（≤15 次，规避标量×Variable 运算）
    localSrc.addr = ctx.input;
    localSrc.addr += ctx.srcOffset;
    localSrc.token = ctx.token[ctx.arg->rankId];
    for (uint64_t k = 0; k < ctx.arg->rankId; k++) {
        localSrc.addr += ctx.srcStride;
    }

    // 为每个 rank 计算目标地址：
    //   本 rank → localDst（LocalAddr，recvBuf 第 myRank 块内）
    //   其他 rank → dst[j]（RemoteAddr，远端 recvBuf 的第 myRank 块内）
    // dstOffset 已含 myRank*blockSize 项（host 预乘烧入），此处与 AllGather 写法一致
    for (uint64_t j = 0; j < ctx.arg->rankSize; j++) {
        if (j == ctx.arg->rankId) {
            localDst.addr = ctx.output[j];
            localDst.addr += ctx.dstOffset;
            localDst.token = ctx.token[j];
        } else {
            dst[j].addr = ctx.output[j];
            dst[j].addr += ctx.dstOffset;
            dst[j].token = ctx.token[j];
        }
    }

    // ---- 远端换块传输：对每个远端 rank 执行 ccu::Write（差异①：src 逐 rank 递推）----
    // sendBuf 第 j 块 → 远端 rank j 的 recvBuf 第 myRank 块内
    // mask 指定目标 rank 的 bit 位；每次迭代后 src 递推到下一块
    CCU_IF(ctx.sliceSize != 0)
    {
        uint32_t channelIdx = 0;
        for (uint64_t j = 0; j < ctx.arg->rankSize; j++) {
            if (j != ctx.arg->rankId) {
                const uint16_t mask = static_cast<uint16_t>(1u << j);
                CCU_CHK_RET(ccu::Write(ctx.arg->channels[channelIdx], dst[j], src,
                    ctx.sliceSize, ctx.event, mask));
                channelIdx++;
            }
            // 递推到下一块（所有 j 均推进——差异①的逐 rank 源递推）
            src.addr += ctx.srcStride;
        }
    }

    // ---- 本地拷贝：本 rank 留给自己的块（sendBuf 第 myRank 块 → recvBuf 第 myRank 块内）----
    // 未来优化点（DESIGN_ANALYSIS §8.1）：零拷贝模式可整体跳过本地搬运（数据留 sendBuf 原地，
    // 下游按块→地址映射直读）——与阶段3 GMM 路线配套，届时本调用及 goSize 四槽可删
    // GroupCopy 内部通过 LoopGroup 并行执行多个 LocalCopy（GM → CCU Buffer → GM）
    // （与 AG 结构同构：Write 循环在 CCU_IF 内，GroupCopy 在外平级；sliceSize==0 时
    //  goSize 全零 → GroupCopy 内两个 CCU_IF 均不触发 → 空操作，安全）
    CCU_CHK_RET(GroupCopy(ctx, localDst, localSrc, ctx.goSize));

    // ---- 同步：等待所有 rank 的传输完成 ----
    // EventRecord: 记录本 rank 的完成事件（mask = 1 << rankId）
    // EventWait: 等待所有 rank 的完成事件（mask = (1 << rankSize) - 1）
    CCU_CHK_RET(ccu::EventRecord(ctx.event, static_cast<uint16_t>(1u << ctx.arg->rankId)));

    // rankSize ≤ 16 由 CCU_MAX_RANK_SIZE 保证，移位结果不溢出 uint16_t
    const uint16_t totalMask = static_cast<uint16_t>((1u << ctx.arg->rankSize) - 1);
    CCU_CHK_RET(ccu::EventWait(ctx.event, totalMask));

    return CcuResult::CCU_SUCCESS;
}

// ---- Notify 槽位常量（PreSync/PostSync 用，紧邻唯一使用处 CcuAllToAllMesh1DKernel）----
// OUTPUT_XN_ID/TOKEN_XN_ID：参数桥 output/token Variable 的跨 channel 通知槽位
// CKE_IDX_0：channel 的 CKE（通知寄存器组）索引；POST_SYNC_ID：round 尾 post-sync 槽位
constexpr int OUTPUT_XN_ID = 1;
constexpr int TOKEN_XN_ID = 2;
constexpr int CKE_IDX_0 = 0;
constexpr int POST_SYNC_ID = 3;

// ============================================================================
// CcuAllToAllMesh1DKernel — CCU 通信 kernel 主入口（__ccu_host__）
//
// 【流程骨架对齐 CANN CcuKernelAlltoAllMesh1D::Algorithm()：
//   InitResource → LoadArgs → PreSync → DoAlltoAll → PostSync，映射到本函数的 round 循环】
//
// 通过 <<<>>> 直接调用，运行在 streamCcu 上。负责 commTurn 轮 AllToAll 通信。
//
// 执行流程：
//   InitResource: 从 kernelArg 解析参数（rankSize/rankId/channels/vars/events），
//                 为每个远端 rank 获取 output/token Variable（channel 资源）
//   EventWait(events[0]): 等 AIC 唤醒（唯一 wake，循环外一次）
//   循环 commTurn 次（round r）：
//     a. LoadArgs: 按 BridgeSlot 枚举读该 round 的 11 个 Variable（参数桥 r 组）
//     b. PreSync: WriteVariableWithNotify + NotifyWait 跨 channel 同步 output/token
//     c. DoAlltoAll: ExecuteAllToAllTransfer（远端 Write + 本地 GroupCopy + Event 屏障）
//     d. PostSync: NotifyRecord + NotifyWait 确保所有 channel 传输彻底完成
//     e. EventRecord(events[r+1]) 通知 AIC round r 完成
// ============================================================================
__ccu_host__ void CcuAllToAllMesh1DKernel(CcuKernelArg arg)
{
    auto *kernelArg = static_cast<CcuKernelArgAllToAllMesh1D *>(arg);

    AllToAllMesh1DContext ctx;
    ctx.arg = kernelArg;

    if (ctx.arg->channelCount == 0) {
        return;
    }
    if (ctx.arg->commTurn == 0) {
        return;  // commTurn=0 无需通信，直接返回
    }

    // ---- InitResource ----
    ctx.output.resize(ctx.arg->rankSize);
    ctx.token.resize(ctx.arg->rankSize);

    uint32_t channelIdx = 0;
    for (uint64_t peerId = 0; peerId < ctx.arg->rankSize; peerId++) {
        if (peerId != ctx.arg->rankId) {
            ctx.output[peerId] = ccu::GetResByChannel<ccu::Variable>(ctx.arg->channels[channelIdx], OUTPUT_XN_ID);
            ctx.token[peerId] = ccu::GetResByChannel<ccu::Variable>(ctx.arg->channels[channelIdx], TOKEN_XN_ID);
            channelIdx++;
        }
    }

    // 从 kernelArg 获取 Variable 和 Event 资源数组
    // vars: commTurn*11 个 Variable，按 round 分组
    // events: commTurn+1 个 Event（[0]=wake, [r+1]=round r done）
    ccu::Array<ccu::Event> events(ctx.arg->eventHandle, ctx.arg->eventNum);
    ccu::Array<ccu::Variable> vars(ctx.arg->varHandle, ctx.arg->varNum);

    // ---- 等待 AIC 唤醒（唯一一次）----
    // AIC block 0 写完所有 round 的参数桥后写 eventVa[0]=1 触发此 EventWait 返回。
    // 唤醒后 CCU 各 round 串行自动进入，无需重复唤醒——故放在循环外，仅执行一次。
    ccu::EventWait(events[0]);

    for (uint32_t r = 0; r < ctx.arg->commTurn; r++) {
        // ---- LoadArgs：按 BridgeSlot 枚举读该 round 的 Variable 组（槽位语义见枚举定义）----
        uint32_t base = r * HCOMM_HOST_TASK_ARG_NUM;
        ctx.input = vars[base + SLOT_INPUT];
        ctx.output[ctx.arg->rankId] = vars[base + SLOT_OUTPUT];
        ctx.token[ctx.arg->rankId] = vars[base + SLOT_TOKEN];
        ctx.srcOffset = vars[base + SLOT_SRC_OFFSET];
        ctx.dstOffset = vars[base + SLOT_DST_OFFSET];
        ctx.sliceSize = vars[base + SLOT_SLICE_SIZE];
        ctx.srcStride = vars[base + SLOT_SRC_STRIDE];
        ctx.goSize.addrOffset = vars[base + SLOT_GO_ADDR_OFFSET];
        ctx.goSize.loopIterNum = vars[base + SLOT_GO_LOOP_ITER];
        ctx.goSize.loopExtendNum = vars[base + SLOT_GO_LOOP_EXTEND];
        ctx.goSize.tailSize = vars[base + SLOT_GO_TAIL_SIZE];

        // ---- PreSync：跨 channel 同步 output/token Variable ----
        // 将本 rank 的 output/token Variable 值通知到远端，并等待远端的到达
        for (uint32_t i = 0; i < ctx.arg->channelCount; i++) {
            CCU_CHK_VOID_RET(ccu::WriteVariableWithNotify(ctx.arg->channels[i], ctx.output[ctx.arg->rankId],
                OUTPUT_XN_ID, CKE_IDX_0, 1 << OUTPUT_XN_ID));
            CCU_CHK_VOID_RET(ccu::WriteVariableWithNotify(ctx.arg->channels[i], ctx.token[ctx.arg->rankId],
                TOKEN_XN_ID, CKE_IDX_0, 1 << TOKEN_XN_ID));
        }

        uint32_t allBit = (1 << OUTPUT_XN_ID) | (1 << TOKEN_XN_ID);
        for (uint32_t i = 0; i < ctx.arg->channelCount; i++) {
            CCU_CHK_VOID_RET(ccu::NotifyWait(ctx.arg->channels[i], CKE_IDX_0, allBit));
        }

        // ---- DoAlltoAll：执行实际 AllToAll 传输 ----
        CCU_CHK_VOID_RET(ExecuteAllToAllTransfer(ctx));

        // ---- PostSync：NotifyRecord + NotifyWait ----
        // 确保所有 channel 上的传输操作完全完成后才进入下一 round
        for (uint32_t i = 0; i < ctx.arg->channelCount; i++) {
            CCU_CHK_VOID_RET(ccu::NotifyRecord(ctx.arg->channels[i], CKE_IDX_0, 1 << POST_SYNC_ID));
        }
        for (uint32_t i = 0; i < ctx.arg->channelCount; i++) {
            CCU_CHK_VOID_RET(ccu::NotifyWait(ctx.arg->channels[i], CKE_IDX_0, 1 << POST_SYNC_ID));
        }

        // ---- 通知 AIC round r 完成 ----
        // AIC 轮询 eventVa[r+1]==1 后即可消费 round r 数据（阶段3 在此接 matmul tile r）
        ccu::EventRecord(events[r + 1]);
    }
}

} // namespace ops_comm_a2a

using namespace ops_comm_a2a;

// ============================================================================
// alltoallAicoreKernel — AIC kernel 入口（纯 AIC，通过 <<<>>> 直接调用，原 alltoall_bridge_kernel）
//
// 运行在 streamAicore 上，与运行在 streamCcu 上的 CcuAllToAllMesh1DKernel
// 双流并行执行。本 kernel 不做通信（通信由 CCU kernel 负责），只做：
//   1. AIC block 0 预写 commTurn 组参数桥到 Variable 区 + 写 wake event
//   2. 所有 AIC 核循环 commTurn 次轮询 round done（阶段1 仅验证同步链路；
//      阶段3 在轮询后接 matmul tile r，即成通算流水）
// ============================================================================
__global__ __aicore__ void alltoallAicoreKernel(__gm__ void *sendBuf, __gm__ void *recvBuf,
                                                  CcuMappedAddrs mappedAddrs,
                                                  uint64_t token, uint64_t srcStride,
                                                  A2aGoSize goSize,
                                                  uint32_t rankSize, uint32_t commTurn,
                                                  __gm__ const uint64_t *srcOffsets,
                                                  __gm__ const uint64_t *dstOffsets,
                                                  __gm__ const uint64_t *sliceSizes)
{
    // 手动声明 kernel 类型：函数体仅含轮询与 GM 读写（无 Cube/Vector 指令），编译器无法
    // 自动推导 AIC/AIV 类型（ld.lld "auto derivate failed"）；本 kernel 纯 AIC 执行
    //（launch 到 streamAicore，8 AIC 核，AIC_BLOCK_NUM）
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIC_ONLY);
    AscendC::InitSocState();

    A2aAicoreProcess(sendBuf, recvBuf, mappedAddrs, token, srcStride,
                     goSize, rankSize, commTurn, srcOffsets, dstOffsets, sliceSizes);
}

// ============================================================================
// Host 侧编排 + <<<>>> kernel launch（AllToAllKernel）
// 编排逻辑在 alltoall_host_impl.h 的 PrepareAllToAll，<<<>>> launch 留在此文件
//
// 单翻译单元说明（对齐 AG 示例的 ASC 编译模型）：
//   src/ 下其余源文件（alltoall_aicore_kernel_impl.h / alltoall_host_impl.h / main.cpp）
//   均由本 .asc 经相对 include 引入，CMakeLists 仅编译本文件——
//   不要把它们拆成独立编译单元。
// ============================================================================
#include "alltoall_host_impl.h"

// ============================================================================
// AllToAllKernel — Host 侧编排 + 双流 kernel launch 入口
//
// 编排流程（check 与 prepare 分离）：
//   1. ValidateAllToAllParams（check）：指针/参数/整除性校验 + rank 查询 + 切分尺寸；
//      sendCount==0 → 显式 skip 返回（不 Prepare 不 launch）
//   2. PrepareAllToAll（prepare）：分配 CCU 资源（Variable/Event/Channel），计算
//      offsets/goSize/token，拷贝 offsets 到 device GM，填充 ctx
//   3. CCU kernel launch（streamCcu）：CcuAllToAllMesh1DKernel<<<>>>
//      — CCU kernel 内部循环 commTurn 次 AllToAll
//   4. AIC kernel launch（streamAicore）：alltoallAicoreKernel<<<>>>
//      — 参数区预写 + wake + 轮询 round done，与 CCU 通信并行
//
// 双流时序：
//   streamCcu:    [wake]→ A2a round0 → A2a round1 → ...
//   streamAicore: [writeWake]→ poll done0 → poll done1 → ...
//   两个 stream 独立调度，通过 Event 在 GM 上的共享地址同步
// ============================================================================
HcclResult AllToAllKernel(void *sendBuf, void *recvBuf,
                          uint64_t sendCount, HcclDataType dataType,
                          HcclComm comm, aclrtStream streamAicore, aclrtStream streamCcu,
                          uint32_t commTurn, AllToAllContext &ctx)
{
    CHK_PTR_NULL(streamAicore);
    CHK_PTR_NULL(streamCcu);
    // sendBuf/recvBuf 空指针校验归属 ValidateAllToAllParams（check 阶段），此处不重复

    // ---- check 阶段：参数校验（不触碰 CCU 资源）----
    bool skip = false;
    HcclResult ret = ValidateAllToAllParams(sendBuf, recvBuf, comm, sendCount, dataType, commTurn, ctx, skip);
    if (ret != HCCL_SUCCESS) {
        return ret;
    }
    if (skip) {
        return HCCL_SUCCESS;  // sendCount==0：合法但无数据可传，不 Prepare 也不 launch
    }

    // ---- prepare 阶段：CCU 资源准备（前置条件：校验已通过）----
    ret = PrepareAllToAll(sendBuf, comm, commTurn, ctx);
    if (ret != HCCL_SUCCESS) {
        return ret;
    }

    // ============ CCU 通信 kernel launch（streamCcu，仅 1 次，kernel 内部循环 commTurn 次）============
    CcuAllToAllMesh1DKernel<<<ctx.schd, ctx.insHandle, streamCcu>>>(
        ctx.kernelArg.get());

    // ============ AIC 桥 kernel launch（纯 AIC，streamAicore）============
    // block 0 预写 commTurn 组参数桥 + 写 wake(eventVa[0]=1)
    // → 所有核循环 commTurn 次：轮询 eventVa[r+1]==1（round r done）
    alltoallAicoreKernel<<<AIC_BLOCK_NUM, 0, streamAicore>>>(
        sendBuf, recvBuf, ctx.mappedAddrs, ctx.token, ctx.srcStride,
        ctx.goSize,
        ctx.rankSize, ctx.commTurn,
        reinterpret_cast<__gm__ const uint64_t *>(ctx.d_srcOffsetsAddr),
        reinterpret_cast<__gm__ const uint64_t *>(ctx.d_dstOffsetsAddr),
        reinterpret_cast<__gm__ const uint64_t *>(ctx.d_sliceSizesAddr));

    return HCCL_SUCCESS;
}

#include "main.cpp"
