// ============================================================================
// 参数桥槽位单一事实源（SSOT）——全工程唯一的槽位语义定义处
// （"参数桥" = AIC/CCU kernel 间传参的 GM 共享内存参数区，沿自 AG 的称呼）
//   AIC 写侧（alltoall_aicore_kernel_impl.h 的 WriteBridgeSlot）与 CCU 读侧（本文件 LoadArgs）
//   均按此枚举索引；槽位总数经 HCOMM_HOST_TASK_ARG_NUM 供 CcuMappedAddrs/host 分配使用。
//   修改槽位布局只需改这里 + 两处调用点，不再依赖 7 处注释人肉对齐。
// ============================================================================
enum BridgeSlot : uint32_t {
    SLOT_INPUT = 0,          // sendBuf 地址（本 rank 发送侧）
    SLOT_OUTPUT = 1,         // recvBuf 地址（接收侧）
    SLOT_TOKEN = 2,          // CCU 内存访问令牌
    SLOT_SRC_OFFSET = 3,     // round 级公共源偏移 = r*sub（sendBuf 第 myRank 块内）
    SLOT_DST_OFFSET = 4,    // round 级公共目的偏移 = myRank*blockSize + r*sub（host 预乘烧入）
    SLOT_SLICE_SIZE = 5,     // 本轮子段字节数 = sub
    SLOT_SRC_STRIDE = 6,     // 块间距字节数 = blockSize（均匀 AllToAll 紧邻切分）
    SLOT_GO_ADDR_OFFSET = 7, // CalGoSize[0]：完整 loop 块起始偏移（本地拷贝）
    SLOT_GO_LOOP_ITER = 8,   // CalGoSize[1]：完整 loop 块迭代数
    SLOT_GO_LOOP_EXTEND = 9, // CalGoSize[2]：尾部扩展 loop 参数（位编码）
    SLOT_GO_TAIL_SIZE = 10,  // CalGoSize[3]：尾部剩余字节数
    BRIDGE_SLOT_NUM = 11
};
constexpr uint32_t HCOMM_HOST_TASK_ARG_NUM = BRIDGE_SLOT_NUM;  // 沿用 AG 命名（承自 CANN）
constexpr uint32_t MAX_COMMTURN = 16;
struct CcuMappedAddrs {
    // commTurn 组 Variable（每组 BRIDGE_SLOT_NUM 个，AIC block0 一次性预写所有 round）
    // 组 r = round r 的 AllToAll 参数；startVa[r][slot] 对应第 r round 第 slot 个 Variable 在 GM 中的地址
    uint64_t startVa[MAX_COMMTURN][HCOMM_HOST_TASK_ARG_NUM];
    // commTurn+1 个 Event（1 wake + commTurn 个 round done）
    // eventVa[0] = wake（AIC→CCU，仅 round 0 前）
    // eventVa[r+1] = round r done（CCU→AIC），r = 0..commTurn-1
    uint64_t eventVa[MAX_COMMTURN + 1];
};

// ============================================================================
// A2aGoSize — CCU 本地拷贝 loop 参数四元组（CalGoSize 输出，host → AIC 桥 kernel 按值传递）
// 字段名与 device 侧 GroupOpSizeVars 保持一致（AG MatmulTilingData 先例：POD 可经 <<<>>> 传值）
// ============================================================================
struct A2aGoSize {
    uint64_t addrOffset;   // 完整 loop 块的起始偏移
    uint64_t loopIterNum;  // 完整 loop 块迭代数
    uint64_t loopExtendNum; // 尾部扩展 loop 参数（位编码）
    uint64_t tailSize;     // 尾部剩余字节数
};

