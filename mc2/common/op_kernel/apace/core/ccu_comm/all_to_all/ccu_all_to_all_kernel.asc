/*!
 * \file ccu_all_to_all_kernel.asc
 * \brief __ccu_host__ CcuAllToAllMesh1DKernel——CCU AllToAll 通信 kernel
 *
 * ⚠️ 单锚点规则：本文件每个二进制只能 include 一次（__ccu_host__ kernel 符号唯一），
 *    消费方 TU 是唯一锚点（include 本文件后再 include 各自的 AIC kernel 与 host 编排）。
 * ⚠️ kernel 名冻结："CcuAllToAllMesh1DKernel" 参与 binaryCacheTag 哈希
 *    （tag = hash + rankId，单进程多 rank 线程共存的正确性依赖），永不改名。
 *
 * 轮循环（每轮四步）：
 *   LoadArgs（按 CommSlot 读该轮参数区组）→ ExecuteAllToAllTransfer（远端 Write 逐 rank
 *   递推 + 本地块 GroupCopy + Event 屏障）→ PostSync（NotifyRecord/Wait 确认全组完成）→
 *   notify（EventRecord(events[r+1]) 告知 AIC）。
 *   按轮类 PreSync（PublishOutputAndToken 发布接收地址/令牌）：scale 类循环前一次，
 *   data 类 r==1 轮首一次（须等 round 0 全局完成后才可覆写对端槽位）。
 */

#include "../ccu_comm.h"

// Notify 槽位常量（PublishOutputAndToken / PostSync 用）
constexpr int OUTPUT_XN_ID = 1;
constexpr int TOKEN_XN_ID = 2;
constexpr int CKE_IDX_0 = 0;
constexpr int POST_SYNC_ID = 3;

// process：等 AIC commit 后启动通信（唯一一次，轮循环前）
static inline void ProcessCcuCommStart(ccu::Array<ccu::Event> &events)
{
    ccu::EventWait(events[0]);
}

// notify：本轮通信完成，告知 AIC（round 0=scale 轮 → events[1]，round t+1=data 轮 t → events[t+2]）
static inline void NotifyAicoreCommDone(ccu::Array<ccu::Event> &events, uint32_t round)
{
    ccu::EventRecord(events[round + 1]);
}

// 向所有对端发布本 rank 的接收地址(output)与访问令牌(token)并等待全组到达。
// 发布按轮类只有两组值（scale 类 / data 类），各发布一次：
//   scale 类（组 0 槽位值）循环前发布；data 类（组 1 槽位值）在 r==1 轮首发布——
//   必须等 round 0 全局完成后才可覆写，否则尚未做完 round 0 的对端会把 scale 数据
//   按 data 地址写入 data 区
static inline void PublishOutputAndToken(AllToAllMesh1DContext &ctx)
{
    for (uint32_t i = 0; i < ctx.arg->channelCount; i++) {
        CCU_CHK_VOID_RET(ccu::WriteVariableWithNotify(ctx.arg->channels[i], ctx.output[ctx.arg->rankId],
            OUTPUT_XN_ID, CKE_IDX_0, 1 << OUTPUT_XN_ID));
        CCU_CHK_VOID_RET(ccu::WriteVariableWithNotify(ctx.arg->channels[i], ctx.token[ctx.arg->rankId],
            TOKEN_XN_ID, CKE_IDX_0, 1 << TOKEN_XN_ID));
    }

    uint32_t allBit = (1 << OUTPUT_XN_ID) | (1 << TOKEN_XN_ID);
    for (uint32_t i = 0; i < ctx.arg->channelCount; i++) {
        CCU_CHK_VOID_RET(ccu::NotifyWait(ctx.arg->channels[i], CKE_IDX_0, allBit));
    }
}

// LoadArgs（轮协议第 1 步）：按 CommSlot 枚举读该 round 的 Variable 组——
// 11 槽位布局的唯一物化处（SSOT），ExecuteAllToAllTransfer 只认语义名
static inline void LoadRoundArgs(AllToAllMesh1DContext &ctx, ccu::Array<ccu::Variable> &vars, uint32_t r)
{
    uint32_t base = r * HCOMM_HOST_TASK_ARG_NUM;
    ctx.input = vars[base + SLOT_INPUT];
    ctx.output[ctx.arg->rankId] = vars[base + SLOT_OUTPUT];
    ctx.token[ctx.arg->rankId] = vars[base + SLOT_TOKEN];
    ctx.srcOffset = vars[base + SLOT_SRC_OFFSET];
    ctx.dstOffset = vars[base + SLOT_DST_OFFSET];
    ctx.sliceSize = vars[base + SLOT_SLICE_SIZE];
    ctx.srcStride = vars[base + SLOT_SRC_STRIDE];
    ctx.goSize.addrOffset = vars[base + SLOT_GO_ADDR_OFFSET];
    ctx.goSize.loopIterNum = vars[base + SLOT_GO_LOOP_ITER];
    ctx.goSize.loopExtendNum = vars[base + SLOT_GO_LOOP_EXTEND];
    ctx.goSize.tailSize = vars[base + SLOT_GO_TAIL_SIZE];
}

// 执行单 round 的 AllToAll 传输（CCU 核内）：远端逐 rank ccu::Write（src 逐 rank 递推
// srcStride）+ 本地块 GroupCopy + Event 屏障等全组完成
static CcuResult ExecuteAllToAllTransfer(AllToAllMesh1DContext &ctx)
{
    ccu::LocalAddr src;
    ccu::LocalAddr localSrc;
    ccu::LocalAddr localDst;
    std::vector<ccu::RemoteAddr> dst;

    dst.resize(ctx.arg->rankSize);

    // src 起点：本 rank sendBuf 第 0 块 + round 级偏移
    src.addr = ctx.input;
    src.addr += ctx.srcOffset;
    src.token = ctx.token[ctx.arg->rankId];

    // localSrc：本 rank sendBuf 的第 myRank 块（累加递推 myRank 次，规避标量×Variable 运算）
    localSrc.addr = ctx.input;
    localSrc.addr += ctx.srcOffset;
    localSrc.token = ctx.token[ctx.arg->rankId];
    for (uint64_t k = 0; k < ctx.arg->rankId; k++) {
        localSrc.addr += ctx.srcStride;
    }

    // 每个 rank 的目标地址：本 rank → localDst，其他 rank → dst[j]（dstOffset 已含
    // myRank*blockSize 项，host 预乘烧入）
    for (uint64_t j = 0; j < ctx.arg->rankSize; j++) {
        if (j == ctx.arg->rankId) {
            localDst.addr = ctx.output[j];
            localDst.addr += ctx.dstOffset;
            localDst.token = ctx.token[j];
        } else {
            dst[j].addr = ctx.output[j];
            dst[j].addr += ctx.dstOffset;
            dst[j].token = ctx.token[j];
        }
    }

    // 远端换块：sendBuf 第 j 块 → 远端 rank j 的 recvBuf 第 myRank 块内
    CCU_IF(ctx.sliceSize != 0)
    {
        uint32_t channelIdx = 0;
        for (uint64_t j = 0; j < ctx.arg->rankSize; j++) {
            if (j != ctx.arg->rankId) {
                const uint16_t mask = static_cast<uint16_t>(1u << j);
                CCU_CHK_RET(ccu::Write(ctx.arg->channels[channelIdx], dst[j], src,
                    ctx.sliceSize, ctx.event, mask));
                channelIdx++;
            }
            src.addr += ctx.srcStride;
        }
    }

    // 本地拷贝：本 rank 留给自己的块（sliceSize==0 时 goSize 全零 → 空操作，安全）
    CCU_CHK_RET(GroupCopy(ctx, localDst, localSrc, ctx.goSize));

    // EventRecord + EventWait 等待所有 rank 完成
    CCU_CHK_RET(ccu::EventRecord(ctx.event, static_cast<uint16_t>(1u << ctx.arg->rankId)));

    const uint16_t totalMask = static_cast<uint16_t>((1u << ctx.arg->rankSize) - 1);
    CCU_CHK_RET(ccu::EventWait(ctx.event, totalMask));

    return CcuResult::CCU_SUCCESS;
}

// CCU 通信 kernel 主入口（__ccu_host__，运行在 streamCcu 上）：
//   InitResource → process（等 wake）→ 按轮类 PreSync →
//   循环 commTurn 次（LoadArgs → DoAlltoAll → PostSync → notify）
__ccu_host__ void CcuAllToAllMesh1DKernel(CcuKernelArg arg)
{
    auto *kernelArg = static_cast<CcuKernelArgAllToAllMesh1D *>(arg);

    AllToAllMesh1DContext ctx;
    ctx.arg = kernelArg;

    if (ctx.arg->channelCount == 0) {
        return;
    }
    if (ctx.arg->commTurn == 0) {
        return;
    }

    // ---- InitResource ----
    ctx.output.resize(ctx.arg->rankSize);
    ctx.token.resize(ctx.arg->rankSize);

    uint32_t channelIdx = 0;
    for (uint64_t peerId = 0; peerId < ctx.arg->rankSize; peerId++) {
        if (peerId != ctx.arg->rankId) {
            ctx.output[peerId] = ccu::GetResByChannel<ccu::Variable>(ctx.arg->channels[channelIdx], OUTPUT_XN_ID);
            ctx.token[peerId] = ccu::GetResByChannel<ccu::Variable>(ctx.arg->channels[channelIdx], TOKEN_XN_ID);
            channelIdx++;
        }
    }

    // vars: commTurn*11 个 Variable（按 round 分组）；events: [0]=wake, [1]=scale done, [t+2]=data 轮 t
    ccu::Array<ccu::Event> events(ctx.arg->eventHandle, ctx.arg->eventNum);
    ccu::Array<ccu::Variable> vars(ctx.arg->varHandle, ctx.arg->varNum);

    ProcessCcuCommStart(events);

    // PreSync（scale 类，一次性）
    ctx.output[ctx.arg->rankId] = vars[SLOT_OUTPUT];
    ctx.token[ctx.arg->rankId] = vars[SLOT_TOKEN];
    PublishOutputAndToken(ctx);

    for (uint32_t r = 0; r < ctx.arg->commTurn; r++) {
        if (r == 1) {
            // PreSync（data 类，一次性）：round 0 已全局完成，覆写对端槽位安全
            ctx.output[ctx.arg->rankId] = vars[HCOMM_HOST_TASK_ARG_NUM + SLOT_OUTPUT];
            ctx.token[ctx.arg->rankId] = vars[HCOMM_HOST_TASK_ARG_NUM + SLOT_TOKEN];
            PublishOutputAndToken(ctx);
        }

        LoadRoundArgs(ctx, vars, r);
        CCU_CHK_VOID_RET(ExecuteAllToAllTransfer(ctx));

        // PostSync：确保所有 channel 上的传输完全完成后才进入下一 round
        for (uint32_t i = 0; i < ctx.arg->channelCount; i++) {
            CCU_CHK_VOID_RET(ccu::NotifyRecord(ctx.arg->channels[i], CKE_IDX_0, 1 << POST_SYNC_ID));
        }
        for (uint32_t i = 0; i < ctx.arg->channelCount; i++) {
            CCU_CHK_VOID_RET(ccu::NotifyWait(ctx.arg->channels[i], CKE_IDX_0, 1 << POST_SYNC_ID));
        }

        NotifyAicoreCommDone(events, r);
    }
}
