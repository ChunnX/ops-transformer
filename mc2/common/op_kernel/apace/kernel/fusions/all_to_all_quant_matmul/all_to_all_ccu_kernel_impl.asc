/*!
 * \file all_to_all_ccu_kernel_impl.asc
 * \brief AllToAll MX Quant Matmul（CCU 版）——单翻译单元锚点
 *
 * 双流架构：
 *   streamCcu    CcuAllToAllMesh1DKernel（core/ccu_comm，__ccu_host__）：wake 后循环
 *                dataCommTurn+1 轮（round 0 = scale A2A，round 1..c = data 轮），
 *                每轮末 EventRecord 通知 AIC
 *   streamAicore AllToAllQuantMatmulKernelCcu（本文件）：block 0 清事件残值 →
 *                prepare（写全部轮参数区）→ commit（wake），全核融合 matmul 逐 tile
 *                轮询 round-done，tile 级通算 overlap
 *
 * 单翻译单元说明：本文件是本融合的唯一编译锚点——tests/st/all_to_all_quant_matmul/ccu/
 * src/main.cpp 经 #include 引入本文件，本文件按序引入 core 通信件（契约+引擎+资源 →
 * 通信 tiling/AIC 原语 → CCU kernel）→ 融合 AIC impl → host 编排。
 * ⚠️ core 的 ccu_all_to_all_kernel.asc 每个二进制只能被引入一次（本锚点就是唯一引入处）。
 * 不要把各部分拆成独立编译单元。
 */

// ---- core/ccu_comm：CCU 通信公共件（契约 + LoopGroup 引擎 + host 资源管理）----
#include "apace/core/ccu_comm/ccu_comm.h"
// ---- core/ccu_comm/all_to_all：通信 tiling 契约 + AIC 同步原语 + 资源装配 ----
#include "apace/core/ccu_comm/all_to_all/ccu_all_to_all_comm.h"
// ---- core/ccu_comm/all_to_all：__ccu_host__ 通信 kernel（单锚点，名字冻结）----
#include "apace/core/ccu_comm/all_to_all/ccu_all_to_all_kernel.asc"

// ---- 融合层：CcuCommWaitPolicy（qbmm 逐 tile 等待）+ 融合 matmul impl + AIC 编排 ----
#include "all_to_all_mx_quant_matmul_ccu_impl.h"

// AIC 融合 kernel 入口（纯 AIC，运行在 streamAicore 上）：InitSocState + AllToAllMatmulProcess
// （block 0 事件清扫 + prepare + commit；全核融合 matmul 逐 tile WaitTile）
// 函数体含 Blaze Cube 指令，ld.lld 自动推导 AIC 类型（无需 KERNEL_TASK_TYPE_DEFAULT）
__global__ __aicore__ void AllToAllQuantMatmulKernelCcu(__gm__ void *x1, __gm__ void *x1Scale,
                                                        __gm__ void *x2, __gm__ void *x2Scale,
                                                        __gm__ void *output, __gm__ void *workspace,
                                                        ccuAllToAllMatmulTilingData tilingData)
{
    AscendC::InitSocState();

    AllToAllMatmulProcess(x1, x1Scale, x2, x2Scale, output, workspace, tilingData);
}

// Host 侧编排（见 all_to_all_mx_quant_matmul_ccu_host_impl.h）
#include "all_to_all_mx_quant_matmul_ccu_host_impl.h"

// AllToAllMatmulCustom — Host 侧编排 + 双流 kernel launch 入口。
// 编排流程：Validate（check）→ Prepare（prepare，CCU 资源分配）→ CCU kernel launch →
// AIC 融合 kernel launch。
// 迭代间复用：同 shape 迭代经 Prepare 复用守卫直接返回，仅首帧分配资源
HcclResult AllToAllMatmulCustom(void *x1, void *x1Scale,
                          void *x2, void *x2Scale, void *output, void *workspace,
                          uint64_t sendCount, uint64_t scaleCount, uint64_t workspaceSize,
                          HcclDataType dataType, HcclComm comm,
                          aclrtStream streamAicore, aclrtStream streamCcu,
                          ccuAllToAllMatmulTilingData &tilingData,
                          AllToAllMatmulContext &ctx)
{
    CHK_PTR_NULL(streamAicore);
    CHK_PTR_NULL(streamCcu);
    CHK_PTR_NULL(x2);
    CHK_PTR_NULL(x2Scale);
    CHK_PTR_NULL(output);

    // tiling 入 ctx：首帧整体接收；复用帧仅刷新 caller 可变部分（matmul 切分 + comm.tileM），
    // 整体覆盖会清掉 Prepare 已填入的资源字段
    if (ctx.insHandle == 0) {
        ctx.tiling = tilingData;
    } else {
        ctx.tiling.matmul = tilingData.matmul;
        ctx.tiling.comm.tileM = tilingData.comm.tileM;
    }

    bool skip = false;
    HcclResult ret = ValidateAllToAllMatmulParams(x1, workspace, x1Scale, comm,
                                            sendCount, scaleCount, workspaceSize, dataType,
                                            ctx, skip);
    if (ret != HCCL_SUCCESS) {
        return ret;
    }
    if (skip) {
        return HCCL_SUCCESS;
    }

    ret = PrepareAllToAllMatmul(x1, x1Scale, comm, ctx);
    if (ret != HCCL_SUCCESS) {
        return ret;
    }

    // CCU 通信 kernel launch（streamCcu，仅 1 次，kernel 内部循环 dataCommTurn+1 次）；
    // 下发顺序 CCU 先、AIC 后（binaryCacheTag 按 rank 区分后注册仅每 rank 首帧一次）
    CcuAllToAllMesh1DKernel<<<ctx.schd, ctx.insHandle, streamCcu>>>(
        ctx.kernelArg.get());

    // AIC 融合 kernel launch（纯 AIC，streamAicore，block 数 = usedCoreNum）
    AllToAllQuantMatmulKernelCcu<<<ctx.tiling.matmul.usedCoreNum, 0, streamAicore>>>(
        x1, x1Scale, x2, x2Scale, output, workspace, ctx.tiling);

    return HCCL_SUCCESS;
}
