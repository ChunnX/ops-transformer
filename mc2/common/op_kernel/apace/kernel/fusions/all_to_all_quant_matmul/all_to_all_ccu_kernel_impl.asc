/*!
 * \file all_to_all_ccu_kernel_impl.asc
 * \brief AllToAll MX Quant Matmul（CCU 版）——单翻译单元锚点（AIC 融合 kernel + host 编排）
 *
 * 本文件是本融合的唯一编译锚点：消费方 TU（如 tests/st/all_to_all_quant_matmul/
 * ccu/src/main.cpp）只 include 本文件，由它按序引入 core 通信件与融合层，不要把
 * 各部分拆成独立编译单元（⚠️ core 的 ccu_all_to_all_kernel.asc 每个二进制只能被
 * 引入一次，本锚点是唯一引入处）。
 *
 * 双流架构（AllToAllMatmulCustom 一次调用下发两个 kernel）：
 *   streamCcu    CcuAllToAllMesh1DKernel（core，__ccu_host__）：wake 后单类发布一次，
 *                循环 dataCommTurn 轮（轮 0 = data 块 0 + scale 整块搭载），每轮末
 *                PostSync 落地确认 + EventRecord 通知 AIC
 *   streamAicore AllToAllQuantMatmulKernelCcu（本文件）：block 0 清事件残值 →
 *                commit（wake），全核融合 matmul 逐 tile 轮询 round-done，
 *                tile 级通算 overlap
 */

// ---- include 链（顺序即依赖顺序）----
#include "apace/core/ccu_comm/ccu_comm.h"                            // core：契约 + LoopGroup 引擎 + host 资源
#include "apace/core/ccu_comm/all_to_all/ccu_all_to_all_tiling.h"   // core A2A：通信 tiling 契约（kernel 侧）
#include "apace/core/ccu_comm/all_to_all/ccu_all_to_all_aic.h"      // core A2A：AIC 侧同步原语（__aicore__）
#include "apace/core/ccu_comm/all_to_all/ccu_all_to_all_kernel.asc" // core A2A：__ccu_host__ 通信 kernel（名字冻结）
#include "all_to_all_mx_quant_matmul_ccu_impl.h"                    // 融合层：WaitPolicy + 融合 impl + AIC 编排
#include "all_to_all_mx_quant_matmul_ccu_host_impl.h"               // 融合层：Validate / Prepare / Release（含 core host 件）

// ---- device 侧：AIC 融合 kernel 入口（streamAicore）----
// 纯 AIC：InitSocState → AllToAllMatmulProcess（block 0 事件清扫 + prepare + commit；
// 全核融合 matmul 逐 tile WaitTile）；显式声明 kernel 类型（同 UDMA 家族
// apace_a2a_kernel_launcher.h 惯例——Cube 指令存在时 ld.lld 可自动推导，但显式
// 声明不依赖函数体指令形态，通信-only 测量等裁剪场景同样成立）
__global__ __aicore__ void AllToAllQuantMatmulKernelCcu(__gm__ void *x1, __gm__ void *x1Scale,
                                                        __gm__ void *x2, __gm__ void *x2Scale,
                                                        __gm__ void *output, __gm__ void *workspace,
                                                        ccuAllToAllMatmulTilingData tilingData)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIC_ONLY);
    AscendC::InitSocState();

    AllToAllMatmulProcess(x1, x1Scale, x2, x2Scale, output, workspace, tilingData);
}

// ---- host 侧：编排 + 双流 launch 入口 ----
// 编排流程：Validate（check）→ PrepareCcuCommResources（CCU 资源分配）→ CCU kernel
// launch → AIC kernel launch；同 shape 迭代经复用守卫直接返回，仅首帧分配资源
HcclResult AllToAllMatmulCustom(void *x1, void *x1Scale,
                                void *x2, void *x2Scale, void *output, void *workspace,
                                uint64_t sendCount, uint64_t scaleCount, uint64_t workspaceSize,
                                HcclDataType dataType, HcclComm comm,
                                aclrtStream streamAicore, aclrtStream streamCcu,
                                ccuAllToAllMatmulTilingData &tilingData,
                                AllToAllMatmulContext &ctx)
{
    CHK_PTR_NULL(streamAicore);
    CHK_PTR_NULL(streamCcu);
    CHK_PTR_NULL(x2);
    CHK_PTR_NULL(x2Scale);
    CHK_PTR_NULL(output);

    // tiling 入 ctx：首帧整体接收；复用帧仅刷新 caller 可变部分（matmul 切分 + comm.tileM），
    // 整体覆盖会清掉 Validate/PrepareCcuCommResources 已填入的形状与资源字段
    if (ctx.insHandle == 0) {
        ctx.tiling = tilingData;
    } else {
        ctx.tiling.matmul = tilingData.matmul;
        ctx.tiling.comm.tileM = tilingData.comm.tileM;
    }

    bool skip = false;
    HcclResult ret = ValidateAllToAllMatmulParams(x1, workspace, x1Scale, comm,
                                                  sendCount, scaleCount, workspaceSize, dataType,
                                                  ctx, skip);
    if (ret != HCCL_SUCCESS) {
        return ret;
    }
    if (skip) {
        return HCCL_SUCCESS;
    }

    ret = PrepareCcuCommResources(x1, x1Scale, comm, ctx);
    if (ret != HCCL_SUCCESS) {
        return ret;
    }

    // 通信参数直达：每次调用刷新 kernelArg->stage（随 CCU kernel launch 按值到达；
    // 内含 streamCcu 同步，保证上一帧 CCU kernel 已退出）
    ret = RefreshCcuCommStage(x1, x1Scale, workspace, ctx, streamCcu);
    if (ret != HCCL_SUCCESS) {
        return ret;
    }

    // CCU 通信 kernel launch（streamCcu，仅 1 次，kernel 内部循环 dataCommTurn 次）；
    // 下发顺序 CCU 先、AIC 后（binaryCacheTag 按 rank 区分后注册仅每 rank 首帧一次）
    CcuAllToAllMesh1DKernel<<<ctx.schd, ctx.insHandle, streamCcu>>>(
        ctx.kernelArg.get());

    // AIC 融合 kernel launch（纯 AIC，streamAicore，block 数 = usedCoreNum）
    AllToAllQuantMatmulKernelCcu<<<ctx.tiling.matmul.usedCoreNum, 0, streamAicore>>>(
        x1, x1Scale, x2, x2Scale, output, workspace, ctx.tiling);

    return HCCL_SUCCESS;
}
