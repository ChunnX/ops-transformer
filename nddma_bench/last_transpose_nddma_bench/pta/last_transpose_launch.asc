/* !
 * \file last_transpose_launch.asc
 * \brief LastTranspose NDDMA kernel 的 PTA 直调启动器（ASC 编译）。
 *        约定：调用方（torch_npu）已完成 aclInit/SetDevice，本文件不再初始化 ACL。
 *
 * ★ registry-invoke 迁移适配（R-054 only-move-not-rewrite）：
 *   计算逻辑已迁至 ../op_kernel/arch35/last_transpose_nddma_bench.h 的
 *   命名空间类 KernelLastTransposeNDDMA<T, ubCapElems>。本文件不再 include
 *   原 op_kernel/*.asc（该文件已删除），改为：
 *     1. include 迁移后的 compute 头 + using namespace LastTransposeNddmaBenchNs;
 *     2. 在本地定义 attr GM POD 结构 LastTransposeNDDMAAttr（原 .asc 内定义，逐字保留）；
 *     3. 在本地定义 thin benchmark kernel 入口 LastTransposeNDDMABenchKernel，
 *        读 attr、按 dtype 派发到命名空间类，Init/Process（派发逻辑同 _apt.cpp）；
 *     4. 两个 C-ABI 函数（LaunchLastTranspose / *Host）签名与实现逐字不变，
 *        故 ext.cpp / pta_nddma.py 无需改动。
 */

#include "acl/acl.h"
#include "last_transpose_launch.h"

// 迁移后的 compute 头（提供命名空间类 KernelLastTransposeNDDMA 与 UB 容量常量）
#include "../op_kernel/arch35/last_transpose_nddma_bench.h"

using namespace LastTransposeNddmaBenchNs;

// tiling 结构：由 host 侧填好后经 attr GM 指针传入，无独立 Tiling 计算。
// （原 op_kernel/*.asc 中定义，迁移后 compute 头不再含它，故在此逐字保留。）
struct LastTransposeNDDMAAttr {
    uint32_t dim0;    // 分核维
    uint32_t dim1;    // 核内循环维
    uint32_t dim2;    // 转置块行数（转置前 last-1 轴）
    uint32_t dim3;    // 转置块列数（转置前 last 轴）
    uint32_t dtype;   // 0 = b16 (half), 1 = b32 (float), 2 = b8 (int8)
    uint32_t isMte3;  // 1 = MTE3 搬出到 GM（精度对比）；0 = 去掉 MTE3（纯 NDDMA 带宽）
};

// benchmark kernel 入口：tiling 通过 attr 原型入参控制；dtype 派发到命名空间类
// （派发逻辑与 last_transpose_nddma_bench_apt.cpp 一致，仅数据源由 TilingData 换回 attr GM）。
extern "C" __global__ __aicore__ __vector__ void LastTransposeNDDMABenchKernel(
    GM_ADDR x, GM_ADDR y, GM_ADDR attr)
{
    InitSocState();  // 静态 Tensor 编程：kernel 入口必须调用

    const __gm__ LastTransposeNDDMAAttr* a =
        reinterpret_cast<const __gm__ LastTransposeNDDMAAttr*>(attr);
    uint32_t dim0 = a->dim0;
    uint32_t dim1 = a->dim1;
    uint32_t dim2 = a->dim2;
    uint32_t dim3 = a->dim3;
    uint32_t dtype = a->dtype;
    uint32_t isMte3 = a->isMte3;

    if (dtype == 0) {  // b16 / half
        KernelLastTransposeNDDMA<half, UB_CAP_ELEMS_B16> op;
        op.Init(x, y, dim0, dim1, dim2, dim3, isMte3);
        op.Process();
    } else if (dtype == 1) {  // b32 / float
        KernelLastTransposeNDDMA<float, UB_CAP_ELEMS_B32> op;
        op.Init(x, y, dim0, dim1, dim2, dim3, isMte3);
        op.Process();
    } else {  // b8 / int8
        KernelLastTransposeNDDMA<int8_t, UB_CAP_ELEMS_B8> op;
        op.Init(x, y, dim0, dim1, dim2, dim3, isMte3);
        op.Process();
    }

    PipeBarrier<PIPE_ALL>();  // 静态 Tensor 编程：kernel 结束前必须调用
}

int LaunchLastTranspose(void* xDev, void* yDev,
                         uint32_t dim0, uint32_t dim1, uint32_t dim2, uint32_t dim3,
                         uint32_t dtype, uint32_t isMte3, void* extStream)
{
    LastTransposeNDDMAAttr attr{dim0, dim1, dim2, dim3, dtype, isMte3};

    // attr 通过 device 小缓冲传入 kernel
    void* attrDev = nullptr;
    aclError ret = aclrtMalloc(&attrDev, sizeof(attr), ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS) {
        return static_cast<int>(ret);
    }

    // 复用外部 stream（torch_npu 当前流）；为 null 时自建并在末尾同步销毁
    aclrtStream stream = reinterpret_cast<aclrtStream>(extStream);
    bool ownStream = (stream == nullptr);
    if (ownStream) {
        ret = aclrtCreateStream(&stream);
        if (ret != ACL_SUCCESS) {
            aclrtFree(attrDev);
            return static_cast<int>(ret);
        }
    }

    // attr 拷贝与 kernel 发射在同一 stream 上保证顺序
    aclrtMemcpyAsync(attrDev, sizeof(attr), &attr, sizeof(attr),
                     ACL_MEMCPY_HOST_TO_DEVICE, stream);

    uint32_t blockNum = dim0;  // dim0 作为分核数
    LastTransposeNDDMABenchKernel<<<blockNum, nullptr, stream>>>(
        reinterpret_cast<uint8_t*>(xDev),
        reinterpret_cast<uint8_t*>(yDev),
        reinterpret_cast<uint8_t*>(attrDev));

    // 同步以保证 attr 栈变量存活至拷贝完成、且输出就绪
    ret = aclrtSynchronizeStream(stream);

    aclrtFree(attrDev);
    if (ownStream) {
        aclrtDestroyStream(stream);
    }
    return static_cast<int>(ret);
}

// ---- 自包含 host 入口：torch_npu 不支持当前 SoC 时的直调路径 ----

static uint32_t ElemSize(uint32_t dtype)
{
    return dtype == 0 ? 2u : (dtype == 1 ? 4u : 1u);  // fp16 / fp32 / int8
}

int LaunchLastTransposeHost(const void* xHost, void* yHost,
                             uint32_t dim0, uint32_t dim1, uint32_t dim2, uint32_t dim3,
                             uint32_t dtype, uint32_t isMte3, int32_t deviceId)
{
    // 进程内仅初始化一次 ACL + 绑定设备
    static bool inited = false;
    if (!inited) {
        aclError r = aclInit(nullptr);
        if (r != ACL_SUCCESS && r != ACL_ERROR_REPEAT_INITIALIZE) {
            return static_cast<int>(r);
        }
        r = aclrtSetDevice(deviceId);
        if (r != ACL_SUCCESS) {
            return static_cast<int>(r);
        }
        inited = true;
    }

    const uint64_t numel = static_cast<uint64_t>(dim0) * dim1 * dim2 * dim3;
    const uint64_t bytes = numel * ElemSize(dtype);

    void* xDev = nullptr;
    void* yDev = nullptr;
    aclError ret = aclrtMalloc(&xDev, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS) {
        return static_cast<int>(ret);
    }
    ret = aclrtMalloc(&yDev, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS) {
        aclrtFree(xDev);
        return static_cast<int>(ret);
    }

    aclrtStream stream = nullptr;
    ret = aclrtCreateStream(&stream);
    if (ret != ACL_SUCCESS) {
        aclrtFree(xDev);
        aclrtFree(yDev);
        return static_cast<int>(ret);
    }

    ret = aclrtMemcpy(xDev, bytes, xHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    if (ret == ACL_SUCCESS) {
        ret = LaunchLastTranspose(xDev, yDev, dim0, dim1, dim2, dim3,
                                   dtype, isMte3, stream);
    }
    if (ret == static_cast<int>(ACL_SUCCESS)) {
        ret = aclrtMemcpy(yHost, bytes, yDev, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    }

    aclrtDestroyStream(stream);
    aclrtFree(xDev);
    aclrtFree(yDev);
    return static_cast<int>(ret);
}
