/* !
 * \file nddma_broadcast_launch.asc
 * \brief Broadcast NDDMA kernel 的 PTA 直调启动器（ASC 编译）——3D NDDMA 方案（DESIGN §9，权威）。
 *        约定：调用方（torch_npu）已完成 aclInit/SetDevice，本文件不再初始化 ACL。
 *
 * 5D 四场景（AB/BA/BAB/ABA）统一为单条 3D NDDMA（dim1 唯一核内 for，dim2/dim3/dim4 为 loopInfo 三轴，
 *   tile=dim2*dim3*dim4）；输入 shape 随 scene（广播轴长度=1），输出恒 (dim0,dim1,dim2,dim3,dim4)。
 *
 * ★ registry-invoke 迁移适配（R-054 only-move-not-rewrite）：
 *   计算逻辑已迁至 ../op_kernel/arch35/broadcast_nddma_bench.h 的命名空间类
 *   KernelBroadcastNDDMA<T, ubCapElems>。本文件不再 include 原 op_kernel/*.asc（已删除），改为：
 *     1. include 迁移后的 compute 头 + using namespace BroadcastNddmaBenchNs;
 *        （该头同时提供 SCENE_AB/BA/BAB/ABA，故本文件不再本地重声明，避免重定义）；
 *     2. 在本地定义 attr GM POD 结构 BroadcastNDDMAAttr（8 字段，原 .asc 内定义，逐字保留）；
 *     3. 在本地定义 thin benchmark kernel 入口 BroadcastNDDMABenchKernel，
 *        读 attr、按 dtype 派发到命名空间类，Init/Process（派发逻辑同 _apt.cpp，scene 透传 Init）；
 *     4. 唯一 C-ABI 函数 LaunchNddmaBroadcast5d 签名与实现逐字不变（本算子无 Host 变体），
 *        故 ext.cpp / pta_nddma.py 无需改动。
 */

#include "acl/acl.h"
#include "nddma_broadcast_launch.h"

// 迁移后的 compute 头（提供命名空间类 KernelBroadcastNDDMA、UB 容量常量、SCENE_* 常量）
#include "../op_kernel/arch35/broadcast_nddma_bench.h"

using namespace BroadcastNddmaBenchNs;

// tiling 结构：由 host 侧填好后经 attr GM 指针传入，无独立 Tiling 计算（DESIGN §9.3）。
// （原 op_kernel/*.asc 中定义，迁移后 compute 头不再含它，故在此逐字保留。8 字段。）
struct BroadcastNDDMAAttr {
    uint32_t dim0;    // 分核维（=物理 vector core 数 56，单波 per=1/rem=0）
    uint32_t dim1;    // 唯一核内 for 循环维
    uint32_t dim2;    // NDDMA 最外轴 loopInfo[2]（单条内遍历，非 for）
    uint32_t dim3;    // NDDMA 中轴   loopInfo[1]
    uint32_t dim4;    // NDDMA 最内连续轴 loopInfo[0]
    uint32_t dtype;   // 0 = b16 (half), 1 = b32 (float), 2 = b8 (int8)
    uint32_t isMte3;  // 1 = MTE3 写回（精度/读写带宽）；0 = 纯 NDDMA（读带宽）
    uint32_t scene;   // 0=AB / 1=BA / 2=BAB / 3=ABA（DESIGN §9.0）
};

// 目标芯片实际 vector core 数：作为 kernel 发射 blockDim。
// 来源：platform_config Ascend950PR_9579.ini 的 vector_core_cnt=56。
static constexpr uint32_t kVectorCoreCnt = 56;

// benchmark kernel 入口：tiling 通过 attr 原型入参控制；dtype 派发到命名空间类
// （派发逻辑与 broadcast_nddma_bench_apt.cpp 一致，仅数据源由 TilingData 换回 attr GM）。
extern "C" __global__ __aicore__ __vector__ void BroadcastNDDMABenchKernel(
    GM_ADDR x, GM_ADDR y, GM_ADDR attr)
{
    InitSocState();  // 静态 Tensor 编程：kernel 入口必须调用

    const __gm__ BroadcastNDDMAAttr* a =
        reinterpret_cast<const __gm__ BroadcastNDDMAAttr*>(attr);
    uint32_t dim0 = a->dim0;
    uint32_t dim1 = a->dim1;
    uint32_t dim2 = a->dim2;
    uint32_t dim3 = a->dim3;
    uint32_t dim4 = a->dim4;
    uint32_t dtype = a->dtype;
    uint32_t isMte3 = a->isMte3;
    uint32_t scene = a->scene;

    if (dtype == 0) {  // b16 / half
        KernelBroadcastNDDMA<half, UB_CAP_ELEMS_B16> op;
        op.Init(x, y, dim0, dim1, dim2, dim3, dim4, isMte3, scene);
        op.Process();
    } else if (dtype == 1) {  // b32 / float
        KernelBroadcastNDDMA<float, UB_CAP_ELEMS_B32> op;
        op.Init(x, y, dim0, dim1, dim2, dim3, dim4, isMte3, scene);
        op.Process();
    } else {  // b8 / int8
        KernelBroadcastNDDMA<int8_t, UB_CAP_ELEMS_B8> op;
        op.Init(x, y, dim0, dim1, dim2, dim3, dim4, isMte3, scene);
        op.Process();
    }

    PipeBarrier<PIPE_ALL>();  // 静态 Tensor 编程：kernel 结束前必须调用
}

// ---- 5D 广播场景直调（DESIGN §9）：4 场景统一为单条 3D NDDMA（dim1 唯一核内 for）----

int LaunchNddmaBroadcast5d(void* xDev, void* yDev,
                           uint32_t dim0, uint32_t dim1, uint32_t dim2,
                           uint32_t dim3, uint32_t dim4, uint32_t scene,
                           uint32_t dtype, uint32_t isMte3,
                           uint32_t blockNum, void* extStream)
{
    // 5D attr（DESIGN §9.3，8 字段）：{dim0,dim1,dim2,dim3,dim4,dtype,isMte3,scene}。
    BroadcastNDDMAAttr attr{dim0, dim1, dim2, dim3, dim4, dtype, isMte3, scene};

    void* attrDev = nullptr;
    aclError ret = aclrtMalloc(&attrDev, sizeof(attr), ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS) {
        return static_cast<int>(ret);
    }

    aclrtStream stream = reinterpret_cast<aclrtStream>(extStream);
    bool ownStream = (stream == nullptr);
    if (ownStream) {
        ret = aclrtCreateStream(&stream);
        if (ret != ACL_SUCCESS) {
            aclrtFree(attrDev);
            return static_cast<int>(ret);
        }
    }

    aclrtMemcpyAsync(attrDev, sizeof(attr), &attr, sizeof(attr),
                     ACL_MEMCPY_HOST_TO_DEVICE, stream);

    // 分核轴=dim0（§9.3 numBlocks_=dim0）。核数扫描时按显式 blockNum 发射；缺省 min(dim0,56)。
    // kernel per/rem 对任意 blockNum 正确（无需改 kernel）。
    uint32_t bn = (blockNum > 0) ? blockNum : (dim0 < kVectorCoreCnt ? dim0 : kVectorCoreCnt);
    BroadcastNDDMABenchKernel<<<bn, nullptr, stream>>>(
        reinterpret_cast<uint8_t*>(xDev),
        reinterpret_cast<uint8_t*>(yDev),
        reinterpret_cast<uint8_t*>(attrDev));

    ret = aclrtSynchronizeStream(stream);

    aclrtFree(attrDev);
    if (ownStream) {
        aclrtDestroyStream(stream);
    }
    return static_cast<int>(ret);
}
