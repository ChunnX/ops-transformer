#include "kernel_operator.h"
#include "moe_distribute_dispatch_v2_tiling.h"
template<typename XType, typename ExpandXType>
__global__ __aicore__ void dispatch_a5_mte_nofullmesh(
    GM_ADDR x, GM_ADDR expertIds, GM_ADDR scales, GM_ADDR xActiveMask,
    GM_ADDR elasticInfo, GM_ADDR performanceInfo, GM_ADDR expandXOut,
    GM_ADDR dynamicScalesOut, GM_ADDR assistInfoOut, GM_ADDR expertTokenNumsOut,
    GM_ADDR epSendCountsOut, GM_ADDR tpSendCountsOut, GM_ADDR workspaceGM,
    MoeDistributeDispatchV2TilingData tilingData);

#include <cstdlib>
#include <cstdio>
#include <cstring>
#include <unistd.h>
#include <hccl/hccl.h>
#include <acl/acl.h>

static int _r() { const char* v = getenv("OMPI_COMM_WORLD_RANK"); return v ? atoi(v) : 0; }
static int _w() { const char* v = getenv("OMPI_COMM_WORLD_SIZE"); return v ? atoi(v) : 1; }

#if !defined(__NPU_ARCH__)
int main() {
    int rank = _r(), world = _w();
    printf("[Dispatch A5] rank=%d/%d\n", rank, world);

    aclInit(nullptr);
    aclError ret = aclrtSetDevice(rank);
    if (ret) { printf("[Dispatch A5] aclrtSetDevice(%d) err=%d\n", rank, (int)ret); return -1; }
    aclrtStream stream; aclrtCreateStream(&stream);

    printf("[Dispatch A5] HCCL init...\n");
    HcclComm hcclComm;
    HcclResult hret = HcclCommInitAll(world, nullptr, &hcclComm);
    if (hret) { printf("[Dispatch A5] HcclCommInitAll err=%d\n", (int)hret); return -1; }
    printf("[Dispatch A5] HCCL done.\n");

    // Get HCCL window size from env or default 64MB
    uint64_t winSize = 64UL * 1024 * 1024;
    const char* bf = getenv("HCCL_BUFFSIZE");
    if (bf) winSize = (uint64_t)atol(bf);
    printf("[Dispatch A5] winSize=%lu\n", winSize);

    const int bs = 4, h = 128, k = 2, moe = 4;
    int gbs = bs * world, a = gbs * k;
    // A5 typical: 8~16 AIV cores, ~32MB UB
    uint32_t cores = 8; uint64_t ub = 32UL * 1024 * 1024;
    printf("[Dispatch A5] cores=%u bs=%d h=%d a=%d\n", cores, bs, h, a);

    GM_ADDR xDev = nullptr;   aclrtMalloc((void**)&xDev, bs*h*sizeof(half), ACL_MEM_MALLOC_HUGE_FIRST);
    GM_ADDR eidDev = nullptr; aclrtMalloc((void**)&eidDev, bs*k*sizeof(int32_t), ACL_MEM_MALLOC_HUGE_FIRST);
    GM_ADDR exDev = nullptr;  aclrtMalloc((void**)&exDev, a*h*sizeof(half), ACL_MEM_MALLOC_HUGE_FIRST);
    GM_ADDR dsDev = nullptr;  aclrtMalloc((void**)&dsDev, a*sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    GM_ADDR asDev = nullptr;  aclrtMalloc((void**)&asDev, (bs*k) > (a*128) ? (bs*k) : (a*128)*sizeof(int32_t), ACL_MEM_MALLOC_HUGE_FIRST);
    GM_ADDR tnDev = nullptr;  aclrtMalloc((void**)&tnDev, moe*sizeof(int64_t), ACL_MEM_MALLOC_HUGE_FIRST);
    GM_ADDR scDev = nullptr;  aclrtMalloc((void**)&scDev, world*sizeof(int32_t), ACL_MEM_MALLOC_HUGE_FIRST);
    GM_ADDR tpDev = nullptr;  aclrtMalloc((void**)&tpDev, sizeof(int32_t), ACL_MEM_MALLOC_HUGE_FIRST);
    GM_ADDR wsDev = nullptr;  aclrtMalloc((void**)&wsDev, 64UL*1024*1024, ACL_MEM_MALLOC_HUGE_FIRST);

    half* hx = new half[bs*h]; int32_t* he = new int32_t[bs*k];
    for (int i = 0; i < bs*h; i++) { uint16_t u = (uint16_t)((i % 100) | 0x3C00); memcpy(&hx[i], &u, 2); }
    for (int i = 0; i < bs; i++) { he[i*k] = 0; he[i*k+1] = 1; }
    aclrtMemcpy(xDev, bs*h*sizeof(half), hx, bs*h*sizeof(half), ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(eidDev, bs*k*sizeof(int32_t), he, bs*k*sizeof(int32_t), ACL_MEMCPY_HOST_TO_DEVICE);
    delete[] hx; delete[] he;

    MoeDistributeDispatchV2TilingData td;
    memset(&td, 0, sizeof(td));
    td.moeDistributeDispatchV2Info.epRankId = (uint32_t)rank;
    td.moeDistributeDispatchV2Info.epWorldSize = (uint32_t)world;
    td.moeDistributeDispatchV2Info.moeExpertNum = (uint32_t)moe;
    td.moeDistributeDispatchV2Info.bs = (uint32_t)bs; td.moeDistributeDispatchV2Info.k = (uint32_t)k;
    td.moeDistributeDispatchV2Info.h = (uint32_t)h; td.moeDistributeDispatchV2Info.a = (uint32_t)a;
    td.moeDistributeDispatchV2Info.aivNum = cores; td.moeDistributeDispatchV2Info.globalBs = (uint32_t)gbs;
    td.moeDistributeDispatchV2Info.totalUbSize = ub;
    td.moeDistributeDispatchV2Info.totalWinSizeEp = winSize;

    printf("[Dispatch A5] Launching...\n");
    dispatch_a5_mte_nofullmesh<half, half><<<cores, nullptr, stream>>>(
        xDev, eidDev, (GM_ADDR)nullptr, (GM_ADDR)nullptr,
        (GM_ADDR)nullptr, (GM_ADDR)nullptr, exDev, dsDev, asDev, tnDev, scDev, tpDev, wsDev, td);
    aclrtSynchronizeStream(stream);
    printf("[Dispatch A5] Done.\n");

    int32_t* scHost = new int32_t[world];
    aclrtMemcpy(scHost, world*sizeof(int32_t), scDev, world*sizeof(int32_t), ACL_MEMCPY_DEVICE_TO_HOST);
    printf("[Dispatch A5] sendCounts:"); for (int i=0; i<world; i++) printf(" %d", scHost[i]); printf("\n");
    delete[] scHost;

    aclrtFree(xDev); aclrtFree(eidDev); aclrtFree(exDev); aclrtFree(dsDev);
    aclrtFree(asDev); aclrtFree(tnDev); aclrtFree(scDev); aclrtFree(tpDev); aclrtFree(wsDev);
    aclrtDestroyStream(stream); (void)hcclComm;
    aclrtResetDevice(rank); aclFinalize();
    printf("[Dispatch A5] rank=%d done.\n", rank);
    return 0;
}
#endif
