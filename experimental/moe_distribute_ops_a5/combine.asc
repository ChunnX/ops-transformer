#include "moe_distribute_combine_v2.h"
#include "moe_distribute_combine_v2_tiling.h"
#include <type_traits>

using namespace MoeDistributeCombineV2Impl;
using namespace Mc2Kernel;

// A5/A3 non-FullMesh, no TP, no quant
template<typename ExpandXType, typename XType>
__global__ __aicore__ void combine_a5_mte_nofullmesh(
    GM_ADDR expandX, GM_ADDR expertIds, GM_ADDR assistInfoForCombine,
    GM_ADDR epSendCount, GM_ADDR scales, GM_ADDR tpSendCount, GM_ADDR xActiveMask,
    GM_ADDR sharedExpertX, GM_ADDR elasticInfo, GM_ADDR oriX, GM_ADDR constExpertAlpha1,
    GM_ADDR constExpertAlpha2, GM_ADDR constExpertV, GM_ADDR performanceInfo,
    GM_ADDR XOut, GM_ADDR workspaceGM,
    MoeDistributeCombineV2TilingData tilingData)
{
#if !defined(__NPU_HOST__)
    using namespace AscendC;
    TPipe pipe;
    MoeDistributeCombineV2<ExpandXType, XType, int32_t, false, UNQUANT, false> op;
    op.Init(nullptr, expandX, expertIds, assistInfoForCombine, epSendCount, tpSendCount,
            nullptr, nullptr, scales, xActiveMask, sharedExpertX, elasticInfo, oriX,
            constExpertAlpha1, constExpertAlpha2, constExpertV, performanceInfo,
            nullptr, nullptr, XOut, workspaceGM, &pipe, &tilingData);
    op.Process();
#endif
}

// A5/A3 FullMesh, no TP, no quant
template<typename ExpandXType, typename XType>
__global__ __aicore__ void combine_a5_mte_fullmesh(
    GM_ADDR expandX, GM_ADDR expertIds, GM_ADDR assistInfoForCombine,
    GM_ADDR epSendCount, GM_ADDR scales, GM_ADDR tpSendCount, GM_ADDR xActiveMask,
    GM_ADDR sharedExpertX, GM_ADDR elasticInfo, GM_ADDR oriX, GM_ADDR constExpertAlpha1,
    GM_ADDR constExpertAlpha2, GM_ADDR constExpertV, GM_ADDR performanceInfo,
    GM_ADDR XOut, GM_ADDR workspaceGM,
    MoeDistributeCombineV2TilingData tilingData)
{
#if !defined(__NPU_HOST__)
    using namespace AscendC;
    TPipe pipe;
    MoeDistributeCombineV2<ExpandXType, XType, int32_t, false, UNQUANT, true> op;
    op.Init(nullptr, expandX, expertIds, assistInfoForCombine, epSendCount, tpSendCount,
            nullptr, nullptr, scales, xActiveMask, sharedExpertX, elasticInfo, oriX,
            constExpertAlpha1, constExpertAlpha2, constExpertV, performanceInfo,
            nullptr, nullptr, XOut, workspaceGM, &pipe, &tilingData);
    op.Process();
#endif
}

template __global__ __aicore__ void combine_a5_mte_nofullmesh<half, half>(
    GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR,
    GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR,
    MoeDistributeCombineV2TilingData);
template __global__ __aicore__ void combine_a5_mte_nofullmesh<bfloat16_t, bfloat16_t>(
    GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR,
    GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR,
    MoeDistributeCombineV2TilingData);
template __global__ __aicore__ void combine_a5_mte_fullmesh<half, half>(
    GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR,
    GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR,
    MoeDistributeCombineV2TilingData);
