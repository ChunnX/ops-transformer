#include "kernel_operator.h"
#include "moe_distribute_combine_v2_tiling.h"
template<typename ExpandXType, typename XType>
__global__ __aicore__ void combine_a5_mte_nofullmesh(
    GM_ADDR expandX, GM_ADDR expertIds, GM_ADDR assistInfo,
    GM_ADDR epSendCount, GM_ADDR scales, GM_ADDR tpSendCount, GM_ADDR xActiveMask,
    GM_ADDR sharedExpertX, GM_ADDR elasticInfo, GM_ADDR oriX, GM_ADDR constExpertAlpha1,
    GM_ADDR constExpertAlpha2, GM_ADDR constExpertV, GM_ADDR performanceInfo,
    GM_ADDR XOut, GM_ADDR workspaceGM,
    MoeDistributeCombineV2TilingData tilingData);

#include <cstdlib>
#include <cstdio>
#include <cstring>
#include <unistd.h>
#include <hccl/hccl.h>
#include <acl/acl.h>

static int _r() { const char* v = getenv("OMPI_COMM_WORLD_RANK"); return v ? atoi(v) : 0; }
static int _w() { const char* v = getenv("OMPI_COMM_WORLD_SIZE"); return v ? atoi(v) : 1; }

#if !defined(__NPU_ARCH__)
int main() {
    int rank = _r(), world = _w();
    printf("[Combine A5] rank=%d/%d\n", rank, world);

    aclInit(nullptr);
    aclError ret = aclrtSetDevice(rank);
    if (ret) { printf("[Combine A5] aclrtSetDevice(%d) err=%d\n", rank, (int)ret); return -1; }
    aclrtStream stream; aclrtCreateStream(&stream);

    printf("[Combine A5] HCCL init...\n");
    HcclComm hc;
    HcclResult hret = HcclCommInitAll(world, nullptr, &hc);
    if (hret) { printf("[Combine A5] HcclCommInitAll err=%d\n", (int)hret); return -1; }
    printf("[Combine A5] HCCL done.\n");

    uint64_t winSize = 64UL * 1024 * 1024;
    const char* bf = getenv("HCCL_BUFFSIZE");
    if (bf) winSize = (uint64_t)atol(bf);

    const int bs = 4, h = 128, k = 2, moe = 4;
    int gbs = bs * world, a = gbs * k;
    uint32_t cores = 8; uint64_t ub = 32UL * 1024 * 1024;

    GM_ADDR exDev = nullptr;  aclrtMalloc((void**)&exDev, a*h*sizeof(half), ACL_MEM_MALLOC_HUGE_FIRST);
    GM_ADDR eidDev = nullptr; aclrtMalloc((void**)&eidDev, bs*k*sizeof(int32_t), ACL_MEM_MALLOC_HUGE_FIRST);
    GM_ADDR outDev = nullptr; aclrtMalloc((void**)&outDev, bs*h*sizeof(half), ACL_MEM_MALLOC_HUGE_FIRST);
    GM_ADDR wsDev = nullptr;  aclrtMalloc((void**)&wsDev, 64UL*1024*1024, ACL_MEM_MALLOC_HUGE_FIRST);
    GM_ADDR scDev = nullptr;  aclrtMalloc((void**)&scDev, world*sizeof(int32_t), ACL_MEM_MALLOC_HUGE_FIRST);
    GM_ADDR tpDev = nullptr;  aclrtMalloc((void**)&tpDev, sizeof(int32_t), ACL_MEM_MALLOC_HUGE_FIRST);
    GM_ADDR asDev = nullptr;  aclrtMalloc((void**)&asDev, (bs*k) > (a*128) ? (bs*k) : (a*128)*sizeof(int32_t), ACL_MEM_MALLOC_HUGE_FIRST);

    half* hx = new half[a*h]; int32_t* he = new int32_t[bs*k];
    for (int i = 0; i < a*h; i++) { uint16_t u = (uint16_t)((i % 100) | 0x3C00); memcpy(&hx[i], &u, 2); }
    for (int i = 0; i < bs; i++) { he[i*k] = 0; he[i*k+1] = 1; }
    aclrtMemcpy(exDev, a*h*sizeof(half), hx, a*h*sizeof(half), ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(eidDev, bs*k*sizeof(int32_t), he, bs*k*sizeof(int32_t), ACL_MEMCPY_HOST_TO_DEVICE);
    delete[] hx; delete[] he;

    MoeDistributeCombineV2TilingData td;
    memset(&td, 0, sizeof(td));
    td.moeDistributeCombineV2Info.epRankId = (uint32_t)rank;
    td.moeDistributeCombineV2Info.epWorldSize = (uint32_t)world;
    td.moeDistributeCombineV2Info.moeExpertNum = (uint32_t)moe;
    td.moeDistributeCombineV2Info.bs = (uint32_t)bs; td.moeDistributeCombineV2Info.k = (uint32_t)k;
    td.moeDistributeCombineV2Info.h = (uint32_t)h; td.moeDistributeCombineV2Info.a = (uint32_t)a;
    td.moeDistributeCombineV2Info.aivNum = cores; td.moeDistributeCombineV2Info.globalBs = (uint32_t)gbs;
    td.moeDistributeCombineV2Info.totalUbSize = ub;
    td.moeDistributeCombineV2Info.totalWinSizeEp = winSize;

    printf("[Combine A5] Launching...\n");
    combine_a5_mte_nofullmesh<half, half><<<cores, nullptr, stream>>>(
        exDev, eidDev, asDev, scDev, (GM_ADDR)nullptr, tpDev, (GM_ADDR)nullptr,
        (GM_ADDR)nullptr, (GM_ADDR)nullptr, (GM_ADDR)nullptr, (GM_ADDR)nullptr,
        (GM_ADDR)nullptr, (GM_ADDR)nullptr, (GM_ADDR)nullptr, outDev, wsDev, td);
    aclrtSynchronizeStream(stream);
    printf("[Combine A5] Done.\n");

    aclrtFree(exDev); aclrtFree(eidDev); aclrtFree(outDev); aclrtFree(wsDev);
    aclrtFree(scDev); aclrtFree(tpDev); aclrtFree(asDev);
    aclrtDestroyStream(stream); (void)hc;
    aclrtResetDevice(rank); aclFinalize();
    printf("[Combine A5] rank=%d done.\n", rank);
    return 0;
}
#endif
