#include "moe_distribute_dispatch_v2.h"
#include "moe_distribute_dispatch_v2_full_mesh.h"
#include "moe_distribute_dispatch_v2_tiling.h"
#include <type_traits>

using namespace MoeDistributeDispatchV2Impl;
using namespace MoeDistributeDispatchV2FullMeshImpl;
using namespace Mc2Kernel;

template<typename XType, typename ExpandXType>
__global__ __aicore__ void dispatch_a5_mte_nofullmesh(
    GM_ADDR x, GM_ADDR expertIds, GM_ADDR scales, GM_ADDR xActiveMask,
    GM_ADDR elasticInfo, GM_ADDR performanceInfo, GM_ADDR expandXOut,
    GM_ADDR dynamicScalesOut, GM_ADDR assistInfoOut, GM_ADDR expertTokenNumsOut,
    GM_ADDR epSendCountsOut, GM_ADDR tpSendCountsOut, GM_ADDR workspaceGM,
    MoeDistributeDispatchV2TilingData tilingData)
{
#if !defined(__NPU_HOST__)
    using namespace AscendC;
    TPipe pipe;
    int64_t oriMode = GetCtrlSpr<FLOAT_OVERFLOW_MODE_CTRL, FLOAT_OVERFLOW_MODE_CTRL>();
    MoeDistributeDispatchV2<XType, ExpandXType, UNQUANT, false, false> op;
    op.Init(nullptr, x, expertIds, scales, xActiveMask, elasticInfo, performanceInfo,
            expandXOut, dynamicScalesOut, assistInfoOut, expertTokenNumsOut,
            epSendCountsOut, tpSendCountsOut, workspaceGM, &pipe, &tilingData);
    op.Process();
    SetCtrlSpr<FLOAT_OVERFLOW_MODE_CTRL, FLOAT_OVERFLOW_MODE_CTRL>(oriMode);
#endif
}

template<typename XType, typename ExpandXType>
__global__ __aicore__ void dispatch_a5_mte_fullmesh(
    GM_ADDR x, GM_ADDR expertIds, GM_ADDR scales, GM_ADDR xActiveMask,
    GM_ADDR elasticInfo, GM_ADDR performanceInfo, GM_ADDR expandXOut,
    GM_ADDR dynamicScalesOut, GM_ADDR assistInfoOut, GM_ADDR expertTokenNumsOut,
    GM_ADDR epSendCountsOut, GM_ADDR tpSendCountsOut, GM_ADDR workspaceGM,
    MoeDistributeDispatchV2TilingData tilingData)
{
#if !defined(__NPU_HOST__)
    using namespace AscendC;
    TPipe pipe;
    int64_t oriMode = GetCtrlSpr<FLOAT_OVERFLOW_MODE_CTRL, FLOAT_OVERFLOW_MODE_CTRL>();
    MoeDistributeDispatchV2FullMesh<XType, ExpandXType, UNQUANT, false, false> op;
    op.Init(nullptr, x, expertIds, scales, xActiveMask, elasticInfo, performanceInfo,
            expandXOut, dynamicScalesOut, assistInfoOut, expertTokenNumsOut,
            epSendCountsOut, tpSendCountsOut, workspaceGM, &pipe, &tilingData);
    op.Process();
    SetCtrlSpr<FLOAT_OVERFLOW_MODE_CTRL, FLOAT_OVERFLOW_MODE_CTRL>(oriMode);
#endif
}

template __global__ __aicore__ void dispatch_a5_mte_nofullmesh<half, half>(GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, MoeDistributeDispatchV2TilingData);
template __global__ __aicore__ void dispatch_a5_mte_fullmesh<half, half>(GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, MoeDistributeDispatchV2TilingData);
template __global__ __aicore__ void dispatch_a5_mte_nofullmesh<bfloat16_t, bfloat16_t>(GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, MoeDistributeDispatchV2TilingData);
