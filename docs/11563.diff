+fi
+if [ -f perf_golden.xlsx ]; then
+    report_args+=(--is_compare True)
+else
+    echo "perf_golden.xlsx不存在，仅生成性能报告，不进行基线对比。"
+fi
+python3 process_perf_data.py "${report_args[@]}"
+exit "$test_status"
