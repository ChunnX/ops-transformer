  ├─ #1  Python: c_temp1 = c_temp1.to(torch.float32)
  │   匹配: Cast(int32→fp32)
  │   SSA: load %0_in ← workspace; Cast(%1_alc, %0_in, CAST_NONE, chunk*N)
  │
  ├─ #2  Python: c_temp2 = c_temp1 * perChannelScale  (broadcast [N]→[chunk,N])
  │   匹配: Mul
  │   SSA: Mul(%2_alc, %1_alc, weightScale_alc, chunk*N)
  │
  ├─ #3  Python: c_temp3 = c_temp2 * perTokenScale.reshape(m,1)  (broadcast [chunk]→[chunk,N])
  │   匹配: Muls (per-row scalar mul, 循环 chunkSize 行)
  │   SSA: for row: Muls(row_ptr, row_ptr, xScale[row], N)
  │
  ├─ #4  Python: c_temp4, gate = c_temp3.chunk(2, dim=-1)  (view, no compute)
  │   SSA: left = view(%2_alc, offset=0, size=chunk*N/2)
  │        gate = view(%2_alc, offset=chunk*N/2, size=chunk*N/2)
  │
  ├─ #5  Python: c_temp5 = c_temp4 * sigmoid(c_temp4)  (SiLU)
  │   匹配: Sigmoid + Mul
  │   SSA: Sigmoid(%5_alc, left, chunk*N/2); Mul(%6_alc, left, %5_alc, chunk*N/2)
  │
  ├─ #6  Python: c_temp6 = c_temp5 * gate
  │   匹配: Mul
  │   SSA: Mul(%7_alc, %6_alc, gate, chunk*N/2)
  │
  ├─ #7  Python: abs_max = torch.max(torch.abs(c_temp6), -1).values  (reduce N/2)
  │   匹配: Abs + ReduceMax
  │   SSA: Abs(%8_alc, %7_alc, chunk*N/2); ReduceMax(%9_alc, %8_alc, tmp, chunk, N/2)
  │
  ├─ #8  Python: quantScale = 127.0 / abs_max
  │   匹配: Reciprocal + Muls(127.0)
  │   SSA: Reciprocal(%9_alc, %9_alc, chunk); Muls(%9_alc, %9_alc, 127.0, chunk)
