# Step 2 输出: 骨架代码 + 指令占位

skeleton_config:
  primitive: "E:{matM:[matN:[C0]->matM_i:[V0]]}"

  sync_schedule:
    - name: "SYNC_S0_L1_C2V_0"
      direction: "C2V"
      timing: "per M-block"
      context: "Stage 0 (C0) 所有 N-tile 完成 → 通知 Stage 1 (V0)"
      between: ["C0", "V0"]
      set_flag_side: "AIC"
      wait_flag_side: "AIV"
      note: "N-axis barrier: 同一 M-block 的所有 numNCores AIC 核完成后触发"

  instruction_placeholders:
    S0_C0Process:
      - op: "Cube matmul int8×int8→int32"
        type: "Matmul API"
        in: "x_slice [GM, singleM×K, int8], weight_i [GM, K×N, int8, tensorList]"
        out: "C0_output [workspace GM, singleM×singleN, int32]"
        note: "isTransposeB=true, has_bias=false, 沿 N 轴多核切分(nIdx)"
      - op: "N-tile write to workspace"
        type: "DataCopy (implicit in Matmul API)"
        in: "C0_output"
        out: "workspace offset by (mIdx, nIdx)"

    S0_V0Process:
      - op: "Read matmul result from workspace"
        type: "DataCopy (load)"
        in: "C0_output [workspace, chunk×N, int32]"
        out: "int32_buf [UB]"
      - op: "Cast int32→fp32"
        type: "Cast"
        in: "int32_buf [UB]"
        out: "fp32_buf [UB]"
      - op: "Load perChannelScale and broadcast"
        type: "DataCopy + Duplicate (broadcast)"
        in: "weightScale_i [GM, N, fp32, tensorList]"
        out: "weightScale_ub [UB]"
      - op: "Dequant step1: mul perChannelScale"
        type: "Mul"
        in: "fp32_buf [UB], weightScale_ub [UB, broadcast N→chunk×N]"
        out: "dequant1_buf [UB]"
      - op: "Load perTokenScale slice"
        type: "DataCopy (load)"
        in: "xScale_slice [GM, chunk, fp32]"
        out: "xScale_ub [UB]"
      - op: "Dequant step2: mul perTokenScale"
        type: "Mul"
        in: "dequant1_buf [UB], xScale_ub [UB, broadcast chunk×1→chunk×N]"
        out: "dequant2_buf [UB, chunk×N]"
      - op: "SwiGLU: chunk N→N/2 split"
        type: "memory view (no compute)"
        in: "dequant2_buf [UB, chunk×N]"
        out: "left_half [UB, chunk×N/2], gate [UB, chunk×N/2]"
      - op: "SwiGLU: sigmoid(left)"
        type: "Sigmoid"
        in: "left_half [UB]"
        out: "sigmoid_buf [UB, chunk×N/2]"
      - op: "SwiGLU: SiLU = left * sigmoid(left)"
        type: "Mul"
        in: "left_half [UB], sigmoid_buf [UB]"
        out: "silu_buf [UB, chunk×N/2]"
      - op: "SwiGLU: result = SiLU * gate"
        type: "Mul"
        in: "silu_buf [UB], gate [UB]"
        out: "swiglu_buf [UB, chunk×N/2]"
      - op: "Dynamic quant: abs + max reduce"
        type: "Abs + ReduceMax"
        in: "swiglu_buf [UB, chunk×N/2]"
        out: "absmax_buf [UB, chunk]"
        note: "reduce along last dim (N/2)"
      - op: "Dynamic quant: scale = 127.0 / absmax"
        type: "Divs (scalar div)"
        in: "absmax_buf [UB, chunk]"
        out: "quantScale_ub [UB, chunk]"
      - op: "Dynamic quant: round(swiglu * scale)"
        type: "Mul + Round"
        in: "swiglu_buf [UB, chunk×N/2], quantScale_ub [UB, broadcast chunk→chunk×N/2]"
        out: "rounded_buf [UB, chunk×N/2]"
      - op: "Cast fp32→int8"
        type: "Cast"
        in: "rounded_buf [UB]"
        out: "quantOutput_ub [UB, int8]"
      - op: "Store quantOutput to GM"
        type: "DataCopy (store)"
        in: "quantOutput_ub [UB, int8]"
        out: "quantOutput [GM]"
      - op: "Compute dequantScale = 1.0 / quantScale"
        type: "Divs (scalar div)"
        in: "quantScale_ub [UB, chunk]"
        out: "dequantScale_ub [UB, chunk]"
      - op: "Store quantScaleOutput to GM"
        type: "DataCopy (store)"
        in: "dequantScale_ub [UB, fp32]"
        out: "quantScaleOutput [GM]"

  vec_chunk:
    enabled: true
    applies_to: ["S0_V0Process"]
    chunk_size: 2
    axis: "matM_i"
