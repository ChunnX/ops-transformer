# clangd configuration for ops-transformer (CANN AscendC project)
# 文档: https://clangd.llvm.org/config.html

CompileFlags:
  # 当 compile_commands.json 不可用时,使用 clang++ 作为后备编译器
  Compiler: clang++

  # CANN kernel 代码使用的编译器扩展关键字,需定义为空宏让 clangd 正确解析
  Add:
    - -xc++
    - -std=c++17
    - -D__gm__=
    - -D__aicore__=
    - -D__global__=
    - -D__CCE_AICORE__=200
    - -D__DAV_2201__
    - -DASCEND_IS_AIV=1
    - -DASCEND_IS_AIC=0
    - -DKERNEL_TASK_TYPE_DEFAULT(x)=
    - -DORIG_DTYPE_QUERY=DT_FLOAT16
    - -DORIG_DTYPE_KEY=DT_FLOAT16
    - -Wno-unknown-pragmas
    - -Wno-unused-parameter
    - -Wno-unused-variable
    - -Wno-unused-function
    - -Wno-missing-field-initializers

  # 移除 bisheng/ccec 编译器特有的、clang 不认识的 flag
  Remove:
    - -fno-rtti
    - -fbsymbol-as-assembly
    - -fopaque-pointer

Diagnostics:
  # clangd 无法完全理解 CANN 编译器扩展,抑制部分噪声
  Suppress:
    - "unknown_type_name"
    - "expected ';' after expression"
  ClangTidy:
    Remove:
      - modernize-use-trailing-return-type
      - readability-identifier-length
      - bugprone-narrowing-conversions
      - cppcoreguidelines-avoid-magic-numbers
      - readability-magic-numbers

InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes
  Designators: Yes
  BlockEnd: Yes

Hover:
  ShowAKA: Yes

Index:
  # 启用项目级索引,支持跨文件跳转
  Background: Build
  ExternalMarkers: No
  StandardLibrary: Yes
