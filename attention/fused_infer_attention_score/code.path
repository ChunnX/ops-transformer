diff --git a/attention/common/op_kernel/CopyInL1.h b/attention/common/op_kernel/CopyInL1.h
index 8c533c761..04e120a88 100644
--- a/attention/common/op_kernel/CopyInL1.h
+++ b/attention/common/op_kernel/CopyInL1.h
@@ -268,13 +268,13 @@ __aicore__ inline void GmCopyInToL1HasRopePA(LocalTensor<L1Type> &nopeTensor, Lo
             DataCopyGmNZToL1(tmpNopeDstTensor, tmpNopeSrcTensor, copyRowCnt, (shape.copyRowNumAlign - copyRowCnt),
                              (shape.blockSize - copyRowCnt), shape.actHeadDim);
 
-            LocalTensor<L1Type> tmpRopeDstTensor = ropeTensor[copyFinishRowCnt * blockElementCnt];
             GlobalTensor<L1Type> tmpRopeSrcTensor = ropeGmTensor[keyRopeOffset];
+            LocalTensor<L1Type> tmpRopeDstTensor = ropeTensor[copyFinishRowCnt * blockElementCnt];
             DataCopyGmNZToL1(tmpRopeDstTensor, tmpRopeSrcTensor, copyRowCnt, (ropeShape.copyRowNumAlign - copyRowCnt),
                              (ropeShape.blockSize - copyRowCnt), ropeShape.actHeadDim);
         } else {
-            uint64_t dStride = shape.headDim;
             uint64_t dRopeStride = ropeShape.headDim;
+            uint64_t dStride = shape.headDim;
             if (kvLayout == KVLAYOUT::BBH) {
                 offset += static_cast<uint64_t>(startPos.n2Idx * shape.headDim) +
                           remainRowCnt * shape.headDim * shape.headNum + startPos.dIdx;
@@ -400,8 +400,8 @@ __aicore__ inline void GmScaleCopyInToL1PAForND(LocalTensor<L1Type> &l1Tensor, G
         if (kvLayout == KVLAYOUT::NZ) {
             offset += static_cast<uint64_t>(startPos.n2Idx * shape.blockSize * shape.headDim) +
                       remainRowCnt * blockElementCnt + startPos.dIdx * shape.blockSize;
-            LocalTensor<L1Type> tmpNopeDstTensor = l1Tensor[copyFinishRowCnt * blockElementCnt];
             GlobalTensor<L1Type> tmpNopeSrcTensor = gmTensor[offset];
+            LocalTensor<L1Type> tmpNopeDstTensor = l1Tensor[copyFinishRowCnt * blockElementCnt];
             DataCopyGmNZToL1(tmpNopeDstTensor, tmpNopeSrcTensor, copyRowCnt, (shape.copyRowNumAlign - copyRowCnt),
                              (shape.blockSize - copyRowCnt), shape.actHeadDim);
         } else {
@@ -446,8 +446,8 @@ __aicore__ inline void GmScaleCopyInToL1PAForDN(LocalTensor<L1Type> &l1Tensor, G
         if (kvLayout == KVLAYOUT::NZ) {
             offset += static_cast<uint64_t>(startPos.n2Idx * shape.blockSize * shape.headDim) +
                       remainRowCnt * blockElementCnt + startPos.dIdx * shape.blockSize;
-            LocalTensor<L1Type> tmpNopeDstTensor = l1Tensor[copyFinishRowCnts * blockElementCnt];
             GlobalTensor<L1Type> tmpNopeSrcTensor = gmTensor[offset];
+            LocalTensor<L1Type> tmpNopeDstTensor = l1Tensor[copyFinishRowCnts * blockElementCnt];
             DataCopyGmNZToL1(tmpNopeDstTensor, tmpNopeSrcTensor, copyRowCnt, (shape.copyRowNumAlign - copyRowCnt),
                              (shape.blockSize - copyRowCnt), shape.actHeadDim);
         } else {
@@ -460,8 +460,8 @@ __aicore__ inline void GmScaleCopyInToL1PAForDN(LocalTensor<L1Type> &l1Tensor, G
                 offset += static_cast<uint64_t>(startPos.n2Idx * shape.headDim * shape.blockSize) +
                           remainRowCnt * shape.headDim + startPos.dIdx;
             }
-            uint32_t dValue = shape.actHeadDim;
             uint32_t srcDValue = dStride;
+            uint32_t dValue = shape.actHeadDim;
             LocalTensor<L1Type> tmpNopeDstTensor = l1Tensor[copyFinishRowCnts * blockElementCnt];
             GlobalTensor<L1Type> tmpNopeSrcTensor = gmTensor[offset];
             DataCopyGmScaleDNToL1(tmpNopeDstTensor, tmpNopeSrcTensor, copyRowCnt, copyRowCnt, dValue, srcDValue);
diff --git a/attention/common/op_kernel/arch35/vf/vf_basic_block_aligned128_no_update_mx.h b/attention/common/op_kernel/arch35/vf/vf_basic_block_aligned128_no_update_mx.h
index cd0237ef6..9dcf26a73 100644
--- a/attention/common/op_kernel/arch35/vf/vf_basic_block_aligned128_no_update_mx.h
+++ b/attention/common/op_kernel/arch35/vf/vf_basic_block_aligned128_no_update_mx.h
@@ -374,7 +374,7 @@ __simd_vf__ void ProcessVec1NoUpdateImpl128Mxfp8FullquantVFSubloop1(
     RegTensor<float> vreg_sel_drop2;
     RegTensor<float> vreg_rowmax_p;
     RegTensor<float> vreg_scale_qk;
-    RegTensor<float> vreg_sink_input;
+    RegTensor<float> vreg_sink_input_algnou1;
     // mxfp8
     RegTensor<bfloat16_t> vreg_p_scale_bf16_0;
     RegTensor<bfloat16_t> vreg_p_scale_bf16_1;
@@ -421,7 +421,7 @@ __simd_vf__ void ProcessVec1NoUpdateImpl128Mxfp8FullquantVFSubloop1(
     MaskReg preg4;
     MaskReg preg5;
     if constexpr (hasSink) {
-        Duplicate(vreg_sink_input, sinkValue);
+        Duplicate(vreg_sink_input_algnou1, sinkValue);
     }
     // MASK
     Duplicate(vreg_min, minValue);
@@ -513,7 +513,7 @@ __simd_vf__ void ProcessVec1NoUpdateImpl128Mxfp8FullquantVFSubloop1(
         }
         Reduce<Reg::ReduceType::MAX, float, float, Reg::MaskMergeMode::ZEROING>(vreg_input_max, vreg_max_tmp, preg_all);
         if constexpr (hasSink) {
-            Max(vreg_input_max, vreg_input_max, vreg_sink_input, preg_all);
+            Max(vreg_input_max, vreg_input_max, vreg_sink_input_algnou1, preg_all);
         }
         Muls(vreg_input_max, vreg_input_max, INV_LN2, preg_all);
         Truncate<T, RoundMode::CAST_CEIL>(vreg_input_max, vreg_input_max, preg_all);
diff --git a/attention/common/op_kernel/arch35/vf/vf_basic_block_aligned128_update_mx.h b/attention/common/op_kernel/arch35/vf/vf_basic_block_aligned128_update_mx.h
index a26531279..6012a88d3 100644
--- a/attention/common/op_kernel/arch35/vf/vf_basic_block_aligned128_update_mx.h
+++ b/attention/common/op_kernel/arch35/vf/vf_basic_block_aligned128_update_mx.h
