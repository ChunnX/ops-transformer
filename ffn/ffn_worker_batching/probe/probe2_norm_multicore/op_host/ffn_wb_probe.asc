// ============================================================================
// 迭代一 穿刺2 (probe2_norm_multicore) — Host + main 入口
// 多核 sort -> MrgSort 4 路归并 -> 核间 gather/group_listing 分工
// 目标平台: Ascend950DT_9584 (arch35 / DAV_3510)
//
// 3 次核函数启动，用 aclrtSynchronizeStream 做核间栅栏:
//   A) ffn_wb_probe_sort   blockNum = SORT_CORE_NUM
//   B) ffn_wb_probe_merge  blockNum = 1
//   C) ffn_wb_probe_divide blockNum = GATHER_CORE + GROUP_CORE
// ============================================================================

#include <cstdint>
#include <iostream>
#include <vector>
#include <string>
#include "acl/acl.h"
#include "../op_kernel/ffn_wb_probe_tiling.h"
#include "data_utils.h"

#include "../op_kernel/ffn_wb_probe_kernel.asc"

#define CHECK_ACL(x)                                                                 \
    do {                                                                             \
        aclError __ret = (x);                                                        \
        if (__ret != ACL_SUCCESS) {                                                  \
            printf("[ACL ERROR] %s ret=%d line=%d\n", #x, (int)__ret, __LINE__);     \
            return -1;                                                               \
        }                                                                            \
    } while (0)

// ---- 固定 shape 参数 (穿刺配置) ----
static constexpr int32_t Y = 4096;             // 全部 token 数
static constexpr int32_t PER_CORE = 1024;      // 每个 sort 核 tile (32 对齐)
static constexpr int32_t SORT_CORE_NUM = 4;    // 多核 sort + 4 路 MrgSort 归并
static constexpr int32_t EXPERT_NUM = 128;
static constexpr int32_t H = 64;               // hidden dim
static constexpr int32_t ONE_LOOP_MAX_MRG = 1024;
static constexpr int32_t GATHER_CORE_NUM = 4;
static constexpr int32_t GROUP_CORE_NUM = 4;

struct DevBuf {
    uint8_t *dev = nullptr;
    uint8_t *host = nullptr;
    size_t bytes = 0;
};

static int32_t AllocInput(DevBuf &b, size_t bytes, const std::string &file)
{
    b.bytes = bytes;
    CHECK_ACL(aclrtMallocHost((void **)&b.host, bytes));
    CHECK_ACL(aclrtMalloc((void **)&b.dev, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    if (!ReadFile(file, bytes, b.host, bytes)) {
        printf("[ERROR] ReadFile failed: %s (%zu bytes)\n", file.c_str(), bytes);
        return -1;
    }
    CHECK_ACL(aclrtMemcpy(b.dev, bytes, b.host, bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    return 0;
}

static int32_t AllocOutput(DevBuf &b, size_t bytes, bool zeroInit = false)
{
    b.bytes = bytes;
    CHECK_ACL(aclrtMallocHost((void **)&b.host, bytes));
    CHECK_ACL(aclrtMalloc((void **)&b.dev, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    if (zeroInit) {
        CHECK_ACL(aclrtMemset(b.dev, bytes, 0, bytes));
    }
    return 0;
}

static int32_t DumpOutput(DevBuf &b, const std::string &file)
{
    CHECK_ACL(aclrtMemcpy(b.host, b.bytes, b.dev, b.bytes, ACL_MEMCPY_DEVICE_TO_HOST));
    if (!WriteFile(file, b.host, b.bytes)) {
        printf("[ERROR] WriteFile failed: %s\n", file.c_str());
        return -1;
    }
    return 0;
}

int32_t main(int32_t argc, char *argv[])
{
    CHECK_ACL(aclInit(nullptr));
    int32_t deviceId = 0;
    CHECK_ACL(aclrtSetDevice(deviceId));
    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));

    // ---- Tiling ----
    ProbeTilingData tiling;
    tiling.totalLength = Y;
    tiling.perCoreElements = PER_CORE;
    tiling.sortCoreNum = SORT_CORE_NUM;
    tiling.expertNum = EXPERT_NUM;
    tiling.hiddenSize = H;
    tiling.oneLoopMaxElementsMrg = ONE_LOOP_MAX_MRG;
    tiling.gatherCoreNum = GATHER_CORE_NUM;
    tiling.groupCoreNum = GROUP_CORE_NUM;
    tiling.sortNum = ((PER_CORE + 31) / 32) * 32;

    uint8_t *tilingDev = nullptr;
    CHECK_ACL(aclrtMalloc((void **)&tilingDev, sizeof(ProbeTilingData), ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemcpy(tilingDev, sizeof(ProbeTilingData), &tiling, sizeof(ProbeTilingData),
                          ACL_MEMCPY_HOST_TO_DEVICE));

    // ---- Workspace (sort proposal: 4 路 × 2*PER_CORE float) ----
    size_t wsBytes = (size_t)SORT_CORE_NUM * (2 * PER_CORE) * sizeof(float) * 2; // ×2 冗余
    uint8_t *wsDev = nullptr;
    CHECK_ACL(aclrtMalloc((void **)&wsDev, wsBytes, ACL_MEM_MALLOC_HUGE_FIRST));

    // ---- Inputs ----
    DevBuf expertIds, tokenData, sessSrc, microSrc, tokSrc;
    if (AllocInput(expertIds, (size_t)Y * sizeof(int32_t), "./input/expert_ids.bin") != 0) return -1;
    if (AllocInput(tokenData, (size_t)Y * H * sizeof(uint16_t), "./input/token_data.bin") != 0) return -1;
    if (AllocInput(sessSrc, (size_t)Y * sizeof(int32_t), "./input/session_src.bin") != 0) return -1;
    if (AllocInput(microSrc, (size_t)Y * sizeof(int32_t), "./input/micro_batch_src.bin") != 0) return -1;
    if (AllocInput(tokSrc, (size_t)Y * sizeof(int32_t), "./input/token_src.bin") != 0) return -1;

    // ---- Outputs ----
    DevBuf sortedExp, gatherIdx, yOut, sessOut, microOut, tokOut, groupCount, actualNum;
    if (AllocOutput(sortedExp, (size_t)Y * sizeof(int32_t)) != 0) return -1;
    if (AllocOutput(gatherIdx, (size_t)Y * sizeof(int32_t)) != 0) return -1;
    if (AllocOutput(yOut, (size_t)Y * H * sizeof(uint16_t)) != 0) return -1;
    if (AllocOutput(sessOut, (size_t)Y * sizeof(int32_t)) != 0) return -1;
    if (AllocOutput(microOut, (size_t)Y * sizeof(int32_t)) != 0) return -1;
    if (AllocOutput(tokOut, (size_t)Y * sizeof(int32_t)) != 0) return -1;
    if (AllocOutput(groupCount, (size_t)EXPERT_NUM * sizeof(int32_t), /*zeroInit=*/true) != 0) return -1;
    if (AllocOutput(actualNum, (size_t)1 * sizeof(int32_t)) != 0) return -1;

    // ==== Stage A: 多核 sort ====
    ffn_wb_probe_sort<<<SORT_CORE_NUM, nullptr, stream>>>(expertIds.dev, wsDev, tilingDev);
    CHECK_ACL(aclrtSynchronizeStream(stream));

    // [DEBUG] dump workspace proposals after sort
    if (getenv("PROBE_DUMP_WS")) {
        uint8_t *wsHost = nullptr;
        CHECK_ACL(aclrtMallocHost((void **)&wsHost, wsBytes));
        CHECK_ACL(aclrtMemcpy(wsHost, wsBytes, wsDev, wsBytes, ACL_MEMCPY_DEVICE_TO_HOST));
        WriteFile("./output/ws_after_sort.bin", wsHost, wsBytes);
        aclrtFreeHost(wsHost);
    }

    // ==== Stage B: MrgSort 4 路归并 ====
    ffn_wb_probe_merge<<<1, nullptr, stream>>>(wsDev, sortedExp.dev, gatherIdx.dev, tilingDev);
    CHECK_ACL(aclrtSynchronizeStream(stream));

    // ==== Stage C: 核间 gather / group_listing 分工 ====
    uint32_t divideBlocks = GATHER_CORE_NUM + GROUP_CORE_NUM;
    ffn_wb_probe_divide<<<divideBlocks, nullptr, stream>>>(
        sortedExp.dev, gatherIdx.dev, tokenData.dev, sessSrc.dev, microSrc.dev, tokSrc.dev, yOut.dev, sessOut.dev,
        microOut.dev, tokOut.dev, groupCount.dev, actualNum.dev, tilingDev);
    CHECK_ACL(aclrtSynchronizeStream(stream));

    // ---- Dump outputs ----
    int32_t rc = 0;
    rc |= DumpOutput(sortedExp, "./output/sorted_expert_ids.bin");
    rc |= DumpOutput(gatherIdx, "./output/gather_idx.bin");
    rc |= DumpOutput(yOut, "./output/y.bin");
    rc |= DumpOutput(sessOut, "./output/session_ids.bin");
    rc |= DumpOutput(microOut, "./output/micro_batch_ids.bin");
    rc |= DumpOutput(tokOut, "./output/token_ids.bin");
    rc |= DumpOutput(groupCount, "./output/group_count.bin");
    rc |= DumpOutput(actualNum, "./output/actual_token_num.bin");
    if (rc != 0) return -1;

    // ---- cleanup ----
    aclrtFree(tilingDev);
    aclrtFree(wsDev);
    for (DevBuf *b : {&expertIds, &tokenData, &sessSrc, &microSrc, &tokSrc, &sortedExp, &gatherIdx, &yOut, &sessOut,
                      &microOut, &tokOut, &groupCount, &actualNum}) {
        aclrtFree(b->dev);
        aclrtFreeHost(b->host);
    }
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    printf("[probe2] all 3 stages finished on NPU.\n");
    return 0;
}
