/*!
 * \file ffn_wb_probe_kernel.asc
 * \brief 迭代一 穿刺2 (probe2_norm_multicore) — arch35 / DAV_3510 多核 sort + MrgSort 4 路归并
 *        + 核间 gather/group_listing 分工 穿刺 kernel。
 *
 * 采用经典 SIMD/MemBase 原语 (Sort<float,true> / MrgSort<float,true> / Extract /
 * ArithProgression / DataCopyPad / SetAtomicAdd)，与 moe_init_routing_v3/arch35 同族，
 * 已在 DAV_3510 实证可用。本穿刺全 token 有效 (不含 mask，mask 走 arch35 Select 另行验证)，
 * 聚焦 Sort/MrgSort 元素上限 + 4 路归并 + 分工。
 *
 * 3 个核函数 (host 侧用 aclrtSynchronizeStream 做核间栅栏):
 *   ffn_wb_probe_sort   : 多核 sort   (SORT_CORE_NUM 核，各排一个 tile -> proposal 落 workspace)
 *   ffn_wb_probe_merge  : MrgSort 归并 (1 核 4 路 MrgSort -> sorted_expert_ids + gather_idx)
 *   ffn_wb_probe_divide : 核间分工     (gather 核: y/session/micro/token ; group 核: group_count)
 */

#include "kernel_operator.h"
#include "ffn_wb_probe_tiling.h"

using namespace AscendC;

namespace FfnWbProbe {

// ------------------------------- 通用 helper -------------------------------
__aicore__ inline int64_t CeilDiv(int64_t a, int64_t b)
{
    return (b == 0) ? 0 : (a + b - 1) / b;
}

__aicore__ inline int64_t AlignElem(int64_t elementNum, int64_t bytes)
{
    // 把 elementNum 个 bytes 字节元素按 32B 向上取整后的元素个数
    return (bytes == 0) ? 0 : (elementNum * bytes + 31) / 32 * 32 / bytes;
}

template <typename T>
__aicore__ inline T MinV(T a, T b)
{
    return a > b ? b : a;
}

template <HardEvent event>
__aicore__ inline void SyncFlag(HardEvent evt)
{
    event_t eventId = static_cast<event_t>(GetTPipePtr()->FetchEventID(evt));
    SetFlag<event>(eventId);
    WaitFlag<event>(eventId);
}

// ======================================================================
// Stage A: 多核 sort — 每个核对自己的 tile 做 Sort<float,true>，proposal 落 workspace
// ======================================================================
class ProbeSortTile {
public:
    __aicore__ inline ProbeSortTile() {}
    __aicore__ inline void Init(GM_ADDR expert_ids, GM_ADDR workspace, const __gm__ ProbeTilingData *tiling,
                                TPipe *pipe)
    {
        pipe_ = pipe;
        blockIdx_ = GetBlockIdx();
        perCore_ = tiling->perCoreElements;
        sortNum_ = tiling->sortNum;

        expertIdsGm_.SetGlobalBuffer((__gm__ int32_t *)expert_ids + blockIdx_ * perCore_, perCore_);
        wsProposalGm_.SetGlobalBuffer((__gm__ float *)workspace + blockIdx_ * GetSortLen<float>(perCore_),
                                      GetSortLen<float>(perCore_));

        int64_t kv = 2;
        int64_t buffSize = sortNum_ * sizeof(int32_t) * kv;
        pipe_->InitBuffer(inQueue_, 1, buffSize);
        pipe_->InitBuffer(outQueue_, 1, buffSize);
        pipe_->InitBuffer(tmpBuf_, buffSize);
    }

    __aicore__ inline void Process()
    {
        // --- CopyIn ---
        LocalTensor<int32_t> inLocal = inQueue_.AllocTensor<int32_t>();
        DataCopyExtParams cpParams{static_cast<uint16_t>(1), static_cast<uint32_t>(perCore_ * sizeof(int32_t)), 0, 0, 0};
        DataCopyPadExtParams<int32_t> padParams{false, 0, 0, 0};
        DataCopyPad(inLocal[0], expertIdsGm_, cpParams, padParams);
        LocalTensor<int32_t> rowIds = inLocal[sortNum_];
        ArithProgression<int32_t>(rowIds, static_cast<int32_t>(blockIdx_ * perCore_), 1, perCore_);
        inQueue_.EnQue(inLocal);

        // --- Compute: Cast -> negate -> Sort<float,true> ---
        inLocal = inQueue_.DeQue<int32_t>();
        LocalTensor<float> vals = inLocal[0].ReinterpretCast<float>();
        Cast(vals, inLocal[0], RoundMode::CAST_ROUND, sortNum_);
        PipeBarrier<PIPE_V>();
        // 取负：Sort<float,true> 为降序，负 expert 降序 = expert 升序 (聚合到专家序)
        Muls(vals, vals, static_cast<float>(-1), sortNum_);
        PipeBarrier<PIPE_V>();

        LocalTensor<float> tmp = tmpBuf_.Get<float>(GetSortLen<float>(sortNum_));
        LocalTensor<uint32_t> rowIdsU = inLocal[sortNum_].ReinterpretCast<uint32_t>();
        LocalTensor<float> outProposal = outQueue_.AllocTensor<float>();
        Sort<float, true>(outProposal, vals, rowIdsU, tmp, sortNum_ / ONE_REPEAT_SORT_NUM);
        outQueue_.EnQue<float>(outProposal);
        inQueue_.FreeTensor(inLocal);

        // --- CopyOut proposal -> workspace ---
        outProposal = outQueue_.DeQue<float>();
        DataCopy(wsProposalGm_, outProposal, GetSortLen<float>(perCore_));
        outQueue_.FreeTensor(outProposal);
    }

private:
    TPipe *pipe_;
    TQue<QuePosition::VECIN, 1> inQueue_;
    TQue<QuePosition::VECOUT, 1> outQueue_;
    TBuf<TPosition::VECCALC> tmpBuf_;
    GlobalTensor<int32_t> expertIdsGm_;
    GlobalTensor<float> wsProposalGm_;
    int64_t blockIdx_ = 0;
    int64_t perCore_ = 0;
    int64_t sortNum_ = 0;
};

// ======================================================================
// Stage B: MrgSort 4 路归并 (单核) — 读 4 个 proposal 列表，MrgSort<float,true> 合并，
//          Extract -> sorted_expert_ids + gather_idx。对齐 moe_v3_mrgsort_out.h
// ======================================================================
class ProbeMerge {
public:
    __aicore__ inline ProbeMerge() {}
    __aicore__ inline void Init(GM_ADDR workspace, GM_ADDR sorted_expert_ids, GM_ADDR gather_idx,
                                const __gm__ ProbeTilingData *tiling, TPipe *pipe)
    {
        pipe_ = pipe;
        listNum_ = tiling->sortCoreNum;         // = 4
        perList_ = tiling->perCoreElements;     // 每路元素数
        oneLoopMax_ = tiling->oneLoopMaxElementsMrg;

        for (int64_t i = 0; i < listNum_; i++) {
            // 所有列表共用同一 workspace 基址，用 offsets_ 区分 (对齐 moe_v3_mrgsort_out.h)；
            // 每列表起始 = GetSortOffset(perList*i)，故 gmInputs_[i] 必须是基址，切勿再叠加 per-list 偏移。
            gmInputs_[i].SetGlobalBuffer((__gm__ float *)workspace, GetSortLen<float>(perList_) * listNum_);
        }
        gmOut1_.SetGlobalBuffer((__gm__ int32_t *)sorted_expert_ids, tiling->totalLength);
        gmOut2_.SetGlobalBuffer((__gm__ int32_t *)gather_idx, tiling->totalLength);

        int64_t inBuf = GetSortLen<float>(oneLoopMax_) * MAX_MRGSORT_LIST * sizeof(float);   // 4 路输入
        int64_t outBuf = oneLoopMax_ * MAX_MRGSORT_LIST * sizeof(float) * 2;                 // extract 双输出
        int64_t tmpBuf = GetSortLen<float>(oneLoopMax_) * MAX_MRGSORT_LIST * sizeof(float);  // merged proposal
        pipe_->InitBuffer(inQueue_, 1, inBuf);
        pipe_->InitBuffer(outQueue_, 1, outBuf);
        pipe_->InitBuffer(tmpBuf_, tmpBuf);
    }

    __aicore__ inline void Process()
    {
        allRemain_ = 0;
        for (int64_t i = 0; i < listNum_; i++) {
            offsets_[i] = GetSortOffset<float>(perList_ * i);
            listRemain_[i] = perList_;
            allRemain_ += perList_;
        }
        outOffset_ = 0;

        LocalTensor<float> inLocal = inQueue_.AllocTensor<float>();
        LocalTensor<float> outLocal = outQueue_.AllocTensor<float>();
        LocalTensor<float> tempTensor = tmpBuf_.Get<float>(GetSortLen<float>(oneLoopMax_) * MAX_MRGSORT_LIST);
        ubOut1_ = outLocal;                                                   // extract value
        ubOut2_ = outLocal[oneLoopMax_ * MAX_MRGSORT_LIST].ReinterpretCast<uint32_t>(); // extract index
        ubOutInt1_ = outLocal.ReinterpretCast<int32_t>();
        ubOutInt2_ = outLocal[oneLoopMax_ * MAX_MRGSORT_LIST].ReinterpretCast<int32_t>();

        for (; allRemain_ > 0;) {
            // CopyIn
            remainListNum_ = 0;
            SyncFlag<HardEvent::MTE3_MTE2>(HardEvent::MTE3_MTE2);
            for (int64_t i = 0, j = 0; i < listNum_; i++) {
                lengths_[i] = MinV<int64_t>(oneLoopMax_, listRemain_[i]);
                if (lengths_[i] > 0) {
                    LocalTensor<float> dst = inLocal[GetSortLen<float>(oneLoopMax_) * i];
                    DataCopy(dst, gmInputs_[i][offsets_[i]], AlignElem(GetSortLen<float>(lengths_[i]), sizeof(float)));
                    tmpUbInputs_[j] = dst;
                    elementCountList_[j] = static_cast<uint16_t>(lengths_[i]);
                    remainListNum_++;
                    j++;
                }
            }
            // UpdateMrgParam
            uint16_t validBit = 0b0001;
            if (remainListNum_ == MERGE_LIST_TWO) {
                elementCountList_[MERGE_LIST_IDX_TWO] = 0;
                elementCountList_[MERGE_LIST_IDX_THREE] = 0;
                validBit = 0b0011;
            } else if (remainListNum_ == MERGE_LIST_THREE) {
                elementCountList_[MERGE_LIST_IDX_THREE] = 0;
                validBit = 0b0111;
            } else if (remainListNum_ == MERGE_LIST_FOUR) {
                validBit = 0b1111;
            }
            // MrgsortCompute
            SyncFlag<HardEvent::MTE2_V>(HardEvent::MTE2_V);
            if (remainListNum_ == MERGE_LIST_TWO) {
                MrgSortSrcList lst = MrgSortSrcList(tmpUbInputs_[0], tmpUbInputs_[1], tmpUbInputs_[0], tmpUbInputs_[0]);
                MrgSort<float, true>(tempTensor, lst, elementCountList_, listSortedNums_, validBit, 1);
            } else if (remainListNum_ == MERGE_LIST_THREE) {
                MrgSortSrcList lst =
                    MrgSortSrcList(tmpUbInputs_[0], tmpUbInputs_[1], tmpUbInputs_[MERGE_LIST_IDX_TWO], tmpUbInputs_[0]);
                MrgSort<float, true>(tempTensor, lst, elementCountList_, listSortedNums_, validBit, 1);
            } else if (remainListNum_ == MERGE_LIST_FOUR) {
                MrgSortSrcList lst = MrgSortSrcList(tmpUbInputs_[0], tmpUbInputs_[1], tmpUbInputs_[MERGE_LIST_IDX_TWO],
                                                    tmpUbInputs_[MERGE_LIST_IDX_THREE]);
                MrgSort<float, true>(tempTensor, lst, elementCountList_, listSortedNums_, validBit, 1);
            } else {
                DataCopy(tempTensor, tmpUbInputs_[0], AlignElem(GetSortLen<float>(elementCountList_[0]), sizeof(float)));
                listSortedNums_[0] = elementCountList_[0];
            }
            // UpdateSortInfo
            curLoopSortedNum_ = 0;
            for (int64_t i = 0, j = 0; i < listNum_; i++) {
                if (lengths_[i] <= 0) {
                    continue;
                }
                listRemain_[i] -= listSortedNums_[j];
                allRemain_ -= listSortedNums_[j];
                offsets_[i] += GetSortOffset<float>(listSortedNums_[j]);
                curLoopSortedNum_ += listSortedNums_[j];
                j++;
            }
            // Extract -> negate 还原 expert -> cast int32
            if (curLoopSortedNum_ > 0) {
                PipeBarrier<PIPE_V>();
                Extract(ubOut1_, ubOut2_, tempTensor, CeilDiv(curLoopSortedNum_, ONE_REPEAT_SORT_NUM));
                PipeBarrier<PIPE_V>();
                Muls(ubOut1_, ubOut1_, static_cast<float>(-1), AlignElem(curLoopSortedNum_, sizeof(float)));
                PipeBarrier<PIPE_V>();
                Cast(ubOutInt1_, ubOut1_, RoundMode::CAST_ROUND, AlignElem(curLoopSortedNum_, sizeof(float)));
                // CopyOut
                DataCopyExtParams cp{1, static_cast<uint32_t>(curLoopSortedNum_ * sizeof(int32_t)), 0, 0, 0};
                SyncFlag<HardEvent::V_MTE3>(HardEvent::V_MTE3);
                DataCopyPad(gmOut1_[outOffset_], ubOutInt1_, cp);
                DataCopyPad(gmOut2_[outOffset_], ubOutInt2_, cp);
                outOffset_ += curLoopSortedNum_;
            }
        }
        inQueue_.FreeTensor(inLocal);
        outQueue_.FreeTensor(outLocal);
    }

private:
    TPipe *pipe_;
    TQue<QuePosition::VECIN, 1> inQueue_;
    TQue<QuePosition::VECOUT, 1> outQueue_;
    TBuf<TPosition::VECCALC> tmpBuf_;

    GlobalTensor<float> gmInputs_[4];
    GlobalTensor<int32_t> gmOut1_;
    GlobalTensor<int32_t> gmOut2_;

    LocalTensor<float> ubOut1_;
    LocalTensor<uint32_t> ubOut2_;
    LocalTensor<int32_t> ubOutInt1_;
    LocalTensor<int32_t> ubOutInt2_;
    LocalTensor<float> tmpUbInputs_[4];

    int64_t listNum_ = 0;
    int64_t perList_ = 0;
    int64_t oneLoopMax_ = 0;
    int64_t remainListNum_ = 0;
    int64_t outOffset_ = 0;
    int64_t offsets_[4] = {0};
    int64_t listRemain_[4] = {0};
    int64_t lengths_[4] = {0};
    int64_t allRemain_ = 0;
    int64_t curLoopSortedNum_ = 0;
    uint16_t elementCountList_[4] = {0};
    uint32_t listSortedNums_[4] = {0};
};

} // namespace FfnWbProbe

// ======================================================================
// 核函数入口
// ======================================================================
extern "C" __global__ __vector__ void ffn_wb_probe_sort(GM_ADDR expert_ids, GM_ADDR workspace, GM_ADDR tiling)
{
    TPipe pipe;
    auto td = (const __gm__ ProbeTilingData *)tiling;
    if (GetBlockIdx() < td->sortCoreNum) {
        FfnWbProbe::ProbeSortTile op;
        op.Init(expert_ids, workspace, td, &pipe);
        op.Process();
    }
}

extern "C" __global__ __vector__ void ffn_wb_probe_merge(GM_ADDR workspace, GM_ADDR sorted_expert_ids,
                                                         GM_ADDR gather_idx, GM_ADDR tiling)
{
    TPipe pipe;
    auto td = (const __gm__ ProbeTilingData *)tiling;
    if (GetBlockIdx() < 1) {
        FfnWbProbe::ProbeMerge op;
        op.Init(workspace, sorted_expert_ids, gather_idx, td, &pipe);
        op.Process();
    }
}

extern "C" __global__ __vector__ void ffn_wb_probe_divide(GM_ADDR sorted_expert_ids, GM_ADDR gather_idx,
                                                          GM_ADDR token_data, GM_ADDR session_src,
                                                          GM_ADDR micro_batch_src, GM_ADDR token_src, GM_ADDR y,
                                                          GM_ADDR session_ids, GM_ADDR micro_batch_ids,
                                                          GM_ADDR token_ids, GM_ADDR group_count,
                                                          GM_ADDR actual_token_num, GM_ADDR tiling)
{
    using namespace AscendC;
    using namespace FfnWbProbe;
    TPipe pipe;
    auto td = (const __gm__ ProbeTilingData *)tiling;
    int64_t blockIdx = GetBlockIdx();
    int64_t Y = td->totalLength;
    int64_t H = td->hiddenSize;
    int64_t expertNum = td->expertNum;
    int64_t gatherCoreNum = td->gatherCoreNum;
    int64_t groupCoreNum = td->groupCoreNum;

    if (blockIdx < gatherCoreNum) {
        // -------- gather 核: y + session/micro/token 索引 gather --------
        int64_t rowsPerCore = Y / gatherCoreNum;
        int64_t rowStart = blockIdx * rowsPerCore;

        GlobalTensor<int32_t> gatherIdxGm;
        gatherIdxGm.SetGlobalBuffer((__gm__ int32_t *)gather_idx + rowStart, rowsPerCore);
        GlobalTensor<int32_t> sessSrcGm, microSrcGm, tokSrcGm;
        sessSrcGm.SetGlobalBuffer((__gm__ int32_t *)session_src, Y);
        microSrcGm.SetGlobalBuffer((__gm__ int32_t *)micro_batch_src, Y);
        tokSrcGm.SetGlobalBuffer((__gm__ int32_t *)token_src, Y);
        GlobalTensor<int32_t> sessOutGm, microOutGm, tokOutGm;
        sessOutGm.SetGlobalBuffer((__gm__ int32_t *)session_ids + rowStart, rowsPerCore);
        microOutGm.SetGlobalBuffer((__gm__ int32_t *)micro_batch_ids + rowStart, rowsPerCore);
        tokOutGm.SetGlobalBuffer((__gm__ int32_t *)token_ids + rowStart, rowsPerCore);
        GlobalTensor<half> tokenDataGm;
        tokenDataGm.SetGlobalBuffer((__gm__ half *)token_data, Y * H);
        GlobalTensor<half> yGm;
        yGm.SetGlobalBuffer((__gm__ half *)y, Y * H);

        TBuf<TPosition::VECCALC> idxBuf, sessSrcBuf, microSrcBuf, tokSrcBuf, sessOutBuf, microOutBuf, tokOutBuf;
        pipe.InitBuffer(idxBuf, AlignElem(rowsPerCore, sizeof(int32_t)) * sizeof(int32_t));
        pipe.InitBuffer(sessSrcBuf, AlignElem(Y, sizeof(int32_t)) * sizeof(int32_t));
        pipe.InitBuffer(microSrcBuf, AlignElem(Y, sizeof(int32_t)) * sizeof(int32_t));
        pipe.InitBuffer(tokSrcBuf, AlignElem(Y, sizeof(int32_t)) * sizeof(int32_t));
        pipe.InitBuffer(sessOutBuf, AlignElem(rowsPerCore, sizeof(int32_t)) * sizeof(int32_t));
        pipe.InitBuffer(microOutBuf, AlignElem(rowsPerCore, sizeof(int32_t)) * sizeof(int32_t));
        pipe.InitBuffer(tokOutBuf, AlignElem(rowsPerCore, sizeof(int32_t)) * sizeof(int32_t));

        LocalTensor<int32_t> idxUB = idxBuf.Get<int32_t>();
        LocalTensor<int32_t> sessSrcUB = sessSrcBuf.Get<int32_t>();
        LocalTensor<int32_t> microSrcUB = microSrcBuf.Get<int32_t>();
        LocalTensor<int32_t> tokSrcUB = tokSrcBuf.Get<int32_t>();
        LocalTensor<int32_t> sessOutUB = sessOutBuf.Get<int32_t>();
        LocalTensor<int32_t> microOutUB = microOutBuf.Get<int32_t>();
        LocalTensor<int32_t> tokOutUB = tokOutBuf.Get<int32_t>();

        DataCopyExtParams cpIdx{1, static_cast<uint32_t>(rowsPerCore * sizeof(int32_t)), 0, 0, 0};
        DataCopyExtParams cpY{1, static_cast<uint32_t>(Y * sizeof(int32_t)), 0, 0, 0};
        DataCopyPadExtParams<int32_t> pad{false, 0, 0, 0};
        DataCopyPad(idxUB, gatherIdxGm, cpIdx, pad);
        DataCopyPad(sessSrcUB, sessSrcGm, cpY, pad);
        DataCopyPad(microSrcUB, microSrcGm, cpY, pad);
        DataCopyPad(tokSrcUB, tokSrcGm, cpY, pad);
        SyncFlag<HardEvent::MTE2_S>(HardEvent::MTE2_S);

        for (int64_t r = 0; r < rowsPerCore; r++) {
            int32_t idx = idxUB.GetValue(r);
            sessOutUB.SetValue(r, sessSrcUB.GetValue(idx));
            microOutUB.SetValue(r, microSrcUB.GetValue(idx));
            tokOutUB.SetValue(r, tokSrcUB.GetValue(idx));
        }
        SyncFlag<HardEvent::S_MTE3>(HardEvent::S_MTE3);
        DataCopyPad(sessOutGm, sessOutUB, cpIdx);
        DataCopyPad(microOutGm, microOutUB, cpIdx);
        DataCopyPad(tokOutGm, tokOutUB, cpIdx);

        // y 逐行 gather (hidden states 太大不驻 UB，逐行 DMA — 与真实算子 gather 同模式)
        TQue<QuePosition::VECIN, 2> tokRowIn;
        TQue<QuePosition::VECOUT, 2> tokRowOut;
        pipe.InitBuffer(tokRowIn, 2, AlignElem(H, sizeof(half)) * sizeof(half));
        pipe.InitBuffer(tokRowOut, 2, AlignElem(H, sizeof(half)) * sizeof(half));
        DataCopyExtParams cpRow{1, static_cast<uint32_t>(H * sizeof(half)), 0, 0, 0};
        DataCopyPadExtParams<half> padRow{false, 0, 0, 0};
        for (int64_t r = 0; r < rowsPerCore; r++) {
            int32_t idx = idxUB.GetValue(r);
            LocalTensor<half> rowIn = tokRowIn.AllocTensor<half>();
            DataCopyPad(rowIn, tokenDataGm[idx * H], cpRow, padRow);
            tokRowIn.EnQue(rowIn);
            LocalTensor<half> rowIn2 = tokRowIn.DeQue<half>();
            LocalTensor<half> rowOut = tokRowOut.AllocTensor<half>();
            DataCopy(rowOut, rowIn2, AlignElem(H, sizeof(half)));
            tokRowOut.EnQue(rowOut);
            LocalTensor<half> rowOut2 = tokRowOut.DeQue<half>();
            DataCopyPad(yGm[(rowStart + r) * H], rowOut2, cpRow);
            tokRowIn.FreeTensor(rowIn2);
            tokRowOut.FreeTensor(rowOut2);
        }

        // actual_token_num = Y (全 token 有效)，由 core 0 写
        if (blockIdx == 0) {
            TBuf<TPosition::VECCALC> atnBuf;
            pipe.InitBuffer(atnBuf, 32);
            LocalTensor<int32_t> atnUB = atnBuf.Get<int32_t>();
            atnUB.SetValue(0, static_cast<int32_t>(Y));
            GlobalTensor<int32_t> atnGm;
            atnGm.SetGlobalBuffer((__gm__ int32_t *)actual_token_num, 1);
            SyncFlag<HardEvent::S_MTE3>(HardEvent::S_MTE3);
            DataCopyExtParams cpA{1, static_cast<uint32_t>(sizeof(int32_t)), 0, 0, 0};
            DataCopyPad(atnGm, atnUB, cpA);
        }
    } else if (blockIdx < gatherCoreNum + groupCoreNum) {
        // -------- group_listing 核: 逐专家计数 (本地直方图 + SetAtomicAdd 聚合) --------
        int64_t localIdx = blockIdx - gatherCoreNum;
        int64_t rowsPerCore = Y / groupCoreNum;
        int64_t rowStart = localIdx * rowsPerCore;

        GlobalTensor<int32_t> sortedExpGm;
        sortedExpGm.SetGlobalBuffer((__gm__ int32_t *)sorted_expert_ids + rowStart, rowsPerCore);
        GlobalTensor<int32_t> groupCountGm;
        groupCountGm.SetGlobalBuffer((__gm__ int32_t *)group_count, expertNum);

        TBuf<TPosition::VECCALC> sortedBuf, histBuf;
        pipe.InitBuffer(sortedBuf, AlignElem(rowsPerCore, sizeof(int32_t)) * sizeof(int32_t));
        pipe.InitBuffer(histBuf, AlignElem(expertNum, sizeof(int32_t)) * sizeof(int32_t));
        LocalTensor<int32_t> sortedUB = sortedBuf.Get<int32_t>();
        LocalTensor<int32_t> histUB = histBuf.Get<int32_t>();

        Duplicate(histUB, 0, static_cast<int32_t>(AlignElem(expertNum, sizeof(int32_t))));
        DataCopyExtParams cp{1, static_cast<uint32_t>(rowsPerCore * sizeof(int32_t)), 0, 0, 0};
        DataCopyPadExtParams<int32_t> pad{false, 0, 0, 0};
        DataCopyPad(sortedUB, sortedExpGm, cp, pad);
        SyncFlag<HardEvent::MTE2_S>(HardEvent::MTE2_S);
        SyncFlag<HardEvent::V_S>(HardEvent::V_S);

        for (int64_t r = 0; r < rowsPerCore; r++) {
            int32_t e = sortedUB.GetValue(r);
            histUB.SetValue(e, histUB.GetValue(e) + 1);
        }
        SyncFlag<HardEvent::S_MTE3>(HardEvent::S_MTE3);
        DataCopyExtParams cpHist{1, static_cast<uint32_t>(expertNum * sizeof(int32_t)), 0, 0, 0};
        SetAtomicAdd<int32_t>();
        DataCopyPad(groupCountGm, histUB, cpHist);
        SetAtomicNone();
    }
}
