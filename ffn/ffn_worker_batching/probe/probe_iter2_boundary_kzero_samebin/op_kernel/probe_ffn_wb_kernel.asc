/*
 * probe5_norm_fp16_skeleton —— Kernel 入口（arch35 / DAV_3510）
 *
 * 目标：迭代一联调——验证 A5 arch35 NORM(TilingKey=100)/P0 fp16/单核骨架路径
 *       在真实 NPU 上 8 路输出二进制一致（骨架汇合验证）。
 *
 * 做法：忠实镜像主线 NORM 路径 FfnWorkerBatchingProcess（TilingKey 100，见
 *       op_kernel/ffn_worker_batching_apt.cpp）的三步链：
 *         sort(单核 KernelSortMaskOneCore) -> ValidGatherIdxLengthCompute
 *         -> gather(KernelFfnWBGatherOutAll<false>) + group_listing(KernelFfnWBGroupListing)
 *       全部复用主线 arch35 头文件，仅把 ScheduleContextInfo 的组装
 *       从「解析 1024B schedule_context 内嵌二级指针」替换为「host 直接传标量 + GM 指针」
 *       （schedule_context 二级指针注入无法用 TTK kernel 模式驱动，已证据化，见 PROBE_SUMMARY）。
 *       token_dtype=0 (fp16) -> gather 内 tokenDtypeSize_ = sizeof(half) = 2B，纯字节搬运
 *       （gather_out_all.h:47 判定 tokenDtype!=2 即 sizeof(half)，fp16/bf16 同构）。
 */
#include "kernel_operator.h"
#include "probe_ffn_wb_tiling.h"

#include "arch35/ffn_wb_common.h"
#include "arch35/ffn_wb_sort_base.h"
#include "arch35/ffn_wb_sort_one_core.h"
#include "arch35/ffn_wb_gather_out_all.h"
#include "arch35/ffn_wb_group_listing.h"

using namespace AscendC;
using namespace FfnWbBatching;

extern "C" __global__ __aicore__ void probe_ffn_wb_norm(
    GM_ADDR expert_ids,       // int32 [totalLength]      每 token 的 expert_id（被 mask=1000000）
    GM_ADDR token_data,       // bf16  [A,M,BS,K,H]       token hidden states（byte gather 源）
    GM_ADDR session_tbl,      // int32 [A]                session_ids 查表
    GM_ADDR microbatch_tbl,   // int32 [A]                micro_batch_ids 查表
    GM_ADDR y,                // bf16  [Y,H]
    GM_ADDR group_list,       // int64 [expertNum,2]
    GM_ADDR session_ids,      // int32 [Y]
    GM_ADDR micro_batch_ids,  // int32 [Y]
    GM_ADDR token_ids,        // int32 [Y]
    GM_ADDR expert_offsets,   // int32 [Y]
    GM_ADDR dynamic_scale,    // fp32  [Y]（bf16 不用）
    GM_ADDR actual_token_num, // int64 [1]
    GM_ADDR workspace,
    GM_ADDR tiling)
{
    if (g_coreType == AIC) {
        return;
    }
    const __gm__ ProbeTilingData* td = reinterpret_cast<const __gm__ ProbeTilingData*>(tiling);

    // ---- 组装 ScheduleContextInfo（替代 ScheduleContextInfoCompute 的 1024B 解析）----
    ScheduleContextInfo contextInfo;
    contextInfo.A = td->A;
    contextInfo.M = td->M;
    contextInfo.BS = td->BS;
    contextInfo.K = td->K;
    contextInfo.HS = td->HS;
    contextInfo.H = td->H;
    contextInfo.Y = td->Y;
    contextInfo.outNum = td->outNum;
    contextInfo.tokenDtype = td->tokenDtype;
    contextInfo.expertNum = td->expertNum;
    contextInfo.coreNum = td->coreNum;
    contextInfo.ubSize = td->ubSize;
    contextInfo.sortLoopMaxElement = td->sortLoopMaxElement;
    contextInfo.sortNumWorkSpace = td->sortNumWorkSpace;
    contextInfo.validGatherIdxLength = 0;
    contextInfo.curMicroBatchID = 0;
    contextInfo.BsKPaddingCount = 0;
    contextInfo.bufferPtr.tokenDataBuf = reinterpret_cast<uint64_t>(token_data);
    contextInfo.bufferPtr.sessionIdsBuf = reinterpret_cast<uint64_t>(session_tbl);
    contextInfo.bufferPtr.microBatchIdsBuf = reinterpret_cast<uint64_t>(microbatch_tbl);
    contextInfo.bufferPtr.expertIdsBuf = reinterpret_cast<uint64_t>(expert_ids);

    GM_ADDR userWS = workspace; // Kernel 直调：直接使用传入 workspace，无系统 workspace 前缀

    TPipe ffnPipe;

    // ---- step 1: 单核 sort（穿刺锁定单核，host 保证 totalLength <= sortLoopMaxElement）----
    SortCustomTilingDataKernel tilingdataSort;
    TilingSort(&tilingdataSort, &contextInfo);
    {
        KernelSortMaskOneCore op;
        op.Init(expert_ids, userWS, &tilingdataSort, &contextInfo, &ffnPipe);
        op.Process();
        ffnPipe.Reset();
    }

    // ---- 求有效 gather 长度 + 写 actual_token_num ----
    ValidGatherIdxLengthCompute(userWS, contextInfo, actual_token_num);

    // ---- step 2/3: 核间分工（gather vs group_listing），与主线一致 ----
    KernelFfnWBGroupListing expertTokenOutMultiOp;
    int64_t groupListingDealFlag = 0;
    uint32_t usedCoreNum = GROUP_LISTING_AIV_NUM;
    if (contextInfo.validGatherIdxLength > GROUP_LISTING_MULTI_CORE_LENGTH) {
        groupListingDealFlag = 1;
        usedCoreNum = GROUP_LISTING_MULTI_AIV_NUM;
    }

    if (GetBlockIdx() < contextInfo.coreNum - usedCoreNum) {
        KernelFfnWBGatherOutAll<false> op;
        op.Init(userWS + (OFFSET_SORTED_EXPERT_IDS + contextInfo.sortNumWorkSpace + tilingdataSort.totalLength) *
                    sizeof(int32_t),
                y, session_ids, micro_batch_ids, token_ids, expert_offsets, dynamic_scale,
                &contextInfo, &ffnPipe, usedCoreNum);
        op.Process();
        ffnPipe.Reset();
    } else {
        expertTokenOutMultiOp.Init(
            userWS + (OFFSET_SORTED_EXPERT_IDS + contextInfo.sortNumWorkSpace) * sizeof(int32_t),
            group_list,
            userWS + (OFFSET_SORTED_EXPERT_IDS + contextInfo.sortNumWorkSpace * (NUM_TWO * NUM_FOUR + 1)) *
                sizeof(int32_t),
            &contextInfo, &ffnPipe, groupListingDealFlag);
        expertTokenOutMultiOp.Process(groupListingDealFlag);
    }

    SyncAll();
    if (groupListingDealFlag && (GetBlockIdx() == contextInfo.coreNum - 1)) {
        expertTokenOutMultiOp.ProcessExpertCount();
    }
}
