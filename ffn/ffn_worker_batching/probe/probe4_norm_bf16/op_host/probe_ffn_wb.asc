/*
 * probe4_norm_bf16 —— Host + main 入口（Ascend C Kernel 直调）
 *
 * 流程：ACL 初始化 -> 运行时查询 aivNum / UB(GetCoreMemSize) -> 计算 tiling
 *       -> 拷入 4 输入 + memset 8 输出为 0 -> launch probe_ffn_wb_norm
 *       -> 拷出 8 输出写 bin。
 *
 * 约束落实：ubSize / coreNum / sortLoopMaxElement 全部由运行时平台接口 + 属性推导，
 *          无任何 arch UB 字节数/核数写死常量（对齐 MEMORY「UB size no hardcode」）。
 */
#include <cstdint>
#include <cstdio>
#include <cstring>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "tiling/platform/platform_ascendc.h"

#include "../op_kernel/probe_ffn_wb_tiling.h"
#include "data_utils.h"

// 引用纯 kernel 文件（含 kernel_operator.h 与 arch35 头）
#include "../op_kernel/probe_ffn_wb_kernel.asc"

struct ArgInfo {
    std::string fileName;
    size_t length;
};

#define CHECK_ACL(expr)                                                          \
    do {                                                                         \
        aclError _ret = (expr);                                                  \
        if (_ret != ACL_SUCCESS) {                                               \
            printf("[ERROR] %s failed, ret=%d (line %d)\n", #expr, _ret, __LINE__); \
            return _ret;                                                         \
        }                                                                        \
    } while (0)

int32_t main()
{
    CHECK_ACL(aclInit(nullptr));
    int32_t deviceId = 0;
    CHECK_ACL(aclrtSetDevice(deviceId));
    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));

    // ---- 运行时查询平台参数（禁写死 arch UB/核数常量）----
    const char* socName = aclrtGetSocName();
    printf("[INFO] SoC = %s\n", socName ? socName : "(null)");
    auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance(socName);
    if (platform == nullptr) {
        printf("[ERROR] PlatformAscendCManager::GetInstance(%s) returned null\n", socName);
        return 1;
    }
    uint32_t aivNum = platform->GetCoreNumAiv();
    uint64_t ubSize = 0;
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    printf("[INFO] runtime aivNum = %u, UB size = %lu bytes (%.1f KB)\n",
           aivNum, ubSize, ubSize / 1024.0);
    if (aivNum < 2 || ubSize == 0) {
        printf("[ERROR] invalid platform params (need aivNum>=2, ubSize>0)\n");
        return 1;
    }

    // ---- 穿刺形状（小 shape，锁定单核 sort；bf16 = token_dtype 1）----
    const uint32_t A = 4;     // session num
    const uint32_t M = 2;     // micro batch num
    const uint32_t BS = 2;    // batch size
    const uint32_t K = 3;     // topK + 1
    const uint32_t H = 16;    // hidden size (elements)
    const uint32_t expertNum = 8;
    const uint32_t tokenDtype = 1;                 // bf16
    const uint32_t tokenDtypeSize = 2;             // bf16 = 2B
    const uint32_t HS = H * tokenDtypeSize;        // 32B/token
    const uint32_t outNum = A;                     // 全 session 有效
    const uint32_t totalLength = outNum * BS * K;  // 24
    const uint32_t Y = A * BS * K;                 // 24

    // 单核 sort：coreNum=2（core0 gather，core1 group_listing），launch blockDim 与之一致
    const int64_t coreNum = 2;
    // sortLoopMaxElement 由运行时 ubSize 派生（A2 公式 §3.6.3）；保证 totalLength <= 之 => 单核
    int64_t sortLoopMaxElement = (int64_t)ubSize / (int64_t)(sizeof(int32_t) * 2 * 4) / 32 * 32;

    ProbeTilingData tiling;
    tiling.A = A; tiling.M = M; tiling.BS = BS; tiling.K = K;
    tiling.HS = HS; tiling.H = H; tiling.Y = Y; tiling.outNum = outNum;
    tiling.tokenDtype = tokenDtype; tiling.expertNum = expertNum;
    tiling.coreNum = coreNum;
    tiling.ubSize = (int64_t)ubSize;
    tiling.sortLoopMaxElement = sortLoopMaxElement;
    tiling.sortNumWorkSpace = Y;

    // ---- I/O 字节大小 ----
    const size_t szExpertIds  = (size_t)totalLength * sizeof(int32_t);
    const size_t szTokenData  = (size_t)A * M * BS * K * H * tokenDtypeSize;
    const size_t szSessTbl    = (size_t)A * sizeof(int32_t);
    const size_t szMbTbl      = (size_t)A * sizeof(int32_t);

    const size_t szY          = (size_t)Y * H * tokenDtypeSize;
    const size_t szGroupList  = (size_t)expertNum * 2 * sizeof(int64_t);
    const size_t szIds        = (size_t)Y * sizeof(int32_t);   // session/micro/token/expert_offsets
    const size_t szScale      = (size_t)Y * sizeof(float);
    const size_t szActual     = (size_t)1 * sizeof(int64_t);

    std::vector<ArgInfo> inputsInfo = {
        {"./input/expert_ids.bin", szExpertIds},
        {"./input/token_data.bin", szTokenData},
        {"./input/session_tbl.bin", szSessTbl},
        {"./input/microbatch_tbl.bin", szMbTbl},
    };
    std::vector<ArgInfo> outputsInfo = {
        {"./output/y.bin", szY},
        {"./output/group_list.bin", szGroupList},
        {"./output/session_ids.bin", szIds},
        {"./output/micro_batch_ids.bin", szIds},
        {"./output/token_ids.bin", szIds},
        {"./output/expert_offsets.bin", szIds},
        {"./output/dynamic_scale.bin", szScale},
        {"./output/actual_token_num.bin", szActual},
    };

    const size_t nIn = inputsInfo.size();
    const size_t nOut = outputsInfo.size();
    std::vector<uint8_t*> inHost(nIn), inDev(nIn), outHost(nOut), outDev(nOut);

    // tiling to device
    uint8_t* tilingDev = nullptr;
    CHECK_ACL(aclrtMalloc((void**)&tilingDev, sizeof(ProbeTilingData), ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemcpy(tilingDev, sizeof(ProbeTilingData), &tiling, sizeof(ProbeTilingData),
                          ACL_MEMCPY_HOST_TO_DEVICE));

    // workspace（远大于所需：128 + 9*sortNumWorkSpace + expertNum int32；这里给 4MB）
    const size_t szWorkspace = 4u * 1024u * 1024u;
    uint8_t* workspaceDev = nullptr;
    CHECK_ACL(aclrtMalloc((void**)&workspaceDev, szWorkspace, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemset(workspaceDev, szWorkspace, 0, szWorkspace));

    // inputs
    for (size_t i = 0; i < nIn; i++) {
        CHECK_ACL(aclrtMallocHost((void**)&inHost[i], inputsInfo[i].length));
        CHECK_ACL(aclrtMalloc((void**)&inDev[i], inputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST));
        if (!ReadFile(inputsInfo[i].fileName, inputsInfo[i].length, inHost[i], inputsInfo[i].length)) {
            printf("[ERROR] ReadFile %s failed\n", inputsInfo[i].fileName.c_str());
            return 1;
        }
        CHECK_ACL(aclrtMemcpy(inDev[i], inputsInfo[i].length, inHost[i], inputsInfo[i].length,
                              ACL_MEMCPY_HOST_TO_DEVICE));
    }

    // outputs（memset 0：gather 未写到的尾部保持 0，与 golden 尾部一致）
    for (size_t i = 0; i < nOut; i++) {
        CHECK_ACL(aclrtMallocHost((void**)&outHost[i], outputsInfo[i].length));
        CHECK_ACL(aclrtMalloc((void**)&outDev[i], outputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST));
        CHECK_ACL(aclrtMemset(outDev[i], outputsInfo[i].length, 0, outputsInfo[i].length));
    }

    // ---- launch ----
    uint32_t blockNum = (uint32_t)coreNum;
    probe_ffn_wb_norm<<<blockNum, nullptr, stream>>>(
        inDev[0], inDev[1], inDev[2], inDev[3],
        outDev[0], outDev[1], outDev[2], outDev[3],
        outDev[4], outDev[5], outDev[6], outDev[7],
        workspaceDev, tilingDev);
    CHECK_ACL(aclrtSynchronizeStream(stream));

    // ---- copy back + write ----
    for (size_t i = 0; i < nOut; i++) {
        CHECK_ACL(aclrtMemcpy(outHost[i], outputsInfo[i].length, outDev[i], outputsInfo[i].length,
                              ACL_MEMCPY_DEVICE_TO_HOST));
        WriteFile(outputsInfo[i].fileName, outHost[i], outputsInfo[i].length);
    }

    // ---- cleanup ----
    for (size_t i = 0; i < nOut; i++) { aclrtFree(outDev[i]); aclrtFreeHost(outHost[i]); }
    for (size_t i = 0; i < nIn; i++) { aclrtFree(inDev[i]); aclrtFreeHost(inHost[i]); }
    aclrtFree(workspaceDev);
    aclrtFree(tilingDev);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    printf("[INFO] probe_ffn_wb_norm done (blockDim=%u, totalLength=%u, Y=%u)\n",
           blockNum, totalLength, Y);
    return 0;
}
