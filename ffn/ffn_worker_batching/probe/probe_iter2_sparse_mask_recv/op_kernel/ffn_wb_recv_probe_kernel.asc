/*!
 * \file ffn_wb_recv_probe_kernel.asc
 * \brief 穿刺1: FfnWorkerBatching RECV(TilingKey 101) fp16 单核 sort 路径，
 *        arch35/DAV_3510 Kernel 直调入口。
 *
 * 该入口把 arch22 的 FfnWorkerBatchingRecvProcess 单核 sort 分支内联到
 * __global__ 核函数，附加 Kernel 直调所需的 SetSysWorkspace + 手工读取 tiling。
 * 复用的 13 个 ffn_wb_*.h 头文件原样从 op_kernel/ 移植（arch35 代次重编译），
 * 用以验证 "RECV 路径扫描 + batching 骨架在 DAV_3510 上可行性"。
 */

#include "kernel_operator.h"
#include "ffn_wb_probe_tiling.h"            // 全局命名空间 FfnWorkerBatchingTilingData
#include "ffn_wb_common.h"
#include "ffn_wb_get_schedule_context.h"
#include "ffn_wb_scan_token_info.h"
#include "ffn_wb_sort_base.h"
#include "ffn_wb_scan_sort_one_core.h"
#include "ffn_wb_gather_out_all.h"
#include "ffn_wb_scan_group_listing_one_core.h"

using namespace AscendC;
using namespace FfnWbBatching;

#ifndef PROBE_STAGE
#define PROBE_STAGE 9   // 1=scan only, 2=+sort, 3=+valid, 9=full
#endif

extern "C" __global__ __aicore__ void ffn_wb_recv_probe(
    GM_ADDR schedule_context, GM_ADDR y, GM_ADDR group_list, GM_ADDR session_ids,
    GM_ADDR micro_batch_ids, GM_ADDR token_ids, GM_ADDR expert_offsets,
    GM_ADDR dynamic_scale, GM_ADDR actual_token_num, GM_ADDR workspace, GM_ADDR tiling)
{
    if (g_coreType == AIC) {
        return;
    }
    // Kernel 直调：<<<>>> 不自动配置系统 workspace，需手工 Set。
    // 注意：dav_3510 上 GetSysWorkSpacePtr() 返回 __get_kfc_workspace_addr()，
    // 故必须用 SetSysWorkspaceForce(内部调 __set_kfc_workspace_addr)，
    // 普通 SetSysWorkspace(设 g_sysWorkspaceReserved) 在 3510 上不生效。
    SetSysWorkspaceForce(workspace);
    GM_ADDR userWS = GetUserWorkspace(workspace);   // = workspace + RESERVED_WORKSPACE(16MB)
    if (userWS == nullptr) {
        return;
    }

    // 逐字段读取 TilingData(8 * int64)
    GlobalTensor<int64_t> tilingGm;
    tilingGm.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(tiling), 8);
    FfnWorkerBatchingTilingData td;
    td.Y = tilingGm.GetValue(0);
    td.H = tilingGm.GetValue(1);
    td.tokenDtype = tilingGm.GetValue(2);
    td.expertNum = tilingGm.GetValue(3);
    td.coreNum = tilingGm.GetValue(4);
    td.ubSize = tilingGm.GetValue(5);
    td.sortLoopMaxElement = tilingGm.GetValue(6);
    td.sortNumWorkSpace = tilingGm.GetValue(7);

    TPipe ffnPipe;
    ScheduleContextInfo contextInfo;
    ScheduleContextInfoCompute<true>(schedule_context, &td, contextInfo, &ffnPipe);
    ffnPipe.Reset();

    // RECV 专属：先扫描 token_info(等待当前 micro batch ready)
    GM_ADDR tokenInfoGmAddr = reinterpret_cast<GM_ADDR>(contextInfo.bufferPtr.tokenInfoBuf);

#if PROBE_STAGE == 0
    // 诊断：core0 把解析出的指针/标量写到 y(int64) 与 workspace 基址对比
    if (GetBlockIdx() == 0) {
        GlobalTensor<int64_t> dbg;
        dbg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(y), 16);
        dbg.SetValue(0, (int64_t)contextInfo.bufferPtr.tokenInfoBuf);
        dbg.SetValue(1, (int64_t)contextInfo.bufferPtr.tokenDataBuf);
        dbg.SetValue(2, (int64_t)contextInfo.curMicroBatchID);
        dbg.SetValue(3, (int64_t)contextInfo.A);
        dbg.SetValue(4, (int64_t)contextInfo.M);
        dbg.SetValue(5, (int64_t)contextInfo.BS);
        dbg.SetValue(6, (int64_t)contextInfo.K);
        dbg.SetValue(7, (int64_t)contextInfo.HS);
        dbg.SetValue(8, (int64_t)(uintptr_t)workspace);
        dbg.SetValue(9, (int64_t)(uintptr_t)userWS);
        dbg.SetValue(10, (int64_t)contextInfo.BsKPaddingCount);
        DataCacheCleanAndInvalid<int64_t, AscendC::CacheLine::SINGLE_CACHE_LINE,
            AscendC::DcciDst::CACHELINE_ALL>(dbg);
    }
    return;
#endif

    KernelScanTokenInfo scanTokenInfo;
    scanTokenInfo.Init(schedule_context, tokenInfoGmAddr, userWS, &contextInfo, &ffnPipe);
    scanTokenInfo.Process();
    SyncAll();
    ffnPipe.Reset();

#if PROBE_STAGE >= 2
    // sort 生成 gather 索引（穿刺1: 小 shape → 单核 sort 分支）
    SortCustomTilingDataKernel tilingdataSort;
    TilingScanSort(&tilingdataSort, &contextInfo);
    KernelScanSortMaskOneCore op;
    op.Init(tokenInfoGmAddr, userWS, &tilingdataSort, &contextInfo, &ffnPipe);
    op.Process();
    ffnPipe.Reset();
#endif

#if PROBE_STAGE >= 3
    // 有效 gather 长度 → actual_token_num
    ValidGatherIdxLengthCompute(userWS, contextInfo, actual_token_num);
#endif

#if PROBE_STAGE >= 9
    // 多核分工：末 1 核 group_listing，其余核 gather
    int64_t blockIdx = GetBlockIdx();
    if (blockIdx < td.coreNum - GROUP_LISTING_SCAN_AIV_NUM) {
        KernelFfnWBGatherOutAll<true> opGather;
        opGather.Init(
            userWS + (OFFSET_SORTED_EXPERT_IDS + contextInfo.sortNumWorkSpace +
                      tilingdataSort.totalLengthWithPad) * sizeof(int32_t),
            y, session_ids, micro_batch_ids, token_ids, expert_offsets, dynamic_scale,
            &contextInfo, &ffnPipe, GROUP_LISTING_SCAN_AIV_NUM);
        opGather.Process();
        ffnPipe.Reset();
    } else {
        KernelFfnWBScanGroupListingOneCore opGroup;
        opGroup.Init(
            userWS + (OFFSET_SORTED_EXPERT_IDS + contextInfo.sortNumWorkSpace) * sizeof(int32_t),
            group_list, &contextInfo, &ffnPipe);
        opGroup.Process();
        ffnPipe.Reset();
    }
#endif
}
