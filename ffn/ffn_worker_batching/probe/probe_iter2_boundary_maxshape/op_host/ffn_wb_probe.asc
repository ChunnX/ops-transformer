// ============================================================================
// 迭代二 穿刺2 (probe_iter2_boundary_maxshape) — Host + main 入口
// 边界上界 shape + UB 收敛不溢出 (issue #01) 验证。
// 目标平台: Ascend950DT_9584 (arch35 / DAV_3510)
//
// 两个模式:
//   --query-ub : 只查询 kernel 侧真实 UB (ACL_DEV_ATTR_UBUF_PER_VECTOR_CORE) 与
//                host 侧平台 UB (GetCoreMemSize)，派生 sortLoopMaxElement / Y，写 ub_params.txt
//                供 gen_data.py 读取（保证 host/kernel/golden shape 一致，禁写死）。
//   (默认)     : 查询 UB -> 组装 tiling -> 3 次核函数启动 (sort/merge/divide) -> dump 8 路输出。
//
// UB 极限设计 (issue #01):
//   sortLoopMaxElement = ubKernel / (sizeof(int32)*2*4) / 32 * 32 = ubKernel/32
//   每 sort 核 tile = sortLoopMaxElement，4-buffer footprint = 4*(SLM)*8 = ubKernel (恰好占满)。
//   Y = SORT_CORE_NUM * SLM (触发多核 + 4 路 MrgSort 归并)。
// ============================================================================

#include <cstdint>
#include <cstdio>
#include <cstring>
#include <iostream>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "tiling/platform/platform_ascendc.h"
#include "../op_kernel/ffn_wb_probe_tiling.h"
#include "data_utils.h"

#include "../op_kernel/ffn_wb_probe_kernel.asc"

#define CHECK_ACL(x)                                                                 \
    do {                                                                             \
        aclError __ret = (x);                                                        \
        if (__ret != ACL_SUCCESS) {                                                  \
            printf("[ACL ERROR] %s ret=%d line=%d\n", #x, (int)__ret, __LINE__);     \
            return -1;                                                               \
        }                                                                            \
    } while (0)

// ---- 固定 shape 语义参数 (边界上界) ----
static constexpr int32_t SORT_CORE_NUM = 4;    // 多核 sort + 4 路 MrgSort 归并
static constexpr int32_t EXPERT_NUM = 256;
static constexpr int32_t H = 128;              // hidden dim (spec 边界 max_out_shape[3]=128)
static constexpr int32_t ONE_LOOP_MAX_MRG = 1024;
static constexpr int32_t GATHER_CORE_NUM = 16;
static constexpr int32_t GROUP_CORE_NUM = 16;

struct DevBuf {
    uint8_t *dev = nullptr;
    uint8_t *host = nullptr;
    size_t bytes = 0;
};

static int32_t AllocInput(DevBuf &b, size_t bytes, const std::string &file)
{
    b.bytes = bytes;
    CHECK_ACL(aclrtMallocHost((void **)&b.host, bytes));
    CHECK_ACL(aclrtMalloc((void **)&b.dev, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    if (!ReadFile(file, bytes, b.host, bytes)) {
        printf("[ERROR] ReadFile failed: %s (%zu bytes)\n", file.c_str(), bytes);
        return -1;
    }
    CHECK_ACL(aclrtMemcpy(b.dev, bytes, b.host, bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    return 0;
}

static int32_t AllocOutput(DevBuf &b, size_t bytes, bool zeroInit = false)
{
    b.bytes = bytes;
    CHECK_ACL(aclrtMallocHost((void **)&b.host, bytes));
    CHECK_ACL(aclrtMalloc((void **)&b.dev, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    if (zeroInit) {
        CHECK_ACL(aclrtMemset(b.dev, bytes, 0, bytes));
    }
    return 0;
}

static int32_t DumpOutput(DevBuf &b, const std::string &file)
{
    CHECK_ACL(aclrtMemcpy(b.host, b.bytes, b.dev, b.bytes, ACL_MEMCPY_DEVICE_TO_HOST));
    if (!WriteFile(file, b.host, b.bytes)) {
        printf("[ERROR] WriteFile failed: %s\n", file.c_str());
        return -1;
    }
    return 0;
}

// 查询两侧 UB，派生 SLM / Y。返回 0 成功。
static int32_t QueryUb(int32_t deviceId, int64_t &ubKernel, int64_t &ubHost,
                       int64_t &slm, int64_t &Y)
{
    const char *soc = aclrtGetSocName();
    // kernel 侧真实可用 UB (runtime attr) — 与穿刺3/4 一致口径
    int64_t vcoreNum = 0;
    ubKernel = 0;
    aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &vcoreNum);
    aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_UBUF_PER_VECTOR_CORE, &ubKernel);
    // host 侧平台接口 UB — 主线 tiling 走的口径
    ubHost = 0;
    auto *platform = platform_ascendc::PlatformAscendCManager::GetInstance(soc);
    if (platform != nullptr) {
        uint64_t tmp = 0;
        platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, tmp);
        ubHost = static_cast<int64_t>(tmp);
    }
    printf("[UB] soc=%s vectorCoreNum=%ld\n", soc ? soc : "(null)", vcoreNum);
    printf("[UB] kernel-side ACL_DEV_ATTR_UBUF_PER_VECTOR_CORE = %ld (%.1f KB)\n",
           ubKernel, ubKernel / 1024.0);
    printf("[UB] host-side   GetCoreMemSize(UB)                = %ld (%.1f KB)\n",
           ubHost, ubHost / 1024.0);
    if (ubKernel <= 0) {
        printf("[ERROR] ubKernel query failed\n");
        return -1;
    }
    // 保守口径：sortLoopMaxElement 由 kernel 侧真实可用 UB 派生 (主线公式，禁写死 arch 常量)
    slm = ubKernel / (int64_t)(sizeof(int32_t) * 2 * 4) / 32 * 32;
    Y = (int64_t)SORT_CORE_NUM * slm;
    // 4-buffer footprint 记账 (sortNum == slm 时)
    int64_t footKernel = 4 * slm * (int64_t)(sizeof(int32_t) * 2);
    int64_t slmHost = ubHost / (int64_t)(sizeof(int32_t) * 2 * 4) / 32 * 32;
    int64_t footHost = 4 * slmHost * (int64_t)(sizeof(int32_t) * 2);
    printf("[UB] SLM(kernel-derived)=%ld -> sort 4-buffer footprint=%ld B (%.1f KB) vs 物理 UB %ld B => %s\n",
           slm, footKernel, footKernel / 1024.0, ubKernel,
           (footKernel <= ubKernel) ? "FITS" : "OVERFLOW");
    printf("[UB] (control) SLM(host-derived)=%ld -> footprint=%ld B (%.1f KB) vs 物理 UB %ld B => %s\n",
           slmHost, footHost, footHost / 1024.0, ubKernel,
           (footHost <= ubKernel) ? "FITS" : "OVERFLOW (host口径超物理 UB)");
    printf("[UB] Y = SORT_CORE_NUM(%d) * SLM(%ld) = %ld  (H=%d expert_num=%d)\n",
           SORT_CORE_NUM, slm, Y, H, EXPERT_NUM);
    return 0;
}

int32_t main(int32_t argc, char *argv[])
{
    bool queryMode = (argc > 1 && std::string(argv[1]) == "--query-ub");

    CHECK_ACL(aclInit(nullptr));
    int32_t deviceId = 0;
    CHECK_ACL(aclrtSetDevice(deviceId));
    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));

    int64_t ubKernel = 0, ubHost = 0, slm = 0, Y = 0;
    if (QueryUb(deviceId, ubKernel, ubHost, slm, Y) != 0) return -1;

    if (queryMode) {
        // 写 ub_params.txt 供 gen_data.py 读取
        FILE *fp = fopen("ub_params.txt", "w");
        if (!fp) { printf("[ERROR] open ub_params.txt failed\n"); return -1; }
        fprintf(fp, "ubKernel %ld\n", ubKernel);
        fprintf(fp, "ubHost %ld\n", ubHost);
        fprintf(fp, "slm %ld\n", slm);
        fprintf(fp, "Y %ld\n", Y);
        fprintf(fp, "sortCoreNum %d\n", SORT_CORE_NUM);
        fprintf(fp, "H %d\n", H);
        fprintf(fp, "expertNum %d\n", EXPERT_NUM);
        fprintf(fp, "idPackWidth %ld\n", (int64_t)ID_PACK_WIDTH);
        fclose(fp);
        printf("[query-ub] wrote ub_params.txt (Y=%ld slm=%ld)\n", Y, slm);
        aclrtDestroyStream(stream);
        aclrtResetDevice(deviceId);
        aclFinalize();
        return 0;
    }

    int32_t perCore = static_cast<int32_t>(slm);
    int32_t Yi = static_cast<int32_t>(Y);

    // ---- Tiling ----
    ProbeTilingData tiling;
    tiling.totalLength = Yi;
    tiling.perCoreElements = perCore;
    tiling.sortCoreNum = SORT_CORE_NUM;
    tiling.expertNum = EXPERT_NUM;
    tiling.hiddenSize = H;
    tiling.oneLoopMaxElementsMrg = ONE_LOOP_MAX_MRG;
    tiling.gatherCoreNum = GATHER_CORE_NUM;
    tiling.groupCoreNum = GROUP_CORE_NUM;
    tiling.sortNum = ((perCore + 31) / 32) * 32;
    tiling.ubKernel = ubKernel;
    tiling.ubHost = ubHost;
    tiling.sortLoopMaxElement = slm;

    uint8_t *tilingDev = nullptr;
    CHECK_ACL(aclrtMalloc((void **)&tilingDev, sizeof(ProbeTilingData), ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemcpy(tilingDev, sizeof(ProbeTilingData), &tiling, sizeof(ProbeTilingData),
                          ACL_MEMCPY_HOST_TO_DEVICE));

    // ---- Workspace (sort proposal: SORT_CORE_NUM 路 × 2*perCore float, ×2 冗余) ----
    size_t wsBytes = (size_t)SORT_CORE_NUM * (2 * (size_t)perCore) * sizeof(float) * 2;
    uint8_t *wsDev = nullptr;
    CHECK_ACL(aclrtMalloc((void **)&wsDev, wsBytes, ACL_MEM_MALLOC_HUGE_FIRST));

    // ---- Inputs ----
    DevBuf expertIds, tokenData, idPack;
    if (AllocInput(expertIds, (size_t)Yi * sizeof(int32_t), "./input/expert_ids.bin") != 0) return -1;
    if (AllocInput(tokenData, (size_t)Yi * H * sizeof(uint16_t), "./input/token_data.bin") != 0) return -1;
    if (AllocInput(idPack, (size_t)Yi * ID_PACK_WIDTH * sizeof(int32_t), "./input/id_pack_src.bin") != 0) return -1;

    // ---- Outputs ----
    DevBuf sortedExp, gatherIdx, yOut, sessOut, microOut, tokOut, groupCount, actualNum;
    if (AllocOutput(sortedExp, (size_t)Yi * sizeof(int32_t)) != 0) return -1;
    if (AllocOutput(gatherIdx, (size_t)Yi * sizeof(int32_t)) != 0) return -1;
    if (AllocOutput(yOut, (size_t)Yi * H * sizeof(uint16_t)) != 0) return -1;
    if (AllocOutput(sessOut, (size_t)Yi * sizeof(int32_t)) != 0) return -1;
    if (AllocOutput(microOut, (size_t)Yi * sizeof(int32_t)) != 0) return -1;
    if (AllocOutput(tokOut, (size_t)Yi * sizeof(int32_t)) != 0) return -1;
    if (AllocOutput(groupCount, (size_t)EXPERT_NUM * sizeof(int32_t), /*zeroInit=*/true) != 0) return -1;
    if (AllocOutput(actualNum, (size_t)1 * sizeof(int32_t)) != 0) return -1;

    // ==== Stage A: 多核 sort (每核 tile=SLM，4-buffer footprint 打到物理 UB 上界) ====
    ffn_wb_probe_sort<<<SORT_CORE_NUM, nullptr, stream>>>(expertIds.dev, wsDev, tilingDev);
    CHECK_ACL(aclrtSynchronizeStream(stream));

    // ==== Stage B: MrgSort 4 路归并 ====
    ffn_wb_probe_merge<<<1, nullptr, stream>>>(wsDev, sortedExp.dev, gatherIdx.dev, tilingDev);
    CHECK_ACL(aclrtSynchronizeStream(stream));

    // ==== Stage C: 核间 gather / group_listing 分工 ====
    uint32_t divideBlocks = GATHER_CORE_NUM + GROUP_CORE_NUM;
    ffn_wb_probe_divide<<<divideBlocks, nullptr, stream>>>(
        sortedExp.dev, gatherIdx.dev, tokenData.dev, idPack.dev, yOut.dev, sessOut.dev,
        microOut.dev, tokOut.dev, groupCount.dev, actualNum.dev, tilingDev);
    CHECK_ACL(aclrtSynchronizeStream(stream));

    // ---- Dump outputs ----
    int32_t rc = 0;
    rc |= DumpOutput(sortedExp, "./output/sorted_expert_ids.bin");
    rc |= DumpOutput(gatherIdx, "./output/gather_idx.bin");
    rc |= DumpOutput(yOut, "./output/y.bin");
    rc |= DumpOutput(sessOut, "./output/session_ids.bin");
    rc |= DumpOutput(microOut, "./output/micro_batch_ids.bin");
    rc |= DumpOutput(tokOut, "./output/token_ids.bin");
    rc |= DumpOutput(groupCount, "./output/group_count.bin");
    rc |= DumpOutput(actualNum, "./output/actual_token_num.bin");
    if (rc != 0) return -1;

    // ---- cleanup ----
    aclrtFree(tilingDev);
    aclrtFree(wsDev);
    for (DevBuf *b : {&expertIds, &tokenData, &idPack, &sortedExp, &gatherIdx, &yOut, &sessOut,
                      &microOut, &tokOut, &groupCount, &actualNum}) {
        aclrtFree(b->dev);
        aclrtFreeHost(b->host);
    }
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    printf("[probe_iter2_boundary] all 3 stages finished on NPU (Y=%d SLM=%d).\n", Yi, perCore);
    return 0;
}
