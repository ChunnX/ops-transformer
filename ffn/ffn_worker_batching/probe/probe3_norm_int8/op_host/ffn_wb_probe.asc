/*!
 * \file ffn_wb_probe.asc
 * \brief probe3_norm_int8 Host + main 入口（Kernel 直调）。
 *        构建 1024B schedule_context（内嵌 device 子 buffer 地址）、计算 TilingData、
 *        分配 workspace / 8 路输出，在真实 NPU 上启动 ffn_wb_probe_kernel，回读 8 路输出到 bin。
 */

#include <cstdint>
#include <cstdio>
#include <cstring>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "data_utils.h"

// 直调 kernel（含 kernel_operator.h 及全部功能头）
#include "../op_kernel/ffn_wb_probe_kernel.asc"

struct ProbeParams {
    int32_t A;
    int32_t M;
    int32_t BS;
    int32_t K;
    int32_t H;
    int32_t HS;
    int32_t expertNum;
    int32_t tokenDtype;
    int32_t outNum;
};

static bool ReadParams(const std::string& path, ProbeParams& p)
{
    FILE* f = fopen(path.c_str(), "r");
    if (f == nullptr) {
        printf("[ERROR] open params %s failed\n", path.c_str());
        return false;
    }
    int n = fscanf(f, "%d %d %d %d %d %d %d %d %d",
                   &p.A, &p.M, &p.BS, &p.K, &p.H, &p.HS, &p.expertNum, &p.tokenDtype, &p.outNum);
    fclose(f);
    if (n != 9) {
        printf("[ERROR] params parse failed, got %d fields\n", n);
        return false;
    }
    return true;
}

// 分配 device buffer 并从 host bin 拷入
static uint8_t* MallocAndLoad(const std::string& file, size_t bytes)
{
    uint8_t* host = nullptr;
    uint8_t* dev = nullptr;
    aclrtMallocHost((void**)&host, bytes);
    aclrtMalloc((void**)&dev, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    if (!ReadFile(file, bytes, host, bytes)) {
        printf("[ERROR] read %s (%zu bytes) failed\n", file.c_str(), bytes);
        return nullptr;
    }
    aclrtMemcpy(dev, bytes, host, bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtFreeHost(host);
    return dev;
}

static uint8_t* MallocZero(size_t bytes)
{
    uint8_t* dev = nullptr;
    aclrtMalloc((void**)&dev, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemset(dev, bytes, 0, bytes);
    return dev;
}

static void DumpOut(const std::string& file, uint8_t* dev, size_t bytes)
{
    uint8_t* host = nullptr;
    aclrtMallocHost((void**)&host, bytes);
    aclrtMemcpy(host, bytes, dev, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile(file, host, bytes);
    aclrtFreeHost(host);
}

int32_t main()
{
    ProbeParams p{};
    if (!ReadParams("./input/params.txt", p)) {
        return 1;
    }

    aclInit(nullptr);
    int32_t deviceId = 0;
    if (aclrtSetDevice(deviceId) != ACL_SUCCESS) {
        printf("[ERROR] aclrtSetDevice failed\n");
        return 2;
    }

    const char* soc = aclrtGetSocName();
    int64_t vcoreNum = 0;
    int64_t ubufBytes = 0;
    aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &vcoreNum);
    aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_UBUF_PER_VECTOR_CORE, &ubufBytes);
    printf("[INFO] soc=%s vectorCoreNum=%ld ubufPerCore=%ld\n", soc ? soc : "(null)", vcoreNum, ubufBytes);

    const int64_t Y = (int64_t)p.A * p.BS * p.K;
    const int64_t totalLength = (int64_t)p.outNum * p.BS * p.K;
    const int64_t tokenDtypeSize = (p.tokenDtype == 2) ? 1 : 2;

    // ---- TilingData（镜像 host tiling.cpp 计算，UB/核数运行时查询，无 arch 常量）----
    FfnWorkerBatchingTilingData td{};
    td.Y = Y;
    td.H = p.H;
    td.tokenDtype = p.tokenDtype;
    td.expertNum = p.expertNum;
    td.coreNum = vcoreNum;
    td.ubSize = ubufBytes;
    // sortLoopMaxElement = ubSize/(sizeof(int32)*2*4)/32*32
    td.sortLoopMaxElement = ubufBytes / (int64_t)(sizeof(int32_t) * 2 * 4) / 32 * 32;
    td.sortNumWorkSpace = Y;
    printf("[INFO] Y=%ld totalLength=%ld sortLoopMaxElement=%ld coreNum=%ld tokenDtype=%d\n",
           Y, totalLength, td.sortLoopMaxElement, td.coreNum, p.tokenDtype);

    // ---- 输入子 buffer（schedule_context 内嵌其 device 地址）----
    const size_t tokenDataBytes = (size_t)p.A * p.M * p.BS * p.K * p.HS;   // [A,M,BS,K,HS] int8
    const size_t sessionIdsBytes = (size_t)p.A * sizeof(int32_t);
    const size_t microBatchIdsBytes = (size_t)p.A * sizeof(int32_t);
    const size_t expertIdsBytes = (size_t)Y * sizeof(int32_t);             // >= totalLength

    uint8_t* tokenDataDev = MallocAndLoad("./input/token_data.bin", tokenDataBytes);
    uint8_t* sessionIdsBufDev = MallocAndLoad("./input/session_ids_buf.bin", sessionIdsBytes);
    uint8_t* microBatchIdsBufDev = MallocAndLoad("./input/micro_batch_ids_buf.bin", microBatchIdsBytes);
    uint8_t* expertIdsBufDev = MallocAndLoad("./input/expert_ids_buf.bin", expertIdsBytes);
    if (!tokenDataDev || !sessionIdsBufDev || !microBatchIdsBufDev || !expertIdsBufDev) {
        printf("[ERROR] load input sub-buffers failed\n");
        return 3;
    }

    // ---- 构建 1024B schedule_context（scalar 字段 + 内嵌 device 地址）----
    std::vector<uint8_t> sc(1024, 0);
    auto putU32 = [&](int off, uint32_t v) { std::memcpy(sc.data() + off, &v, sizeof(v)); };
    auto putU64 = [&](int off, uint64_t v) { std::memcpy(sc.data() + off, &v, sizeof(v)); };
    putU32(0, (uint32_t)p.A);     // session_num
    putU32(4, (uint32_t)p.M);     // micro_batch_num
    putU32(8, (uint32_t)p.BS);    // micro_batch_size
    putU32(12, (uint32_t)p.K);    // selected_expert_num (topK+1)
    putU32(20, (uint32_t)p.HS);   // attn_to_ffn_token_size (bytes)
    putU64(400, (uint64_t)tokenDataDev);        // token_data_buf
    putU64(528, (uint64_t)sessionIdsBufDev);    // session_ids_buf
    putU64(544, (uint64_t)microBatchIdsBufDev); // micro_batch_ids_buf
    putU64(560, (uint64_t)expertIdsBufDev);     // expert_ids_buf
    putU32(576, (uint32_t)p.outNum);            // out_num

    uint8_t* scDev = nullptr;
    aclrtMalloc((void**)&scDev, 1024, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(scDev, 1024, sc.data(), 1024, ACL_MEMCPY_HOST_TO_DEVICE);

    // ---- tiling device ----
    uint8_t* tilingDev = nullptr;
    aclrtMalloc((void**)&tilingDev, sizeof(td), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingDev, sizeof(td), &td, sizeof(td), ACL_MEMCPY_HOST_TO_DEVICE);

    // ---- workspace（直调直接作为 userWS；按 tiling 公式 + 充足余量）----
    const size_t wsBytes = (size_t)((128 + 9 * Y + p.expertNum + 2 * totalLength) * (int64_t)sizeof(int32_t)) +
                           (size_t)(64 * 1024);
    uint8_t* wsDev = MallocZero(wsBytes);

    // ---- 8 路输出 ----
    const size_t yBytes = (size_t)Y * p.H * tokenDtypeSize;           // int8: Y*H
    const size_t groupListBytes = (size_t)p.expertNum * 2 * sizeof(int64_t);
    const size_t idBytes = (size_t)Y * sizeof(int32_t);
    const size_t dynScaleBytes = (size_t)Y * sizeof(float);
    const size_t actualBytes = 32;  // >= int64, block 对齐

    uint8_t* yDev = MallocZero(yBytes);
    uint8_t* groupListDev = MallocZero(groupListBytes);
    uint8_t* sessionIdsOutDev = MallocZero(idBytes);
    uint8_t* microBatchIdsOutDev = MallocZero(idBytes);
    uint8_t* tokenIdsOutDev = MallocZero(idBytes);
    uint8_t* expertOffsetsOutDev = MallocZero(idBytes);
    uint8_t* dynScaleDev = MallocZero(dynScaleBytes);
    uint8_t* actualTokenNumDev = MallocZero(actualBytes);

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint32_t blockNum = (uint32_t)vcoreNum;
    ffn_wb_probe_kernel<<<blockNum, nullptr, stream>>>(
        scDev, yDev, groupListDev, sessionIdsOutDev, microBatchIdsOutDev, tokenIdsOutDev,
        expertOffsetsOutDev, dynScaleDev, actualTokenNumDev, wsDev, tilingDev);
    auto sret = aclrtSynchronizeStream(stream);
    printf("[INFO] kernel launch blockNum=%u, sync ret=%d\n", blockNum, sret);

    // ---- 回读 8 路输出 ----
    DumpOut("./output/y.bin", yDev, yBytes);
    DumpOut("./output/group_list.bin", groupListDev, groupListBytes);
    DumpOut("./output/session_ids.bin", sessionIdsOutDev, idBytes);
    DumpOut("./output/micro_batch_ids.bin", microBatchIdsOutDev, idBytes);
    DumpOut("./output/token_ids.bin", tokenIdsOutDev, idBytes);
    DumpOut("./output/expert_offsets.bin", expertOffsetsOutDev, idBytes);
    DumpOut("./output/dynamic_scale.bin", dynScaleDev, dynScaleBytes);
    DumpOut("./output/actual_token_num.bin", actualTokenNumDev, actualBytes);

    // ---- 释放 ----
    aclrtDestroyStream(stream);
    for (uint8_t* d : {tokenDataDev, sessionIdsBufDev, microBatchIdsBufDev, expertIdsBufDev, scDev, tilingDev,
                       wsDev, yDev, groupListDev, sessionIdsOutDev, microBatchIdsOutDev, tokenIdsOutDev,
                       expertOffsetsOutDev, dynScaleDev, actualTokenNumDev}) {
        aclrtFree(d);
    }
    aclrtResetDevice(deviceId);
    aclFinalize();
    printf("[INFO] done\n");
    return 0;
}
