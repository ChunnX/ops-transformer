/*!
 * \file ffn_wb_recv_probe.asc
 * \brief 穿刺1 Host + main：构造 1024B schedule_context(内嵌 device 指针) +
 *        tiling，在真实 NPU(Ascend950DT/arch35) 上直调 ffn_wb_recv_probe。
 */

#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <vector>
#include "acl/acl.h"
#include "../op_kernel/ffn_wb_probe_tiling.h"
#include "../op_kernel/ffn_wb_recv_probe_kernel.asc"

// ---- 穿刺 shape（与 scripts/gen_data.py 保持一致）----
static constexpr uint32_t A_ = 4;       // session_num
static constexpr uint32_t M_ = 2;       // micro_batch_num
static constexpr uint32_t BS_ = 2;      // micro_batch_size
static constexpr uint32_t K_ = 2;       // selected_expert_num (topK+1)
static constexpr uint32_t H_ = 8;       // hidden size
static constexpr uint32_t HS_ = H_ * sizeof(uint16_t);  // 每 token 字节步长 = 16
static constexpr int64_t EXPERT_NUM_ = 8;
static constexpr int64_t TOKEN_DTYPE_ = 0;   // fp16
static constexpr uint64_t CUR_MB_ID_ = 0;    // polling_index

static constexpr int64_t Y_ = (int64_t)A_ * BS_ * K_;         // 16
static constexpr int64_t F_ = (int64_t)BS_ * K_ + 2;          // 6
static constexpr int64_t TOKEN_INFO_CNT = (int64_t)A_ * M_ * F_;          // 48 int32
static constexpr int64_t TOKEN_DATA_CNT = (int64_t)A_ * M_ * BS_ * K_ * H_; // 512 fp16

static constexpr size_t RESERVED_WK = 16UL * 1024 * 1024;     // dav_3510 系统 workspace
static constexpr size_t SLACK = 512;

#define ACL_CHECK(expr)                                                             \
    do {                                                                            \
        aclError _ret = (expr);                                                     \
        if (_ret != ACL_SUCCESS) {                                                  \
            printf("[ERR] %s failed ret=%d, msg=%s\n", #expr, _ret,                 \
                   aclGetRecentErrMsg());                                           \
            return -1;                                                              \
        }                                                                           \
    } while (0)

static bool ReadBin(const char* path, void* buf, size_t bytes)
{
    FILE* f = fopen(path, "rb");
    if (!f) { printf("[ERR] open %s failed\n", path); return false; }
    size_t rd = fread(buf, 1, bytes, f);
    fclose(f);
    if (rd != bytes) { printf("[ERR] read %s: got %zu want %zu\n", path, rd, bytes); return false; }
    return true;
}

static bool WriteBin(const char* path, const void* buf, size_t bytes)
{
    FILE* f = fopen(path, "wb");
    if (!f) { printf("[ERR] create %s failed\n", path); return false; }
    fwrite(buf, 1, bytes, f);
    fclose(f);
    return true;
}

int32_t main()
{
    ACL_CHECK(aclInit(nullptr));
    int32_t deviceId = 0;
    ACL_CHECK(aclrtSetDevice(deviceId));
    aclrtStream stream = nullptr;
    ACL_CHECK(aclrtCreateStream(&stream));

    // ---- 运行时查询核数 / UB（禁止写死 arch 常量）----
    int64_t vectorCoreNum = 0;
    ACL_CHECK(aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &vectorCoreNum));
    int64_t ubPerCore = 0;
    ACL_CHECK(aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_UBUF_PER_VECTOR_CORE, &ubPerCore));
    printf("[INFO] vectorCoreNum=%ld ubPerCore=%ld\n", vectorCoreNum, ubPerCore);

    // RECV 且 Y<=200000 → 限核 min(coreNum,32)
    int64_t coreNum = vectorCoreNum < 32 ? vectorCoreNum : 32;
    if (coreNum < 2) { printf("[ERR] need >=2 vector cores, got %ld\n", coreNum); return -1; }
    // 预留 16KB 余量，规避 UBUF 属性可能大于 InitBuffer 可用 UB 导致的溢出
    int64_t ubSizeTiling = ubPerCore - 16 * 1024;

    // ---- TilingData ----
    FfnWorkerBatchingTilingData tiling;
    tiling.Y = Y_;
    tiling.H = H_;
    tiling.tokenDtype = TOKEN_DTYPE_;
    tiling.expertNum = EXPERT_NUM_;
    tiling.coreNum = coreNum;
    tiling.ubSize = ubSizeTiling;
    tiling.sortLoopMaxElement =
        ubSizeTiling / ((int64_t)sizeof(int32_t) * 2 * 4) / 32 * 32;
    tiling.sortNumWorkSpace = Y_;
    uint32_t blockNum = (uint32_t)coreNum;
    printf("[INFO] tiling: Y=%ld H=%ld tokenDtype=%ld expertNum=%ld coreNum=%ld ubSize=%ld "
           "sortLoopMaxElement=%ld sortNumWorkSpace=%ld blockNum=%u\n",
           tiling.Y, tiling.H, tiling.tokenDtype, tiling.expertNum, tiling.coreNum,
           tiling.ubSize, tiling.sortLoopMaxElement, tiling.sortNumWorkSpace, blockNum);

    // ---- 读输入 bin 到 host ----
    std::vector<int32_t> tokenInfoHost(TOKEN_INFO_CNT, 0);
    std::vector<uint16_t> tokenDataHost(TOKEN_DATA_CNT, 0);
    if (!ReadBin("./input/token_info.bin", tokenInfoHost.data(), TOKEN_INFO_CNT * sizeof(int32_t))) return -1;
    if (!ReadBin("./input/token_data.bin", tokenDataHost.data(), TOKEN_DATA_CNT * sizeof(uint16_t))) return -1;

    // ---- 分配 device 输入缓冲 ----
    void *tokenInfoDev = nullptr, *tokenDataDev = nullptr;
    ACL_CHECK(aclrtMalloc(&tokenInfoDev, TOKEN_INFO_CNT * sizeof(int32_t) + SLACK, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(&tokenDataDev, TOKEN_DATA_CNT * sizeof(uint16_t) + SLACK, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMemset(tokenInfoDev, TOKEN_INFO_CNT * sizeof(int32_t) + SLACK, 0, TOKEN_INFO_CNT * sizeof(int32_t) + SLACK));
    ACL_CHECK(aclrtMemset(tokenDataDev, TOKEN_DATA_CNT * sizeof(uint16_t) + SLACK, 0, TOKEN_DATA_CNT * sizeof(uint16_t) + SLACK));
    ACL_CHECK(aclrtMemcpy(tokenInfoDev, TOKEN_INFO_CNT * sizeof(int32_t), tokenInfoHost.data(),
                          TOKEN_INFO_CNT * sizeof(int32_t), ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemcpy(tokenDataDev, TOKEN_DATA_CNT * sizeof(uint16_t), tokenDataHost.data(),
                          TOKEN_DATA_CNT * sizeof(uint16_t), ACL_MEMCPY_HOST_TO_DEVICE));

    // ---- 构造 1024B schedule_context（内嵌 device 指针）----
    std::vector<uint8_t> ctxHost(1024, 0);
    auto put_u32 = [&](size_t off, uint32_t v) { memcpy(ctxHost.data() + off, &v, 4); };
    auto put_u64 = [&](size_t off, uint64_t v) { memcpy(ctxHost.data() + off, &v, 8); };
    put_u32(0, A_);
    put_u32(4, M_);
    put_u32(8, BS_);
    put_u32(12, K_);
    put_u32(16, (uint32_t)EXPERT_NUM_);
    put_u32(20, HS_);
    put_u64(384, (uint64_t)(uintptr_t)tokenInfoDev);  // FfnArea.token_info_buf
    put_u64(400, (uint64_t)(uintptr_t)tokenDataDev);  // FfnArea.token_data_buf
    put_u64(416, CUR_MB_ID_);                          // FfnArea.polling_index

    void* ctxDev = nullptr;
    ACL_CHECK(aclrtMalloc(&ctxDev, 1024, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMemcpy(ctxDev, 1024, ctxHost.data(), 1024, ACL_MEMCPY_HOST_TO_DEVICE));

    // ---- tiling to device ----
    void* tilingDev = nullptr;
    ACL_CHECK(aclrtMalloc(&tilingDev, sizeof(tiling), ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMemcpy(tilingDev, sizeof(tiling), &tiling, sizeof(tiling), ACL_MEMCPY_HOST_TO_DEVICE));

    // ---- workspace（16MB 系统预留 + 用户区）----
    size_t userWkBytes = (size_t)(128 * sizeof(int32_t) + Y_ * sizeof(int32_t) +
                                  Y_ * sizeof(int32_t) * 2 * 4 + EXPERT_NUM_ * sizeof(int32_t));
    size_t wkBytes = RESERVED_WK + userWkBytes + 1024 * 1024;
    void* wkDev = nullptr;
    ACL_CHECK(aclrtMalloc(&wkDev, wkBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMemset(wkDev, wkBytes, 0, wkBytes));

    // ---- 输出缓冲（memset 0，与 golden 尾部占位一致）----
    struct Out { const char* name; size_t bytes; void* dev; };
    std::vector<Out> outs = {
        {"y",                (size_t)Y_ * H_ * sizeof(uint16_t), nullptr},
        {"group_list",       (size_t)EXPERT_NUM_ * 2 * sizeof(int64_t), nullptr},
        {"session_ids",      (size_t)Y_ * sizeof(int32_t), nullptr},
        {"micro_batch_ids",  (size_t)Y_ * sizeof(int32_t), nullptr},
        {"token_ids",        (size_t)Y_ * sizeof(int32_t), nullptr},
        {"expert_offsets",   (size_t)Y_ * sizeof(int32_t), nullptr},
        {"dynamic_scale",    (size_t)Y_ * sizeof(float), nullptr},
        {"actual_token_num", (size_t)1 * sizeof(int64_t), nullptr},
    };
    for (auto& o : outs) {
        ACL_CHECK(aclrtMalloc(&o.dev, o.bytes + SLACK, ACL_MEM_MALLOC_HUGE_FIRST));
        ACL_CHECK(aclrtMemset(o.dev, o.bytes + SLACK, 0, o.bytes + SLACK));
    }

    // ---- 直调 kernel ----
    ffn_wb_recv_probe<<<blockNum, nullptr, stream>>>(
        (GM_ADDR)ctxDev, (GM_ADDR)outs[0].dev, (GM_ADDR)outs[1].dev, (GM_ADDR)outs[2].dev,
        (GM_ADDR)outs[3].dev, (GM_ADDR)outs[4].dev, (GM_ADDR)outs[5].dev, (GM_ADDR)outs[6].dev,
        (GM_ADDR)outs[7].dev, (GM_ADDR)wkDev, (GM_ADDR)tilingDev);
    ACL_CHECK(aclrtSynchronizeStream(stream));
    printf("[INFO] kernel finished on NPU\n");

    // ---- 回拷 + 落盘 ----
    system("mkdir -p output");
    for (auto& o : outs) {
        std::vector<uint8_t> h(o.bytes);
        ACL_CHECK(aclrtMemcpy(h.data(), o.bytes, o.dev, o.bytes, ACL_MEMCPY_DEVICE_TO_HOST));
        char p[256];
        snprintf(p, sizeof(p), "./output/%s.bin", o.name);
        if (!WriteBin(p, h.data(), o.bytes)) return -1;
    }
    printf("[INFO] outputs written to ./output/\n");

    // ---- 释放 ----
    for (auto& o : outs) aclrtFree(o.dev);
    aclrtFree(wkDev);
    aclrtFree(tilingDev);
    aclrtFree(ctxDev);
    aclrtFree(tokenDataDev);
    aclrtFree(tokenInfoDev);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
